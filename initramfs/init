#!/bin/busybox sh
# GlassineOS boot initramfs /init. One image, two roles, told apart by the
# board's DEFAULT_ROLE_MATCH on the kernel command line:
#
#   DEFAULT role (a normal boot from the default slot): the daily system. The
#   root fs (ROOT_PART) checked and mounted read-write, its own runlevels
#   (ROOT_LAYOUT=deployments: the deployment's root assembled from the btrfs
#   ROOT_PART + userdata instead, lib/glassine-root.sh, after the hibernation
#   resume step);
#   the previous boot's pstore saved to /var/log/pstore/. The watchdogs stay
#   armed (the busybox watchdog daemons keep petting after switch_root): a
#   kernel hang resets the device.
#
#   TEST role (a one-shot boot from the test slot, `glassine-reboot recovery`):
#   never writes to storage unless told to. If glassine-bootimg staged this
#   image (glassine.img= matches its pending record; in the deployments
#   layout, state/kernel's candidate_img), the test role runs the
#   default boot by itself: that boot is the image's test, and
#   glassine-bootimg-promote judges it. Otherwise, without developer mode, it
#   runs the default boot as well (back to the default slot if that fails).
#
# Developer mode (glassine.devmode=usb, off by default) opens USB networking
# on the board's DEVMODE_ADDR: a root shell (telnet, no password) and HTTP
# endpoints. Anyone with a cable gets root, so it is for development only;
# without it nothing listens on USB. In developer mode the test role waits
# for the host instead of booting on, and reboots to the default slot after
# glassine.return=<s> (default 180) unless told to stay:
#   telnet ADDR                                 shell
#   curl http://ADDR/cgi-bin/dmesg              kernel log
#   curl http://ADDR/cgi-bin/status             what probed
#   curl http://ADDR/cgi-bin/prev               the previous boot's pstore
#   curl --data-binary @x.sh http://ADDR/cgi-bin/run    run a script
#   curl http://ADDR/cgi-bin/stay               cancel the auto-return
#   curl http://ADDR/cgi-bin/back               reboot to the default slot now
#   curl http://ADDR/cgi-bin/default            run the default boot from here
# and a failed default boot stays in the initramfs, reachable, instead of
# powering off.
#
# Hooks (developer mode only): /lib/glassine-boot/hooks.d/*.sh are sourced
# in name order before either role runs. A hook registers functions for
# stages with `glassine_hook STAGE FUNCTION`:
#   pre-switch-root   default boot, root fs mounted read-write at $NEWROOT
#   endpoints         add HTTP endpoints: glassine_endpoint NAME 'shell code'
#   wait              once a second while the test role waits for the host
# Hooks may use log, find_root, $NEWROOT, $CMDF, and the files an image
# builder put in $GLASSINE_EXTRA (build-initramfs.sh --extra DIR).
#
# Board facts come from /etc/glassine-boot/board.conf (conf/board.conf.example
# documents every key). Without it there is no root partition to boot.

/bin/busybox mkdir -p /bin /sbin /usr/bin /usr/sbin /proc /sys /dev /tmp /run
/bin/busybox --install -s
for a in telnetd udhcpd httpd; do ln -sf /bin/busybox-extras /sbin/$a; done

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts

log() { echo "<3>glassine-boot: $*" > /dev/kmsg; }
# The host test's overrides (test/initramfs). Never as PID 1: the kernel puts
# unknown command line words of the form A=B into PID 1's environment.
[ $$ = 1 ] && unset GLASSINE_INIT_CMDLINE GLASSINE_INIT_BOARD GLASSINE_INIT_HOOKS GLASSINE_INIT_LIB GLASSINE_INIT_SYSBLOCK GLASSINE_INIT_DEVDIR
CMDF=${GLASSINE_INIT_CMDLINE:-/proc/cmdline}
SYSBLOCK=${GLASSINE_INIT_SYSBLOCK:-/sys/class/block} DEVDIR=${GLASSINE_INIT_DEVDIR:-/dev}
BOARD=${GLASSINE_INIT_BOARD:-/etc/glassine-boot/board.conf}
HOOKDIR=${GLASSINE_INIT_HOOKS:-/lib/glassine-boot/hooks.d}
LIBDIR=${GLASSINE_INIT_LIB:-/lib/glassine-boot}
# for the hooks (sourced): their files from build-initramfs.sh --extra
# shellcheck disable=SC2034
GLASSINE_EXTRA=/lib/glassine-boot/extra
NEWROOT=/newroot
log "init start $(cat /proc/uptime)"

# Boot modules (docs/boot.md, "Boot modules"): a kernel that builds its storage or file
# system drivers as modules has its boot-modules archive appended to this initramfs
# (build-boot-modules.sh): load them in its order, before anything looks for a
# partition. No archive (a kernel with them built in): no step, nothing logged. An
# archive for another release loads nothing and says so.
boot_modules() {
    _md=$LIBDIR/modules
    [ -d "$_md" ] || return 0
    _kr=$(uname -r)
    if [ ! -r "$_md/$_kr/load" ]; then
        log "boot modules: the archive is for $(ls "$_md" | tr '\n' ' ')and this kernel is $_kr: none loaded"
        return 0
    fi
    _n=0 _t=0 _f=''
    while read -r _m; do
        [ -n "$_m" ] || continue
        _t=$((_t + 1))
        if insmod "$_md/$_kr/$_m.ko" 2>/tmp/insmod.err || grep -q 'File exists' /tmp/insmod.err; then _n=$((_n + 1))
        else _f="$_f $_m"; fi
    done < "$_md/$_kr/load"
    log "boot modules: $_n of $_t loaded${_f:+, failed:$_f}"
}
boot_modules

BOOT_FORM='' BOOT_PART=glassine-boot ROOT_PART='' ROOT_FSTYPE=ext4 ROOT_LAYOUT=plain USERDATA_PART='' USERDATA_PREFIX=media/glassine DEVICE_PART='' DEFAULT_ROLE_MATCH='' DEVMODE_ADDR='' DEVMODE_NETMASK=255.255.255.0
DEVMODE_DHCP_START='' DEVMODE_DHCP_END='' USB_VENDOR=0x1d6b USB_PRODUCT=0x0104 USB_MANUFACTURER=GlassineOS
if [ -r "$BOARD" ]; then
    # shellcheck source=/dev/null
    . "$BOARD"
else
    log "no board config ($BOARD): no root partition known"
fi

arg() { sed -n "s/.*$1=\([^ ]*\).*/\1/p" "$CMDF"; }
RETURN_S=$(arg glassine.return); [ -n "$RETURN_S" ] || RETURN_S=180

# Previous boot's pstore (its kernel log; the default boot saves it)
mkdir -p /sys/fs/pstore /tmp/prev-pstore
mount -t pstore pstore /sys/fs/pstore 2>/dev/null && cp /sys/fs/pstore/* /tmp/prev-pstore/ 2>/dev/null

DEFAULT=0
[ -n "$DEFAULT_ROLE_MATCH" ] && grep -qE -- "$DEFAULT_ROLE_MATCH" "$CMDF" && DEFAULT=1
[ -z "$DEFAULT_ROLE_MATCH" ] && DEFAULT=1
grep -qw glassine.test "$CMDF" && DEFAULT=0
DEVMODE=0
if [ "$(arg glassine.devmode)" = usb ]; then
    if [ -n "$DEVMODE_ADDR" ]; then DEVMODE=1
    else log "glassine.devmode=usb, but the board config has no DEVMODE_ADDR: developer mode off"; fi
fi
log "role: $([ $DEFAULT = 1 ] && echo default || echo test), devmode $DEVMODE"

# Pet the watchdogs from here on (the board's WATCHDOGS, lib/glassine-watchdog.sh;
# default /dev/watchdog, 20 s): if PID 1 or the kernel stalls, the bite resets.
if [ -r "$LIBDIR/glassine-watchdog.sh" ]; then
    gw_log() { log "$*"; }
    # shellcheck source=../lib/glassine-watchdog.sh
    . "$LIBDIR/glassine-watchdog.sh"
    wd_arm() { gw_arm "${1:-0}"; }
else
    wd_arm() {
        [ -e /dev/watchdog ] && { watchdog -t 5 -T 20 /dev/watchdog && log "watchdog armed (20 s)"; } \
            || log "no /dev/watchdog"
    }
fi
# a listed watchdog whose driver is still probing gets 3 s
wd_arm 3

# The deployments layout (docs/boot.md): the boot steps of
# lib/glassine-root.sh. The watchdog stops (busybox's magic close on SIGTERM)
# only around the resume write: qcom-wdt can't wait out an image load.
if [ "$ROOT_LAYOUT" = deployments ]; then
    # shellcheck source=../lib/glassine-state.sh
    [ -r "$LIBDIR/glassine-root.sh" ] && . "$LIBDIR/glassine-state.sh" && . "$LIBDIR/glassine-root.sh" ||
        { log "ROOT_LAYOUT=deployments, but $LIBDIR has no glassine-root.sh: no root"; ROOT_PART=''; }
    gr_log() { log "$*"; }
    gr_wd_stop() { killall watchdog 2>/dev/null; sleep 1; }
    gr_wd_start() { wd_arm; }
    # shellcheck source=../lib/glassine-device.sh
    if [ -r "$LIBDIR/glassine-device.sh" ]; then . "$LIBDIR/glassine-device.sh"; else log "$LIBDIR has no glassine-device.sh: no device data step"; fi
fi

# Hooks: `glassine_hook STAGE FUNCTION` adds FUNCTION to STAGE; run_stage
# calls them in the order they were added.
STAGE_pre_switch_root='' STAGE_endpoints='' STAGE_wait=''
glassine_hook() {
    case $1 in
    pre-switch-root) STAGE_pre_switch_root="$STAGE_pre_switch_root $2" ;;
    endpoints) STAGE_endpoints="$STAGE_endpoints $2" ;;
    wait) STAGE_wait="$STAGE_wait $2" ;;
    *) log "hook: unknown stage $1 ($2), ignored" ;;
    esac
}
run_stage() {
    local f fs
    case $1 in
    pre-switch-root) fs=$STAGE_pre_switch_root ;;
    endpoints) fs=$STAGE_endpoints ;;
    wait) fs=$STAGE_wait ;;
    esac
    for f in $fs; do "$f" || log "hook: $f ($1) exit $?"; done
}
if [ $DEVMODE = 1 ]; then
    for h in "$HOOKDIR"/*.sh; do
        [ -r "$h" ] || continue
        # shellcheck source=/dev/null
        . "$h" && log "hook: $h sourced" || log "hook: $h FAILED"
    done
fi

usbnet() {
    G=/sys/kernel/config/usb_gadget/g1
    mkdir -p /sys/kernel/config
    mount -t configfs configfs /sys/kernel/config 2>/dev/null
    mkdir -p $G/strings/0x409 $G/configs/c.1/strings/0x409 $G/functions/ncm.usb0
    echo "$USB_VENDOR" > $G/idVendor
    echo "$USB_PRODUCT" > $G/idProduct
    echo "$USB_MANUFACTURER" > $G/strings/0x409/manufacturer
    echo "GlassineOS ($(uname -r))" > $G/strings/0x409/product
    echo "glassine" > $G/strings/0x409/serialnumber
    echo "NCM" > $G/configs/c.1/strings/0x409/configuration
    ln -s $G/functions/ncm.usb0 $G/configs/c.1/
    for _ in $(seq 1 40); do UDC=$(ls /sys/class/udc 2>/dev/null | head -n1); [ -n "$UDC" ] && break; sleep 0.5; done
    [ -n "$UDC" ] || { log "usbnet: no UDC"; return 1; }
    echo "$UDC" > $G/UDC
    IF=$(cat $G/functions/ncm.usb0/ifname 2>/dev/null); [ -n "$IF" ] || IF=usb0
    ifconfig "$IF" "$DEVMODE_ADDR" netmask "$DEVMODE_NETMASK" up
    if [ -n "$DEVMODE_DHCP_START" ] && [ -n "$DEVMODE_DHCP_END" ]; then
        printf 'start %s\nend %s\ninterface %s\noption subnet %s\nlease_file /tmp/udhcpd.leases\n' \
            "$DEVMODE_DHCP_START" "$DEVMODE_DHCP_END" "$IF" "$DEVMODE_NETMASK" > /tmp/udhcpd.conf
        touch /tmp/udhcpd.leases
        udhcpd /tmp/udhcpd.conf
    fi
    log "usbnet: $IF $DEVMODE_ADDR udc=$UDC"
}

glassine_endpoint() { printf '#!/bin/sh\nprintf "Content-Type: text/plain\\r\\n\\r\\n"\n%s\n' "$2" > /www/cgi-bin/$1; chmod 755 /www/cgi-bin/$1; }
mkdir -p /www/cgi-bin
glassine_endpoint dmesg  'dmesg'
glassine_endpoint status 'cat /tmp/status 2>/dev/null; echo; uptime'
glassine_endpoint prev   'for f in /tmp/prev-pstore/*; do [ -e "$f" ] && { echo "=== $f"; cat "$f"; }; done'
glassine_endpoint run    'head -c "${CONTENT_LENGTH:-0}" > /tmp/run.sh; sh /tmp/run.sh 2>&1'
glassine_endpoint stay   'touch /tmp/stay; echo staying'
glassine_endpoint back   'echo rebooting to the default boot; (sleep 1; reboot -f) >/dev/null 2>&1 &'
glassine_endpoint default 'touch /tmp/boot-default; echo "switching to the DEFAULT boot (root fs read-write, full runlevels) in 1s"'
run_stage endpoints

# A partition's block device name, by its GPT name. Storage may still be
# probing when /init starts: wait up to 15 s for it.
find_part() {
    [ -n "$1" ] || return 1
    for _ in $(seq 1 60); do
        for u in "$SYSBLOCK"/*/uevent; do
            grep -qx "PARTNAME=$1" "$u" && { sed -n 's/^DEVNAME=//p' "$u"; return 0; }
        done
        sleep 0.25
    done
    return 1
}
# The same by its GPT unique partition identity (lower case), waiting as long.
# Two partitions that carry it (a cloned disk): none is taken.
# le DEV OFFSET N: the N-byte little-endian number at OFFSET of DEV, decimal
le() { od -An -v -tu1 -j "$2" -N "$3" "$1" 2>/dev/null | awk 'BEGIN { m = 1 } { for (i = 1; i <= NF; i++) { v += $i * m; m *= 256 } } END { if (m > 1) printf "%.0f\n", v }'; }
# part_uuid DIR: the GPT unique identity of the partition whose sysfs directory is
# DIR, in lower case. The kernel's uevent PARTUUID= where it gives one (newer
# kernels; 6.12 has none); else the disk's primary GPT entry PARTN, taken only when
# the header is a GPT's and the entry's first block is the partition's start.
part_uuid() {
    _qu=$(sed -n 's/^PARTUUID=//p' "$1/uevent" 2>/dev/null | head -n 1)
    [ -z "$_qu" ] || { echo "$_qu" | tr A-F a-f; return 0; }
    _pn=$(sed -n 's/^PARTN=//p' "$1/uevent" 2>/dev/null)
    case $_pn in ''|*[!0-9]*) return 1 ;; esac
    _pd=$(cd -P "$1/.." 2>/dev/null && pwd -P) || return 1       # a partition sits in its disk's directory
    _dn=$(sed -n 's/^DEVNAME=//p' "$_pd/uevent" 2>/dev/null)
    [ -n "$_dn" ] && [ -r "$DEVDIR/$_dn" ] || return 1
    _dv=$DEVDIR/$_dn
    _lb=$(cat "$_pd/queue/logical_block_size" 2>/dev/null); _lb=${_lb:-512}
    [ "$(dd if="$_dv" bs=1 skip="$_lb" count=8 2>/dev/null)" = "EFI PART" ] || return 1
    _el=$(le "$_dv" $((_lb + 72)) 8) _en=$(le "$_dv" $((_lb + 80)) 4) _es=$(le "$_dv" $((_lb + 84)) 4)
    [ -n "$_el" ] && [ -n "$_en" ] && [ -n "$_es" ] && [ "$_pn" -ge 1 ] && [ "$_pn" -le "$_en" ] && [ "$_es" -ge 128 ] || return 1
    _eo=$((_el * _lb + (_pn - 1) * _es))
    [ "$(le "$_dv" $((_eo + 32)) 8)" = "$(( $(cat "$1/start" 2>/dev/null || echo -1) * 512 / _lb ))" ] || return 1
    od -An -v -tx1 -j $((_eo + 16)) -N 16 "$_dv" 2>/dev/null | tr -s ' \n' ' ' | awk '{ if (NF != 16) exit 1
        printf "%s%s%s%s-%s%s-%s%s-%s%s-%s%s%s%s%s%s\n", $4, $3, $2, $1, $6, $5, $8, $7, $9, $10, $11, $12, $13, $14, $15, $16 }'
}
find_partuuid() {
    for _ in $(seq 1 60); do
        _fn=0 _fd=''
        for u in "$SYSBLOCK"/*/uevent; do
            grep -q '^PARTN=' "$u" || continue
            [ "$(part_uuid "${u%/uevent}")" = "$1" ] || continue
            _fn=$((_fn + 1)) _fd=$(sed -n 's/^DEVNAME=//p' "$u")
        done
        [ $_fn = 1 ] && { echo "$_fd"; return 0; }
        [ $_fn = 0 ] || { log "PARTUUID=$1: $_fn partitions carry it: none taken"; return 1; }
        sleep 0.25
    done
    return 1
}
# cmdkey KEY: the value of the command-line word KEY=<value>, matched as a whole
# word. 0 = given once (the value printed), 1 = not given, 2 = given more than once.
cmdkey() (
    set -f
    _n=0
    # shellcheck disable=SC2013  # words, not lines
    for _w in $(cat "$CMDF"); do
        case $_w in "$1="*) _v=${_w#"$1="} _n=$((_n + 1)) ;; esac
    done
    [ $_n = 0 ] && return 1
    [ $_n = 1 ] || return 2
    printf '%s' "$_v"
)
# part_for KEY NAME: in the deployments layout the partition the boot chain names
# with KEY=PARTUUID=<uuid> on the command line (docs/boot.md, "Command-line keys"),
# and only that one: a partition called NAME with another identity is never taken.
# Without KEY (the Note Air: one disk, its names unique), the partition called NAME.
part_for() {
    if [ "$ROOT_LAYOUT" = deployments ]; then
        _pv=$(cmdkey "$1"); _pr=$?
        case $_pr in
        2) log "$1= is given more than once: no partition taken"; return 1 ;;
        0)
            _pu=$(echo "${_pv#PARTUUID=}" | tr A-F a-f)
            case $_pv in PARTUUID=*) ;; *) log "$1=$_pv is not PARTUUID=<uuid>: no partition taken"; return 1 ;; esac
            echo "$_pu" | grep -qxE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' ||
                { log "$1=$_pv is not PARTUUID=<uuid>: no partition taken"; return 1; }
            find_partuuid "$_pu" || return 1
            return 0
            ;;
        esac
    fi
    find_part "$2"
}
# part_given KEY NAME: a partition is asked for, by the key or by the board's name
part_given() { [ -n "$2" ] && return 0; [ "$ROOT_LAYOUT" = deployments ] || return 1; cmdkey "$1" >/dev/null; [ $? != 1 ]; }
find_root() { part_for glassine.system "$ROOT_PART"; }
# what the boot looked for: the key's value, or the board's name
part_what() {
    if [ "$ROOT_LAYOUT" = deployments ] && _pw=$(cmdkey "$1"); then echo "$1=$_pw"; else echo "${2:-(none configured)}"; fi
}

# The deployments layout: resume or invalidate a hibernated session first
# (nothing mounted before it), then the deployment's root at $NEWROOT. No
# resume on a test-role boot, with glassine.noresume (the loader's word for
# "I took the normal path", rule 10), or on a kernel trial or finishing boot
# (KBOOT, FR-011).
mount_deployments() {
    U=''
    if [ $ONCE_RECORD = 1 ]; then
        ONCE=$(record_once); ONCE_RECORD=0
        case $ONCE in .*|*[!A-Za-z0-9._-]*) log "the loader record's request '$ONCE' is not a deployment id: none"; ONCE='' ;; esac
    fi
    if part_given glassine.userdata "$USERDATA_PART"; then
        U=$(part_for glassine.userdata "$USERDATA_PART") || log "default: userdata $(part_what glassine.userdata "$USERDATA_PART") not found"
    fi
    may=resume
    [ $DEFAULT = 1 ] || may=test-role
    grep -qw glassine.noresume "$CMDF" && may=noresume
    [ -z "$KBOOT" ] || may=kernel-$KBOOT
    if [ -n "$U" ] && ! GR_ONCE_REQ=$ONCE gr_resume "/dev/$P" "/dev/$U" "$USERDATA_PREFIX" $may; then
        log "default: userdata holds a hibernate image that cannot be invalidated: nothing mounted"
        return 1
    fi
    gr_boot "/dev/$P" "${U:+/dev/$U}" "$USERDATA_PREFIX" $NEWROOT "$(uname -r)" "$IMG_ID" "$ONCE" || return 1
    log "default: deployment $GR_BOOTED"
}
root_release() {
    if [ "$ROOT_LAYOUT" = deployments ]; then gr_boot_umount $NEWROOT; else umount $NEWROOT; fi
}

# Device data (docs/kernel-artifacts.md): after gr_carry, when the deployment's
# list names files and the board has a DEVICE_PART, the seed is bound read-only
# on /run/glassine/device if the files it holds verify, and the firmware path
# set (gd_boot). The seed service in the booted system fills what is missing
# and says what is wrong with the list or the board. No list: no step, no log.
device_data() {
    command -v gd_boot >/dev/null || return 0
    gd_has_entries "$NEWROOT/usr/share/glassine/device-data.list" && [ -n "$DEVICE_PART" ] || return 0
    _dp=$(find_part "$DEVICE_PART") || { log "device data: no partition $DEVICE_PART"; return 0; }
    gd_boot $NEWROOT "/dev/$_dp" "$CMDF" /sys/module/firmware_class/parameters/path 2>/tmp/gd.log
    while read -r _l; do log "device data: ${_l#glassine-device: }"; done < /tmp/gd.log
}

# The daily boot: the root fs read-write, its own runlevels (the packages
# enable their services; nothing is linked here). The busybox watchdog keeps
# running.
boot_default() {
    log "default: preparing"
    P=$(find_root)
    [ -n "$P" ] || { log "default: root partition $(part_what glassine.system "$ROOT_PART") not found"; return 1; }
    log "default: root partition $(part_what glassine.system "$ROOT_PART") is /dev/$P"
    mkdir -p $NEWROOT
    if [ "$ROOT_LAYOUT" = deployments ]; then
        mount_deployments || return 1
    else
        # Preen before mounting read-write, as a distribution does (fixes the
        # safe things; exit >= 4 needs a human: mount anyway and say so).
        if command -v "fsck.$ROOT_FSTYPE" >/dev/null; then
            "fsck.$ROOT_FSTYPE" -p "/dev/$P" > /tmp/fsck.log 2>&1; rc=$?
            log "default: fsck.$ROOT_FSTYPE -p $ROOT_PART: exit $rc $(tail -n1 /tmp/fsck.log)"
        fi
        mount -t "$ROOT_FSTYPE" -o rw,noatime "/dev/$P" $NEWROOT || { log "default: mount /dev/$P failed"; return 1; }
    fi
    [ -x $NEWROOT/sbin/init ] || { root_release; log "default: no /sbin/init on $ROOT_PART"; return 1; }
    if [ -n "$(ls /tmp/prev-pstore 2>/dev/null)" ]; then
        D=$NEWROOT/var/log/pstore/$(date +%Y%m%d-%H%M%S)-$$
        mkdir -p "$D" && cp /tmp/prev-pstore/* "$D"/ && log "default: saved pstore to ${D#"$NEWROOT"}"
    fi
    # glassine-bootimg's protocol: this boot is the staged image's test
    [ "$AUTOTEST" = 1 ] && [ "$ROOT_LAYOUT" != deployments ] && sed -i 's/^TRIES=.*/TRIES=1/' $NEWROOT/var/lib/glassine-bootimg/pending
    run_stage pre-switch-root
    mkdir -p $NEWROOT/var/log
    { echo "=== $(date) glassine-boot, default boot"; cat "$CMDF"; cat /tmp/fsck.log 2>/dev/null; dmesg | tail -n 300; } > $NEWROOT/var/log/glassine-boot.log
    # USB goes to the root fs
    killall httpd telnetd udhcpd 2>/dev/null
    if [ -d /sys/kernel/config/usb_gadget/g1 ]; then
        G=/sys/kernel/config/usb_gadget/g1
        echo "" > $G/UDC 2>/dev/null
        rm -f $G/configs/c.1/ncm.usb0
        rmdir $G/configs/c.1/strings/0x409 $G/configs/c.1 $G/functions/ncm.usb0 $G/strings/0x409 $G 2>/dev/null
    fi
    umount /sys/kernel/config 2>/dev/null
    if [ "$ROOT_LAYOUT" = deployments ]; then
        # the running image's own assembly, kept for a soft restart (specs/013)
        GR_KEEP_SRC=/ gr_carry $NEWROOT || { log "default: cannot move the mounts into the new root"; return 1; }
        device_data
    fi
    log "default: switch_root $(cut -d' ' -f1 /proc/uptime)"
    umount /sys/fs/pstore 2>/dev/null
    for m in /proc /sys /dev; do mkdir -p $NEWROOT$m; done
    mount --move /dev $NEWROOT/dev
    mount --move /sys $NEWROOT/sys
    mount --move /proc $NEWROOT/proc
    exec switch_root $NEWROOT /sbin/init
}

# The test boot of an image glassine-bootimg staged (its glassine.img= = the
# ID in the root fs's /var/lib/glassine-bootimg/pending; in the deployments
# layout, a kernel trial: state/kernel's candidate_img): the default boot by
# itself, no host; if it can't, back to the default slot (whose promote then
# marks the image failed). Without glassine.img= nothing changes. KBOOT: what
# this boot is to state/kernel (trial, finishing, or empty), on either role.
AUTOTEST=0 KBOOT=''
IMG_ID=$(sed -n 's/.*glassine[._]img=\([0-9a-f]*\).*/\1/p' "$CMDF")
# The one-shot deployment request (glassine.deploy.once=<deployment id>, 010
# FR-042 to FR-047): gr_boot starts that deployment in place of the pick, for this
# start only, with no state written; a bad id is dropped here.
ONCE=''
if [ "$ROOT_LAYOUT" = deployments ]; then
    ONCE=$(cmdkey glassine.deploy.once); _or=$?
    case $_or:$ONCE in
    1:*) ONCE='' ;;
    2:*) log "glassine.deploy.once= is given more than once: no deployment request"; ONCE='' ;;
    *:.*|*:|*:*[!A-Za-z0-9._-]*) log "glassine.deploy.once=$ONCE is not a deployment id: no deployment request"; ONCE='' ;;
    esac
fi
# The same request from the loader record (docs/handback.md, "A deployment picked
# under a parent that passes no command line"): with BOOT_FORM=raw, on the default
# role and with no glassine.deploy.once= on the command line, the record's
# deploy_once=<id> (the start menu's pick) is cleared in the record first, a write
# read back, and only then taken, so it serves this start only; one that can't be
# cleared is not taken (it would come back at every start). Read once the root
# partition is found (mount_deployments), so the disk that holds both is there.
record_once() (
    exec 3>&1 1>&2      # stdout carries the id only
    # shellcheck disable=SC2034  # read by the library
    GP_TMP=/tmp GLASSINE_BI_SYSBLOCK=$SYSBLOCK GLASSINE_BI_DEVDIR=$DEVDIR
    # shellcheck source=../lib/glassine-bootpart.sh
    . "$LIBDIR/glassine-bootpart.sh" 2>/dev/null || { log "$LIBDIR has no glassine-bootpart.sh: the loader record not read"; exit 0; }
    trap 'gp_close >/dev/null 2>&1; gp_clean' EXIT
    gp_open raw "$CMDF" "$BOOT_PART" /tmp/boot-partition || { log "the loader record: $GP_WHY: no deployment request read"; exit 0; }
    gp_in_use "$GP_DIR" || { log "the loader record: $GP_WHY: no deployment request read"; exit 0; }
    _ro=$(gp_get "$GP_REC" deploy_once)
    [ -n "$_ro" ] || exit 0
    if ! gp_write "$GP_DIR" deploy_once= || ! gp_in_use "$GP_DIR" || [ -n "$(gp_get "$GP_REC" deploy_once)" ]; then
        log "deploy_once=$_ro in the loader record can't be cleared (${GP_WHY:-it reads back}): not taken"
        exit 0
    fi
    case $_ro in .*|*[!A-Za-z0-9._-]*) log "deploy_once=$_ro in the loader record is not a deployment id: cleared, no deployment request"; exit 0 ;; esac
    log "deployment request $_ro from the loader record (deploy_once, cleared): for this start only"
    echo "$_ro" >&3
)
ONCE_RECORD=0
[ "$ROOT_LAYOUT" = deployments ] && [ -z "$ONCE" ] && [ "$BOOT_FORM" = raw ] && [ $DEFAULT = 1 ] && ONCE_RECORD=1
if [ -n "$IMG_ID" ] && [ "$ROOT_LAYOUT" = deployments ]; then
    P=$(find_root)
    [ -z "$P" ] || KBOOT=$(gr_kernel_mode "/dev/$P" "$IMG_ID")
    [ $DEFAULT = 1 ] || [ "$KBOOT" != trial ] || AUTOTEST=1
    case $KBOOT in
    trial) log "image $IMG_ID: the kernel candidate's trial" ;;
    finishing) log "image $IMG_ID: a finishing boot (a default-slot write to complete)" ;;
    *) log "image $IMG_ID: no kernel trial" ;;
    esac
elif [ $DEFAULT = 0 ] && [ -n "$IMG_ID" ]; then
    P=$(find_root)
    # a look only: read-only, and for ext3/4 without replaying the journal
    case $ROOT_FSTYPE in ext3|ext4) o=ro,noload ;; *) o=ro ;; esac
    if [ -n "$P" ] && mkdir -p /peek && mount -t "$ROOT_FSTYPE" -o $o /dev/$P /peek 2>/dev/null; then
        [ "$(sed -n 's/^ID=//p' /peek/var/lib/glassine-bootimg/pending 2>/dev/null)" = "$IMG_ID" ] && AUTOTEST=1
        umount /peek
    fi
    log "image $IMG_ID: $([ $AUTOTEST = 1 ] && echo "staged by glassine-bootimg, its test boot" || echo "not staged")"
fi
if [ $AUTOTEST = 1 ]; then
    boot_default
    log "glassine-bootimg test boot FAILED before switch_root: back to the default slot"
    sync; reboot -f
fi

# No developer mode: never a listener on USB (no telnetd/httpd/udhcpd, no gadget).
if [ $DEVMODE != 1 ]; then
    boot_default
    if [ $DEFAULT = 1 ]; then
        log "default boot FAILED (no developer mode: no USB shell): power off in 60 s"
        sleep 60; sync; poweroff -f
    else
        log "test boot: default boot FAILED: back to the default slot"
        sync; reboot -f
    fi
    while :; do sleep 3600; done        # PID 1 never exits
fi

# Developer mode, the daily boot: straight on (no host, no auto-return); if it
# can't, stay here reachable over USB (an auto-return would only loop).
if [ $DEFAULT = 1 ]; then
    boot_default
    log "default boot FAILED: staying in the initramfs (telnet $DEVMODE_ADDR)"
    touch /tmp/stay
fi

usbnet
telnetd -b "$DEVMODE_ADDR:23" -l /bin/sh
httpd -p "$DEVMODE_ADDR:80" -h /www

# One-screen summary of what probed (the status endpoint).
{
    echo "kernel: $(uname -r)"
    echo "cmdline: $(cat "$CMDF")"
    echo "block: $(ls "$SYSBLOCK" 2>/dev/null | wc -l) devices, root $(part_what glassine.system "$ROOT_PART") $(find_root || echo 'not found')"
    echo "input: $(cat /sys/class/input/input*/name 2>/dev/null | tr '\n' ',')"
    echo "backlight: $(ls /sys/class/backlight 2>/dev/null | tr '\n' ' ')"
    echo "leds: $(ls /sys/class/leds 2>/dev/null | tr '\n' ' ')"
    echo "watchdog: $(ls /dev/watchdog* 2>/dev/null | tr '\n' ' ')"
    echo "power_supply: $(ls /sys/class/power_supply 2>/dev/null | tr '\n' ' ')"
    for p in /sys/class/power_supply/*; do [ -e "$p/type" ] && echo "  $(basename "$p"): $(cd "$p" && for f in status capacity voltage_now current_now charge_now temp; do [ -r $f ] && printf '%s=%s ' $f "$(cat $f 2>/dev/null)"; done)"; done
    echo "deferred: $(cat /sys/kernel/debug/devices_deferred 2>/dev/null | wc -l) (mount debugfs for details)"
} > /tmp/status
log "status: $(tr '\n' ';' < /tmp/status)"

# PID 1: wait for the host; auto-return if it never shows up.
t=0
while :; do
    sleep 1; t=$((t + 1))
    run_stage wait
    [ -e /tmp/boot-default ] && { rm -f /tmp/boot-default; boot_default; log "default: switch failed, staying in initramfs"; }
    if [ ! -e /tmp/stay ] && [ $t -ge "$RETURN_S" ]; then
        log "no host after ${RETURN_S}s — rebooting to the default boot"
        sync; reboot -f
    fi
done
