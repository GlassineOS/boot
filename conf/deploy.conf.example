# glassine-deploy configuration: where the system partition and userdata are,
# and where the deployment files live on userdata. The device package ships
# the real file as /etc/glassine/deploy.conf; a recovery passes its own with
# GLASSINE_DEPLOY_CONF. Shell syntax: KEY=value, one per line.
#
# This example describes the Onyx Boox Note Air (SDM636, eMMC, A/B slots).

# The system partition (btrfs once migrated: bases, kernels, modules, state/).
SYSTEM_DEV=/dev/disk/by-partlabel/system_b
# Where its top level is (or gets) mounted. glassine-deploy mounts it here
# itself when it is not mounted (read-only, rescue=nologreplay, for reading).
SYSTEM_MNT=/run/glassine/system

# Userdata (ext4) and where it is mounted when it is mounted. glassine-deploy
# only reads it unmounted (debugfs) unless a command needs to write.
USERDATA_DEV=/dev/disk/by-partlabel/userdata
USERDATA_MNT=/run/glassine/userdata
# The directory on userdata that holds deployments/, swap/ and the rest.
USERDATA_PREFIX=media/glassine

# Locks and markers of running operations (a tmpfs).
RUN_DIR=/run/glassine

# The shutdown switch (glassine-switch-hook): without a charger, only at this
# battery percent or more (the threshold is a0's, Phase 12 W10 / R3; 30 until
# then).
SWITCH_MIN_CAPACITY=30

# The boot-success step (glassine-deploy-accept): a candidate is accepted once
# it has been up this long and healthy (the same health.d checks as a kernel
# test boot).
ACCEPT_AFTER=120
ACCEPT_HEALTH_DIR=/etc/glassine-bootimg/health.d
# Dual-boot boards: the same healthy boot marks the booted bootloader slot
# successful through glassine-slot (empty = off, e.g. a board without A/B).
SLOT_TOOL=

# Hibernation (glassine-hibernate): the swap file's size in MiB (empty = half
# the RAM), the free space setup leaves on userdata, and the board's hook
# directory (pre/post steps around a hibernate, docs/boot.md).
HIBERNATE_SIZE_MB=
HIBERNATE_RESERVE_MB=512
HIBERNATE_HOOKS=/etc/glassine/hibernate.d
