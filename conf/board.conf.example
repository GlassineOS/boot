# glassine-boot board configuration: the facts about one device that the
# boot initramfs and glassine-bootimg need. The device package ships the real
# file as /etc/glassine-bootimg/board.conf. glassine-bootimg-pack copies it
# into every boot image it builds (as /etc/glassine-boot/board.conf in the
# ramdisk), so the initramfs and the tools always read the same values.
# Shell syntax: KEY=value, one per line, values quoted when they hold spaces.
#
# This example describes the Onyx Boox Note Air (SDM636, eMMC, A/B slots).

# --- Partitions ------------------------------------------------------------
# The root file system: the partition name (GPT name, as the kernel reports
# it in /sys/class/block/*/uevent PARTNAME=) and its type. The default boot
# checks it with fsck.$ROOT_FSTYPE -p and mounts it read-write.
ROOT_PART=system_b
ROOT_FSTYPE=ext4
# The slot the bootloader boots normally (the default slot) and the slot it
# boots only when asked (the test slot: a one-shot boot of a new image).
DEFAULT_DEV=/dev/disk/by-partlabel/boot_b
TEST_DEV=/dev/disk/by-partlabel/recovery
# The reboot reason that makes the bootloader boot the test slot once
# (glassine-reboot passes it to the kernel's reboot-mode driver).
TEST_REBOOT_REASON=recovery
# Size of each slot in bytes; an image must fit.
PART_SIZE=67108864

# --- Roles -----------------------------------------------------------------
# How the initramfs tells a normal boot from a boot of the test slot: an
# extended regular expression matched against the kernel command line. A
# match = the default role. This bootloader appends skip_initramfs on a
# normal boot only; the kernel rewrites the word to _kip_initramfs, so both
# spellings are matched. Leave empty if the bootloader marks neither: then
# every boot is a default boot unless the command line has glassine.test.
DEFAULT_ROLE_MATCH='[s_]kip_initramfs'

# --- Developer mode (glassine.devmode=usb) ---------------------------------
# Only used when the command line has glassine.devmode=usb: USB networking
# (NCM gadget) with a root shell (telnet) and HTTP endpoints on this address.
# Anyone with a cable gets root: never put glassine.devmode in CMDLINE below
# for an end-user device.
DEVMODE_ADDR=172.16.42.1
DEVMODE_NETMASK=255.255.255.0
DEVMODE_DHCP_START=172.16.42.2
DEVMODE_DHCP_END=172.16.42.10
# USB identity of the gadget (defaults: the Linux Foundation multifunction
# composite gadget, "GlassineOS").
#USB_VENDOR=0x1d6b
#USB_PRODUCT=0x0104
#USB_MANUFACTURER=GlassineOS

# --- Boot image (glassine-bootimg install) ---------------------------------
# The kernel, DTB and initramfs a new boot image is built from.
KERNEL=/boot/vmlinuz-sdm660
DTB=/boot/dtbs-sdm660/qcom/sdm636-onyx-noteair.dtb
INITRAMFS=/usr/share/glassine-bootimg/initramfs.cpio.gz
# The kernel command line (glassine-bootimg-pack adds glassine.img=<ID>).
# glassine.return=<s>: a test boot that the default role does not take over
# reboots to the default slot after this many seconds.
CMDLINE="panic=5 loglevel=7 mitigations=off rdinit=/init glassine.return=180"
# Android boot image header v0 fields: take them from an image the
# bootloader is known to boot on this device (here: the vendor recovery).
PAGE_SIZE=4096
KERNEL_ADDR=0x00008000
RAMDISK_ADDR=0x01000000
SECOND_ADDR=0x00000000
TAGS_ADDR=0x00000100
OS_VERSION=0x1800063c
NAME=glassine
