#!/sbin/openrc-run
# The deployments layout's partitions read-only for power-off: a service of the
# shutdown runlevel (rc-update add glassine-mount-ro shutdown), after OpenRC's
# mount-ro. mount-ro skips what is no longer in the mount table, and by then
# userdata isn't (localmount's stop unmounted /run/glassine/*, the overlay keeps
# it alive): without this step its ext4 journal needs a replay at every boot.
# gr_shutdown_ro (lib/glassine-root.sh) makes userdata, then the system
# partition, read-only with every mount and bind of them. Never stops the
# shutdown.
# Before that, the shutdown screen kept through the next start (GlassineOS/shell
# 009 FR-011, specs/011 FR-014): where the shell left /run/glassine/screen-keep, the
# splash store's override "leave the screen" (glassine-splash-store, bounded by a
# timeout; it reads board.conf and the boot libraries from the read-only root and
# mounts a FAT boot partition itself under /run, which stays writable). A soft
# restart writes none (specs/013 FR-032).
# shellcheck disable=SC2034  # read by openrc-run
description="glassine: userdata and the system partition read-only for power-off"

depend() {
	after mount-ro glassine-switch
}

# keep_screen: the override "leave the screen" when the shell asked for it; at most
# GLASSINE_SPLASH_TIMEOUT seconds (15; a tool that ignores the TERM, or waits on a
# child, killed 2 s later), never failing the shutdown
keep_screen() {
	_ks=${GLASSINE_SCREEN_KEEP:-/run/glassine/screen-keep}
	_kt=${GLASSINE_SPLASH_STORE:-/usr/sbin/glassine-splash-store}
	[ -e "$_ks" ] && [ -x "$_kt" ] || return 0
	ebegin "glassine: the shutdown screen kept through the next start"
	timeout -k 2 "${GLASSINE_SPLASH_TIMEOUT:-15}" "$_kt" override --leave --wait 5 2>&1
	eend $? "glassine-splash-store failed: the next start may draw over the screen"
	return 0
}

start() {
	# a soft restart keeps both mounted and writable (specs/013 FR-023): its own
	# cold fallback makes them read-only where it gives up
	[ ! -e /run/glassine/restarting ] || return 0
	keep_screen
	ebegin "glassine: userdata and the system partition read-only"
	(
		CONF=${GLASSINE_DEPLOY_CONF:-/etc/glassine/deploy.conf}
		SYSTEM_DEV='' USERDATA_DEV=''
		# shellcheck source=/dev/null
		[ -r "$CONF" ] && . "$CONF"
		# shellcheck source=../lib/glassine-state.sh
		. /usr/lib/glassine-boot/glassine-state.sh
		# shellcheck source=../lib/glassine-root.sh
		. /usr/lib/glassine-boot/glassine-root.sh
		# a PC's deploy.conf names neither: the partitions this boot's command line
		# names (010 FR-051); one that can't be found is logged and left to the
		# shutdown's own handling
		# shellcheck source=../lib/glassine-bootpart.sh
		if [ -r /usr/lib/glassine-boot/glassine-bootpart.sh ] && . /usr/lib/glassine-boot/glassine-bootpart.sh; then
			gp_conf_dev SYSTEM_DEV glassine.system /proc/cmdline || { ewarn "$GP_WHY"; SYSTEM_DEV=''; }
			gp_conf_dev USERDATA_DEV glassine.userdata /proc/cmdline || { ewarn "$GP_WHY"; USERDATA_DEV=''; }
		fi
		rc=0
		for dev in "$USERDATA_DEV" "$SYSTEM_DEV"; do
			[ -z "$dev" ] || gr_shutdown_ro "$dev" || rc=1
		done
		exit $rc
	)
	eend $?
}
