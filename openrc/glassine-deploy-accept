#!/sbin/openrc-run
# Accepts the booted deployment candidate after a healthy boot
# (glassine-deploy-accept). A one-shot job in the background, so it never holds
# up the boot; the service stays "started". As the system goes down (a shutdown
# or a restart, not a plain stop of the service) its stop runs the loader's
# shutdown step (glassine-loader-mark shutdown, 010 FR-012), before localmount
# takes the system partition and the boot partition it mounts away: `need`, so
# localmount's stop stops this service first and waits for it; `after *` alone
# orders nothing once OpenRC stops services in parallel (rc_parallel).
# shellcheck disable=SC2034  # read by openrc-run
description="glassine: accept the booted deployment candidate after a healthy boot"

JOBPID=/run/glassine-deploy-accept.job

depend() {
	need localmount
	after *
}

start() {
	ebegin "glassine-deploy-accept: checking the booted deployment after it settles"
	setsid /bin/sh -c 'echo $$ > '"$JOBPID"'
		/usr/sbin/glassine-deploy-accept
		rm -f '"$JOBPID" </dev/null >/dev/null 2>&1 &
	eend 0
}

stop() {
	if [ -s "$JOBPID" ]; then
		kill "$(cat "$JOBPID")" 2>/dev/null
		rm -f "$JOBPID"
	fi
	# the loader's shutdown step belongs to the end of the kernel run: a soft
	# restart is none (specs/013 FR-018)
	if yesno "${RC_GOINGDOWN:-NO}" && [ ! -e /run/glassine/restarting ] && [ -x /usr/sbin/glassine-loader-mark ]; then
		/usr/sbin/glassine-loader-mark shutdown
	fi
	return 0
}
