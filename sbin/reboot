#!/bin/sh
# reboot [-d N] [-n] [-f] [<reason>] — busybox reboot, plus a reason such as
# recovery or bootloader. busybox reboot takes only its options and drops any
# other word, so `reboot bootloader` would come back to the system. Installed as
# /usr/sbin/reboot, ahead of busybox's /sbin/reboot in PATH.
#   no reason         busybox reboot with the options as given
#   <reason>          glassine-reboot-clean <reason>: the whole shutdown, then the
#                     reason reaches the bootloader
#   -f <reason>       no shutdown (like -f): glassine-reboot-clean with
#                     GLASSINE_REBOOT_FORCE=1, which writes a loader request
#                     (menu, recovery) and then reboots with busybox reboot -f,
#                     or hands the reason to glassine-reboot at once
# -d and -n don't go with a reason (exit 2).
# The shutdown record (docs/deployments.md, "Runtime directory"): without a reason
# next=restart in /run/glassine/shutdown when no record is there yet (a caller that
# named a more specific target first wins); with a reason glassine-reboot-clean writes
# next=<reason>. A record that can't be written never stops the reboot.
BUSYBOX_REBOOT=${GLASSINE_BUSYBOX_REBOOT:-/sbin/reboot}
CLEAN=${GLASSINE_REBOOT_CLEAN:-/usr/sbin/glassine-reboot-clean}
NOW=${GLASSINE_REBOOT:-/usr/sbin/glassine-reboot}
REC=${GLASSINE_SHUTDOWN_RECORD:-/run/glassine/shutdown}
reason='' force='' other='' delay=''
for a in "$@"; do
	[ -z "$delay" ] || { delay=; continue; }
	case "$a" in
	-f) force=1 ;;
	-d) other=1 delay=1 ;;
	-*) other=1 ;;
	*)
		[ -z "$reason" ] || { echo "reboot: one reason only" >&2; exit 2; }
		reason=$a
		;;
	esac
done
if [ -z "$reason" ]; then
	[ -e "$REC" ] || { mkdir -p "${REC%/*}" && printf 'next=restart\n' > "$REC.new" && mv -f "$REC.new" "$REC"; } 2>/dev/null || rm -f "$REC.new" 2>/dev/null
	exec "$BUSYBOX_REBOOT" "$@"
fi
[ -z "$other" ] || { echo "reboot: only -f goes with a reason" >&2; exit 2; }
case "$reason" in *[!a-z0-9-]*) echo "reboot: bad reason '$reason'" >&2; exit 2 ;; esac
if [ -n "$force" ]; then
	GLASSINE_REBOOT_FORCE=1 GLASSINE_REBOOT=$NOW GLASSINE_INIT_REBOOT="$BUSYBOX_REBOOT -f" exec "$CLEAN" "$reason"
fi
GLASSINE_INIT_REBOOT=$BUSYBOX_REBOOT exec "$CLEAN" "$reason"
