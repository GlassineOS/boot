#!/bin/sh
# reboot [-d N] [-n] [-f] [<reason>] — busybox reboot, plus a reason such as
# recovery or bootloader. busybox reboot takes only its options and drops any
# other word, so `reboot bootloader` would come back to the system. Installed as
# /usr/sbin/reboot, ahead of busybox's /sbin/reboot in PATH.
#   no reason         busybox reboot with the options as given
#   <reason>          glassine-reboot-clean <reason>: the whole shutdown, then the
#                     reason reaches the bootloader
#   -f <reason>       glassine-reboot <reason> at once, no shutdown (like -f)
# -d and -n don't go with a reason (exit 2).
BUSYBOX_REBOOT=${GLASSINE_BUSYBOX_REBOOT:-/sbin/reboot}
CLEAN=${GLASSINE_REBOOT_CLEAN:-/usr/sbin/glassine-reboot-clean}
NOW=${GLASSINE_REBOOT:-/usr/sbin/glassine-reboot}
reason='' force='' other='' delay=''
for a in "$@"; do
	[ -z "$delay" ] || { delay=; continue; }
	case "$a" in
	-f) force=1 ;;
	-d) other=1 delay=1 ;;
	-*) other=1 ;;
	*)
		[ -z "$reason" ] || { echo "reboot: one reason only" >&2; exit 2; }
		reason=$a
		;;
	esac
done
[ -n "$reason" ] || exec "$BUSYBOX_REBOOT" "$@"
[ -z "$other" ] || { echo "reboot: only -f goes with a reason" >&2; exit 2; }
case "$reason" in *[!a-z0-9-]*) echo "reboot: bad reason '$reason'" >&2; exit 2 ;; esac
if [ -n "$force" ]; then
	sync
	exec "$NOW" "$reason"
fi
GLASSINE_INIT_REBOOT=$BUSYBOX_REBOOT exec "$CLEAN" "$reason"
