#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# glassine-loader-mark: the running system's writes of the loader's start count
# (`unmarked` in the loader record, docs/boot-partition.md "Keys", 010 FR-011,
# FR-012, FR-023) and of its one-shot requests (`request`: menu, recovery).
#
#   glassine-loader-mark has-record    exit 0 when this board's hand-off keeps a
#                                      loader record, 3 when it keeps none
#   glassine-loader-mark healthy       the healthy mark: unmarked=0 (run by
#                                      glassine-deploy-accept on a healthy boot,
#                                      and by glassine-hibernate after a resume)
#   glassine-loader-mark display-retry the person's retry of the firmware-refreshed
#                                      display (docs/handback.md, "A display
#                                      through the firmware's refresh"): clears the
#                                      loader's sticky display_failed (and drew);
#                                      nothing to clear: exit 0, nothing written.
#                                      Never run by a healthy mark
#   glassine-loader-mark shutdown      the shutdown step: one off unmarked, never
#                                      below 0, when FR-012 allows it (run by the
#                                      glassine-deploy-accept service as the
#                                      system goes down)
#   glassine-loader-mark request menu|recovery
#                                      the one-shot request for the next start
#                                      (docs/boot-partition.md "Keys"): menu, the
#                                      start menu (only a loader under a parent,
#                                      BOOT_FORM=raw, takes it; docs/handback.md
#                                      "The start menu"); recovery, the recovery
#                                      (both forms, 012 FR-021). Run by
#                                      glassine-reboot-clean before its reboot
#   glassine-loader-mark request clear a menu or recovery request taken back
#   glassine-loader-mark display-sync  the board's loader keys (board.conf), in one
#                                      write when one differs: the record's
#                                      `display` set to LOADER_DISPLAY (e.g.
#                                      epd-fw), and an empty `touch` set to
#                                      LOADER_TOUCH (on: the loader's touch driver
#                                      in the start menu; a person's touch value,
#                                      probe or off, is kept), `parent_cmdline` and
#                                      `parent_sets` set to LOADER_PARENT_CMDLINE
#                                      and LOADER_PARENT_SETS (no: the parent
#                                      bootloader passes no command line, boots no
#                                      kernel set; docs/handback.md), `other` set
#                                      to LOADER_OTHER (e.g. android: the parent's
#                                      other system, docs/handback.md "The other
#                                      system"). All absent
#                                      or empty: nothing written. Never touches
#                                      display_failed or drew (only display-retry
#                                      clears those). Run by glassine-loader-update
#   glassine-loader-mark deploys       the deployment list (docs/boot-partition.md
#                                      "Keys": deploys, deploy1 ...) from stdin, one
#                                      "<id> <state> <label>" line per deployment
#                                      (state previous, candidate, failed or kept;
#                                      label up to 64 printable ASCII characters),
#                                      at most 32; deployN keys past the new count
#                                      cleared; one write, only when it differs. A
#                                      line that breaks the form is said and left
#                                      out. Run by glassine-deploy (publish), which
#                                      holds the state lock and says so with
#                                      GLASSINE_LOADER_MARK_LOCKED=1
#   glassine-loader-mark can-request menu|recovery
#                                      exit 0 when this board's loader takes that
#                                      request, 3 when it doesn't; reads only
#                                      board.conf, writes nothing (the desktop's
#                                      check before it offers the entry)
#   glassine-loader-mark restart-check what the record says about the next cold
#                                      start, for a soft restart (specs/013
#                                      FR-001): nothing printed when it starts this
#                                      boot's set, else loader-request,
#                                      loader-default or loader-unreadable
#                                      (gp_restart_word); exit 0 either way. Reads
#                                      only (a FAT boot partition mounted
#                                      read-only), takes no lock
#
# Under a parent (BOOT_FORM=raw) a request is written only when the region loader
# holds a valid loader (else exit 3: the parent would boot its baseline and leave the
# request for a later start). A request is written last, alone, by gp_write, then the record is read again:
# it counts only when both slots are valid and the record in use holds it (the
# loader takes a request only from such a record). A kernel trial's request
# (request=trial) is glassine-bootimg's: neither replaced nor cleared here.
#
# Where the record is comes from the board (board.conf HANDOFF and BOOT_FORM; the
# backend in lib/glassine-bootpart.sh, gp_kind and gp_open): with HANDOFF=uefi, the
# FAT boot partition (BOOT_PART), mounted for the one write and unmounted again;
# with BOOT_FORM=raw, the raw boot partition (the partition named BOOT_PART, its
# region table, the slots of its region record; docs/boot-partition.md "The raw
# form"). A board without a loader record has nothing to write: exit 0, nothing
# said. The write is the
# library's (gp_write: the other slot, seq + 1, every other key kept, flushed and
# read back); this tool never makes a record where there is none.
#
# The write holds the system partition's state lock ($SYSTEM_MNT/state/.lock),
# the one glassine-bootimg holds for its own record writes, so the two never
# write the same slot at once. Busy: tried again for up to LOCK_WAIT seconds
# (healthy: ACCEPT_BUSY_S of deploy.conf, default 600; shutdown: 10).
#
# What this start did, in RUN_DIR (deploy.conf, default /run/glassine):
#   loader-marked     the healthy mark was written in this start (by this tool)
#   health-failed     a health check failed in this start (glassine-deploy-accept)
#   booted            bare:* = a bare boot (the initramfs)
#   limit-start       this start is the loader's start of the previous set for
#                     its limit (the record's started = this boot's set,
#                     started_why=limit), written by `healthy` whether or not the
#                     mark's write succeeds: glassine-deploy-accept then runs
#                     glassine-bootimg rollback --limit (010 FR-013)
# The shutdown step takes one off only when neither of the first two is there,
# the start was no bare boot, the record's `started` is the set this boot runs
# (glassine.img= on the command line) and `started_why` is default, limit or
# choice. Under a parent (BOOT_FORM=raw), a `started` that is empty with
# started_why=default is the parent's baseline (the record's default empty,
# docs/handback.md): it is this boot's when this boot runs no set either slot of
# the record names.
#
# The deployment list (deploys) is written by glassine-deploy, which holds the state
# lock already: with GLASSINE_LOADER_MARK_LOCKED=1 this tool takes no lock itself.
#
# Exit: 0 written or nothing to write, 1 not written (said; for request: the
# record in use is as it was, or holds a request the loader won't take), 2 usage,
# 3 (has-record) no loader record, (request, can-request) this board's loader
# takes no such request, 6 busy (the state lock stayed held).
# Test hooks: GLASSINE_DEPLOY_CONF, GLASSINE_BI_BOARD, GLASSINE_BI_CMDLINE,
# GLASSINE_BI_LIB, GLASSINE_BI_SYSTEM, GLASSINE_BI_RUN_DIR, GLASSINE_BI_TMP, and
# the library's (GLASSINE_BI_BOOTPART_DIR, GLASSINE_BI_BOOTPART_DEV, ...).
set -u
CONF=${GLASSINE_DEPLOY_CONF:-/etc/glassine/deploy.conf}
BOARD=${GLASSINE_BI_BOARD:-/etc/glassine-bootimg/board.conf}
GBLIB=${GLASSINE_BI_LIB:-/usr/lib/glassine-boot}
RUN_DIR=/run/glassine SYSTEM_MNT=/run/glassine/system ACCEPT_BUSY_S=600
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
HANDOFF='' BOOT_FORM='' BOOT_PART=glassine-boot LOADER_DISPLAY='' LOADER_TOUCH='' LOADER_PARENT_CMDLINE='' LOADER_PARENT_SETS='' LOADER_OTHER=''
# shellcheck source=/dev/null
[ -r "$BOARD" ] && . "$BOARD"
# after board.conf: its CMDLINE is the set's base command line, not this file
CMDLINE=${GLASSINE_BI_CMDLINE:-/proc/cmdline}
SYS=${GLASSINE_BI_SYSTEM:-$SYSTEM_MNT}
MNT=${GLASSINE_BI_RUN_DIR:-$RUN_DIR}/boot-partition

say() {
    echo "glassine-loader-mark: $*" >&2
    { [ -w /dev/kmsg ] && echo "<5>glassine-loader-mark: $*" > /dev/kmsg; } 2>/dev/null
    return 0
}

cmd=${1:-} what=${2:-}
USAGE="usage: glassine-loader-mark has-record|healthy|shutdown|display-retry|display-sync|deploys|restart-check|request menu|recovery|clear|can-request menu|recovery"
case $cmd in
has-record|healthy|shutdown|display-retry|display-sync|deploys|restart-check) [ $# = 1 ] || { echo "$USAGE" >&2; exit 2; } ;;
request) [ $# = 2 ] && case $what in menu|recovery|clear) ;; *) false ;; esac || { echo "$USAGE" >&2; exit 2; } ;;
can-request) [ $# = 2 ] && case $what in menu|recovery) ;; *) false ;; esac || { echo "$USAGE" >&2; exit 2; } ;;
*) echo "$USAGE" >&2; exit 2 ;;
esac
# shellcheck source=../lib/glassine-bootpart.sh
. "$GBLIB/glassine-bootpart.sh"
# shellcheck disable=SC2034  # read by the library
GP_TMP=${GLASSINE_BI_TMP:-/run}
kind=$(gp_kind "$HANDOFF" "$BOOT_FORM"); kr=$?
[ $kr != 2 ] || { say "board.conf: the boot partition's form is wrong: nothing written"; exit 1; }
case $cmd in request|can-request)
    if ! gp_has_record "$kind"; then
        [ "$cmd" = can-request ] || say "this board keeps no loader record (board.conf: no HANDOFF=uefi, no BOOT_FORM=raw): no $what request written"
        exit 3
    fi
    # a PC's loader opens its list with a key at power-on and takes no menu request
    if [ "$what" = menu ] && [ "$kind" != raw ]; then
        [ "$cmd" = can-request ] || say "this board's loader shows no start menu on request (only a loader under a parent, BOOT_FORM=raw, does): nothing written"
        exit 3
    fi
    [ "$cmd" = request ] || exit 0
    ;;
esac
gp_has_record "$kind" || { [ "$cmd" = has-record ] && exit 3; exit 0; }
[ "$cmd" = has-record ] && exit 0
if [ "$cmd" = restart-check ]; then
    gp_restart_word "$kind" "$CMDLINE" "$BOOT_PART" "$MNT"
    exit 0
fi
if [ "$cmd" = display-sync ]; then
    [ -n "$LOADER_DISPLAY$LOADER_TOUCH$LOADER_PARENT_CMDLINE$LOADER_PARENT_SETS$LOADER_OTHER" ] || exit 0
    case $LOADER_OTHER in *[!a-z0-9-]*) say "board.conf: LOADER_OTHER '$LOADER_OTHER' is not a value of the record: nothing written"; exit 1 ;; esac
    case $LOADER_DISPLAY in *[!a-z0-9-]*) say "board.conf: LOADER_DISPLAY '$LOADER_DISPLAY' is not a value of the record: nothing written"; exit 1 ;; esac
    case $LOADER_TOUCH in ''|on) ;; *) say "board.conf: LOADER_TOUCH '$LOADER_TOUCH' is not a value of the record (on): nothing written"; exit 1 ;; esac
    for v in "$LOADER_PARENT_CMDLINE" "$LOADER_PARENT_SETS"; do
        case $v in ''|no) ;; *) say "board.conf: LOADER_PARENT_CMDLINE/LOADER_PARENT_SETS '$v' is not a value of the record (no): nothing written"; exit 1 ;; esac
    done
fi
# the deployment list, read and checked before the lock: "<id> <state> <label>" lines
if [ "$cmd" = deploys ]; then
    DL=$(mktemp "${GLASSINE_BI_TMP:-/run}/glassine-loader-mark.deploys.XXXXXX") || { say "cannot make a temporary file: nothing written"; exit 1; }
    dn=0
    while IFS= read -r l || [ -n "$l" ]; do
        [ -n "$l" ] || continue
        id=${l%% *} rest=''
        [ "$id" = "$l" ] || rest=${l#* }
        state=${rest%% *} label=''
        [ "$state" = "$rest" ] || label=${rest#* }
        bad=''
        case $id in ''|.*|*[!A-Za-z0-9._-]*) bad="not a deployment id" ;; esac
        case $state in previous|candidate|failed|kept) ;; *) bad=${bad:-"state '$state' is not previous, candidate, failed or kept"} ;; esac
        [ ${#label} -le 64 ] || bad=${bad:-"the label is longer than 64 characters"}
        case $label in *[!\ -~]*) bad=${bad:-"the label holds a character outside printable ASCII"} ;; esac
        if [ -n "$bad" ]; then say "deploys: '$l' left out: $bad"; continue; fi
        [ $dn -lt 32 ] || { say "deploys: more than 32 deployments: '$l' and the ones after it left out"; break; }
        dn=$((dn + 1))
        echo "deploy$dn=$id $state${label:+ $label}" >> "$DL"
    done
fi

# the shutdown step's conditions that need no record (FR-012)
if [ "$cmd" = shutdown ]; then
    [ ! -e "$RUN_DIR/loader-marked" ] || exit 0
    [ ! -e "$RUN_DIR/health-failed" ] || exit 0
    case $(cat "$RUN_DIR/booted" 2>/dev/null) in bare:*) exit 0 ;; esac
    run=$(tr ' ' '\n' < "$CMDLINE" | sed -n 's/^glassine\.img=//p' | head -n 1)
    # under a parent (the raw form) the baseline may run with no image id
    [ -n "$run" ] || [ "$kind" = raw ] || exit 0
    wait_s=${LOCK_WAIT:-10}
elif [ "$cmd" = request ] || [ "$cmd" = display-sync ] || [ "$cmd" = deploys ]; then
    wait_s=${LOCK_WAIT:-10}     # a person waits for the reboot; the accept step for the update
else
    wait_s=${LOCK_WAIT:-$ACCEPT_BUSY_S}
fi

if [ "${GLASSINE_LOADER_MARK_LOCKED:-}" != 1 ]; then
    [ -d "$SYS/state" ] || { say "the system partition's state is not at $SYS: nothing written"; exit 1; }
    exec 9>>"$SYS/state/.lock" || { say "cannot open $SYS/state/.lock: nothing written"; exit 1; }
    n=0
    until flock -n 9; do
        [ $n -lt "$wait_s" ] || { say "busy: $SYS/state/.lock stayed held: nothing written"; exit 6; }
        sleep 1; n=$((n + 1))
    done
fi

rc=0
trap 'gp_close >/dev/null 2>&1; gp_clean; rm -f "${DL:-}"' EXIT
gp_open "$kind" "$CMDLINE" "$BOOT_PART" "$MNT" || { say "$GP_WHY: nothing written"; exit 1; }
if ! gp_in_use "$GP_DIR"; then
    say "$GP_WHY: nothing written"
    exit 1
fi
count=$(gp_get "$GP_REC" unmarked)
case $count in ''|*[!0-9]*) say "the record's unmarked is '$count', not a count: nothing written"; exit 1 ;; esac
case $cmd in
display-sync)
    cur=$(gp_get "$GP_REC" display) tcur=$(gp_get "$GP_REC" touch)
    set --
    [ -z "$LOADER_DISPLAY" ] || [ "$cur" = "$LOADER_DISPLAY" ] || set -- "display=$LOADER_DISPLAY"
    [ -z "$LOADER_TOUCH" ] || [ -n "$tcur" ] || set -- "$@" "touch=$LOADER_TOUCH"
    [ -z "$LOADER_PARENT_CMDLINE" ] || [ "$(gp_get "$GP_REC" parent_cmdline)" = "$LOADER_PARENT_CMDLINE" ] || set -- "$@" "parent_cmdline=$LOADER_PARENT_CMDLINE"
    [ -z "$LOADER_PARENT_SETS" ] || [ "$(gp_get "$GP_REC" parent_sets)" = "$LOADER_PARENT_SETS" ] || set -- "$@" "parent_sets=$LOADER_PARENT_SETS"
    ocur=$(gp_get "$GP_REC" other)
    [ -z "$LOADER_OTHER" ] || [ "$ocur" = "$LOADER_OTHER" ] || set -- "$@" "other=$LOADER_OTHER"
    if [ $# = 0 ]; then
        :
    elif ! gp_write "$GP_DIR" "$@"; then
        say "$* not written: $GP_WHY"; rc=1
    elif ! gp_in_use "$GP_DIR"; then
        say "$*: the record can't be read back ($GP_WHY)"; rc=1
    else
        for kv in "$@"; do
            if [ "$(gp_get "$GP_REC" "${kv%%=*}")" != "${kv#*=}" ]; then
                say "$kv: the record in use doesn't hold it"; rc=1
            elif [ "${kv%%=*}" = display ]; then
                say "$kv written (was '$cur')"
            elif [ "${kv%%=*}" = touch ]; then
                say "$kv written (was '$tcur')"
            elif [ "${kv%%=*}" = other ]; then
                say "$kv written (was '$ocur')"
            else
                say "$kv written"
            fi
        done
    fi
    ;;
deploys)
    old=$(gp_get "$GP_REC" deploys)
    set -- "deploys=$dn"
    while IFS= read -r kv; do set -- "$@" "$kv"; done < "$DL"
    k=$((dn + 1))
    while [ $k -le 32 ]; do
        grep -q "^deploy$k=" "$GP_REC" && set -- "$@" "deploy$k="
        k=$((k + 1))
    done
    same=1
    for kv in "$@"; do
        [ "$(gp_get "$GP_REC" "${kv%%=*}")" = "${kv#*=}" ] && grep -q "^${kv%%=*}=" "$GP_REC" || { same=0; break; }
    done
    if [ $same = 1 ]; then
        say "deploys: the record holds this list already ($dn): nothing written"
    elif ! gp_write "$GP_DIR" "$@"; then
        say "deploys=$dn not written: $GP_WHY"; rc=1
    elif ! gp_in_use "$GP_DIR" || [ "$(gp_get "$GP_REC" deploys)" != "$dn" ]; then
        say "deploys=$dn: the record in use doesn't hold it"; rc=1
    else
        say "deploys=$dn written (was '${old}')"
    fi
    ;;
request)
    want=$what; [ "$want" != clear ] || want=''
    cur=$(gp_get "$GP_REC" request)
    if [ "$cur" = trial ]; then
        say "a kernel trial is requested (glassine-bootimg reboot-test): request $what not written; glassine-bootimg cancel takes the trial back"
        exit 1
    fi
    # under a parent, a request only the loader acts on: with no loader in the region the
    # parent boots its baseline, and the request would wait for a later start
    if [ -n "$want" ] && [ "$kind" = raw ] && ! gr_item loader "$GP_TMP/glassine-bootpart.ldr.$$"; then
        rm -f "$GP_TMP/glassine-bootpart.ldr.$$"
        say "the boot partition holds no loader ($GR_WHY): the parent wouldn't act on request=$want; nothing written"
        exit 3
    fi
    rm -f "$GP_TMP/glassine-bootpart.ldr.$$"
    if [ "$cur" = "$want" ] && { [ -z "$want" ] || [ "$GP_BOTH" = 1 ]; }; then
        say "request: the record holds request=$cur already: nothing written"
    elif ! gp_write "$GP_DIR" "request=$want"; then
        say "request=$want not written: $GP_WHY"; rc=1
    elif ! gp_in_use "$GP_DIR"; then
        say "request=$want: the record can't be read back ($GP_WHY)"; rc=1
    elif [ "$(gp_get "$GP_REC" request)" != "$want" ]; then
        say "request=$want: the record in use doesn't hold it"; rc=1
    elif [ -n "$want" ] && [ "$GP_BOTH" != 1 ]; then
        say "request=$want: only one slot is valid, the loader won't take it"; rc=1
    elif [ -n "$want" ]; then
        say "request=$want written: the loader takes it at the next start"
    else
        say "request=$cur cleared"
    fi
    ;;
display-retry)
    failed=$(gp_get "$GP_REC" display_failed)
    if [ -z "$failed" ]; then
        say "display-retry: display_failed isn't set: nothing written"
    elif gp_write "$GP_DIR" display_failed= drew=; then
        say "display-retry: display_failed=$failed cleared; the loader draws again after a healthy start"
    else
        say "display-retry not written: $GP_WHY"; rc=1
    fi
    ;;
healthy)
    run=$(tr ' ' '\n' < "$CMDLINE" | sed -n 's/^glassine\.img=//p' | head -n 1)
    if [ -n "$run" ] && [ "$(gp_get "$GP_REC" started)" = "$run" ] && [ "$(gp_get "$GP_REC" started_why)" = limit ]; then
        : > "$RUN_DIR/limit-start"
    fi
    if [ "$count" = 0 ]; then
        : > "$RUN_DIR/loader-marked"
        say "the healthy mark: unmarked is 0 already"
    elif gp_write "$GP_DIR" unmarked=0; then
        : > "$RUN_DIR/loader-marked"
        say "the healthy mark written (unmarked $count -> 0)"
    else
        say "the healthy mark not written: $GP_WHY"; rc=1
    fi
    ;;
shutdown)
    started=$(gp_get "$GP_REC" started) why=$(gp_get "$GP_REC" started_why)
    # under a parent the default set is the parent's baseline, which the loader's
    # count names by an empty started (docs/handback.md, "The loader record under a
    # parent"): a boot that runs no set the record names is that baseline
    if [ "$started" != "$run" ]; then
        [ "$kind" = raw ] && [ -z "$started" ] && [ "$why" = default ] || exit 0
        case $(gp_names | tr '\n' ' ') in *"$run "*) [ -z "$run" ] || exit 0 ;; esac
    fi
    case $why in default|limit|choice) ;; *) exit 0 ;; esac
    [ "$count" != 0 ] || exit 0
    if gp_write "$GP_DIR" unmarked=$((count - 1)); then
        say "an orderly shutdown: this start taken out of the count (unmarked $count -> $((count - 1)))"
    else
        say "the shutdown step not written: $GP_WHY"; rc=1
    fi
    ;;
esac
gp_close || { say "$GP_WHY"; rc=1; }
exit $rc
