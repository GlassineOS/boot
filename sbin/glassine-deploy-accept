#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# glassine-deploy-accept: the boot-success step of a deployment candidate. When
# the booted deployment (/run/glassine/booted) is the candidate, wait until the
# system has been up ACCEPT_AFTER seconds (deploy.conf, default 120), check its
# health, and accept it (glassine-deploy accept). Unhealthy or never reached:
# not accepted, so the next boot uses the candidate's next try, and after the
# last one the old deployment boots again.
#
# Health = the same checks as a kernel test boot (one definition of a healthy
# system): no crashed OpenRC service, and every executable in
# ACCEPT_HEALTH_DIR (default /etc/glassine-bootimg/health.d; the device and
# desktop packages ship them) exits 0 within 60 s; a non-zero exit = unhealthy,
# its first output line = the reason.
#
#   glassine-deploy-accept          run by the OpenRC service glassine-deploy-accept
# Boot slot (dual-boot boards, SLOT_TOOL = the path of glassine-slot, empty =
# off): a healthy boot also marks the booted bootloader slot successful, for any
# deployment (candidate, current or a fallback), since the slot itself works.
# Without that the bootloader counts a try per boot after a kernel update and
# ends up in the other system. A bare boot (userdata broken) does not mark it.
#
# The healthy mark (a board whose loader keeps a loader record, HANDOFF=uefi or
# BOOT_FORM=raw;
# MARK_TOOL = glassine-loader-mark): a healthy boot also writes unmarked=0 into the
# loader record (010 FR-023), whichever deployment booted and also with no
# candidate, also on a start by request. Not on a bare boot, a kernel trial boot,
# or a boot that fails a health check; that failure is noted in
# /run/glassine/health-failed for the shutdown step (FR-012). A failing write is
# logged and does not stop the accept. A healthy start the loader made on the
# previous set because its count reached the limit (glassine-loader-mark's
# RUN_DIR/limit-start) then runs glassine-bootimg rollback --limit (FR-013): that
# set becomes the default kernel, the one that failed is listed as failed.
#
# The deployment list: after that mark, a start that accepts nothing runs
# glassine-deploy publish (the accept publishes it itself), so the loader record's
# list follows what changed at boot (a candidate that failed).
# The loader update (BOOT_FORM=raw; LOADER_UPDATE = glassine-loader-update, specs/012
# FR-026): only after this start's healthy mark succeeded (written, or the count
# was 0 already; so the deployment
# that arms the loader is one that marks its starts healthy on the raw form), and on
# a candidate only once it is accepted (a candidate that is never accepted can't
# leave an armed loader to an older deployment that can't mark). It writes the
# package's loader and default splash where the boot partition holds other ones; a
# failure is logged and changes nothing here.
#
# Not on a kernel trial or finishing boot (/run/glassine/kernel-boot, from the
# initramfs): that boot runs the current deployment, and glassine-bootimg-promote
# judges it; a finishing boot still writes the healthy mark. Nothing is accepted
# on a start of a deployment by request (/run/glassine/deploy-once, 010 FR-044).
#
# Exit: 0 accepted or nothing to accept, 1 not accepted (logged).
set -u
CONF=${GLASSINE_DEPLOY_CONF:-/etc/glassine/deploy.conf}
DEPLOY=${GLASSINE_DEPLOY:-/usr/sbin/glassine-deploy}
UPTIME=${GLASSINE_ACCEPT_UPTIME:-/proc/uptime}
MARK_TOOL=${GLASSINE_LOADER_MARK:-/usr/sbin/glassine-loader-mark}
BOOTIMG=${GLASSINE_BOOTIMG:-/usr/sbin/glassine-bootimg}
LOADER_UPDATE=${GLASSINE_LOADER_UPDATE:-/usr/sbin/glassine-loader-update}
RUN_DIR=/run/glassine ACCEPT_AFTER=120 ACCEPT_HEALTH_DIR=/etc/glassine-bootimg/health.d SLOT_TOOL=
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

say() {
    echo "glassine-deploy-accept: $*"
    { [ -w /dev/kmsg ] && echo "<5>glassine-deploy-accept: $*" > /dev/kmsg; } 2>/dev/null
    return 0
}
# the loader update, once this start's healthy mark is written (marked=1)
loader_update() {
    [ "$marked" = 1 ] && [ -x "$LOADER_UPDATE" ] || return 0
    "$LOADER_UPDATE" || say "the loader update failed (exit $?)"
}
# the deployment list in the loader record (glassine-deploy publish, 010 FR-041), on
# a healthy start that wrote its mark and accepted nothing (an accept publishes
# itself): what changed without a command (a candidate that failed at boot)
publish() {
    [ "$marked" = 1 ] || return 0
    "$DEPLOY" publish || say "the loader's deployment list not published (exit $?)"
}
field() { "$DEPLOY" status --porcelain 2>/dev/null | sed -n 2p | tr '\t' '\n' | sed -n "s/^$1=//p"; }

# the booted slot, when it is not marked successful yet (else nothing to do)
slot_todo() {
    [ -n "$SLOT_TOOL" ] || return 1
    st=$("$SLOT_TOOL" status --porcelain 2>/dev/null) || return 1
    b=$(echo "$st" | sed -n 's/^booted=//p')
    [ -n "$b" ] && echo "$st" | grep "^slot=$b	" | grep -q "	successful=0"
}

booted=$(cat "$RUN_DIR/booted" 2>/dev/null)
case $booted in ''|bare:*) exit 0 ;; esac
# a kernel trial or finishing boot (the initramfs says so, FR-012): the boot
# is the kernel's to judge (glassine-bootimg-promote), not the deployment's
kboot=$(cat "$RUN_DIR/kernel-boot" 2>/dev/null)
case $kboot in trial) say "a kernel trial boot: no deployment accept"; exit 0 ;; esac
cand=0 slot=0 mark=0 marked=0
# the healthy mark, when this board's hand-off keeps a loader record
[ -x "$MARK_TOOL" ] && "$MARK_TOOL" has-record && mark=1
if [ "$kboot" = finishing ]; then
    say "a kernel finishing boot: no deployment accept"
# a deployment started by request for this start only (glassine.deploy.once=,
# /run/glassine/deploy-once): it is no candidate here, whatever state/deploy says
elif [ -n "$(cat "$RUN_DIR/deploy-once" 2>/dev/null)" ]; then
    say "$booted runs by request for this start only: no deployment accept"
    slot_todo && slot=1
else
    [ "$booted" = "$(field candidate)" ] && cand=1
    slot_todo && slot=1
fi
[ $cand = 1 ] || [ $slot = 1 ] || [ $mark = 1 ] || exit 0

while [ "$(cut -d. -f1 "$UPTIME")" -lt "$ACCEPT_AFTER" ]; do sleep 5; done

bad=''
crashed=$(rc-status --crashed 2>/dev/null | tr '\n' ' ')
[ -z "${crashed% }" ] || bad="crashed: ${crashed% }"
for h in "$ACCEPT_HEALTH_DIR"/*; do
    [ -x "$h" ] || continue
    why=$(timeout 60 "$h" 2>/dev/null </dev/null) && continue
    case $? in 124|143) why="${h##*/}: timed out" ;; esac
    why=$(echo "$why" | head -n 1)
    bad="$bad${bad:+; }${why:-${h##*/}}"
done
if [ -n "$bad" ]; then
    echo "$bad" > "$RUN_DIR/health-failed" 2>/dev/null
    if [ $cand = 1 ]; then
        say "$booted not accepted: $bad (tries left: $(field tries))"
    elif [ $slot = 1 ]; then
        say "boot slot not marked successful: $bad"
    else
        say "no healthy mark: $bad"
    fi
    exit 1
fi
if [ $slot = 1 ]; then
    if "$SLOT_TOOL" mark-successful >/dev/null; then
        say "boot slot marked successful"
    else
        say "marking the boot slot successful failed (exit $?)"
    fi
fi
# in its own process: its state lock is gone before glassine-deploy accept takes it
if [ $mark = 1 ]; then
    if "$MARK_TOOL" healthy; then marked=1; else say "the healthy mark failed (exit $?)"; fi
    # a healthy start the limit caused (the loader started the previous set):
    # that set becomes the default by the kernel rollback (010 FR-013)
    if [ -e "$RUN_DIR/limit-start" ]; then
        n=0
        while :; do
            "$BOOTIMG" rollback --limit && break
            rc=$?
            [ $rc = 6 ] && [ $n -lt "${ACCEPT_BUSY_S:-600}" ] || { say "the rollback after the limit failed (exit $rc)"; break; }
            sleep 5; n=$((n + 5))
        done
    fi
fi
[ $cand = 1 ] || { publish; loader_update; exit 0; }
# busy (exit 6: another writer, or a hibernate holding the state lock across
# the sleep): try again for up to ACCEPT_BUSY_S seconds
n=0
while :; do
    "$DEPLOY" accept "$booted" && break
    rc=$?
    [ $rc = 6 ] && [ $n -lt "${ACCEPT_BUSY_S:-600}" ] || { say "accept $booted failed (exit $rc)"; exit 1; }
    sleep 5; n=$((n + 5))
done
say "$booted accepted after ${ACCEPT_AFTER}s healthy"
loader_update
exit 0
