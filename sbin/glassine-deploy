#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# glassine-deploy: root deployments (bases on the btrfs system partition, one
# overlay upper per deployment on userdata). The same code runs on the system
# and in recovery; the recovery's menu only calls it. Interface and formats:
# docs/deployments.md.
#
#   glassine-deploy status [--porcelain]
#   glassine-deploy list [--porcelain]
#   glassine-deploy select ID [--yes] [--discard-hibernation]
#   glassine-deploy rollback [--yes] [--discard-hibernation]
#   glassine-deploy hibernate-invalidate [--yes]
#   glassine-deploy reset [--full] [--now] [--yes] [--discard-hibernation]
#   glassine-deploy stage BASE [--no-replay] [--without NAME]… [--accept-downgrades] [--now] [--yes] [--discard-hibernation]
#   glassine-deploy receive FILE|- [--modules] [--sha256 HEX] [--discard-hibernation]
#   glassine-deploy bases [--porcelain]
#   glassine-deploy bases remove BASE [--yes] [--discard-hibernation]
#   glassine-deploy packages [ID] [--porcelain]
#   glassine-deploy switch [--discard-hibernation]
#   glassine-deploy accept ID
#
# select makes ID the candidate for the next boot (2 tries, then the current
# one again); selecting the current deployment cancels a candidate. rollback
# = select the previous one. hibernate-invalidate turns a hibernate image on
# userdata back into a plain swap file (that session is lost). reset stages
# a new deployment on the current one's base; the next switch fills it and
# selects it. stage BASE does the same on another base (a base update), with
# the user's package changes replayed into the new deployment's build layer:
# apk from the new base in a chroot, scripts on, an empty /run so that OpenRC
# starts nothing. A package version going down, or a package that no longer
# resolves, stops the stage with exit 7 and nothing staged: --accept-downgrades
# takes the lower versions, --without NAME leaves an added package out,
# --no-replay stages the bare base;
# receive puts a btrfs send stream (full or incremental, .zst by its name) under
# bases/ (or modules/), read-only; bases lists them with their users. bases
# remove deletes a base no deployment needs to boot now: it refuses the base of
# the booted, current, candidate or staged deployment, and asks first when other
# deployments (the previous one, usually) would lose theirs: those stay on
# userdata but can no longer be selected.
# packages lists how a deployment's packages differ from its base's (current
# by default): added and removed world entries, packages installed in another
# version (raised/lowered, by apk version -t when apk is there, else changed);
# derived each time from the world and the installed database, no bookkeeping.
# switch runs at shutdown (the hook's job, after services stop) or
# at once with reset --now (the recovery): it starts the staged deployment's
# switch layer afresh, carries the migrate list of the current deployment
# (/usr/share/glassine/migrate.list + /etc/glassine/migrate.d/*.list) into it,
# or nothing after reset --full, merges the user accounts into the new base's
# (lib/glassine-accounts.sh), and only then makes it the candidate; an
# interrupted switch selects nothing and is redone in full the next time. So
# changes made between the reset and the shutdown are carried. Home is on
# userdata, outside the deployments, and never touched. accept ID is the
# boot-success service's: the booted candidate ID becomes current.
#
# --porcelain: the first line is "glassine-deploy 1" (the output format
# version), then one record per line: tab-separated key=value fields, the
# first one type=<record>. Keys may be added within a version.
#
# Exit codes: 0 done, 1 error, 2 usage, 3 the state format on the system
# partition is newer than this tool (every command refuses; status still
# prints both versions), 4 hibernated and refused, 5 not enough space,
# 6 busy, 7 the replay needs a decision.
#
# Configuration: /etc/glassine/deploy.conf (conf/deploy.conf.example), or
# the file named by GLASSINE_DEPLOY_CONF.
set -u
CONF=${GLASSINE_DEPLOY_CONF:-/etc/glassine/deploy.conf}
LIB=${GLASSINE_DEPLOY_LIB:-/usr/lib/glassine-boot/glassine-state.sh}
SYSTEM_DEV='' SYSTEM_MNT=/run/glassine/system
USERDATA_DEV='' USERDATA_MNT=/run/glassine/userdata USERDATA_PREFIX=media/glassine
RUN_DIR=/run/glassine
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
# shellcheck source=../lib/glassine-state.sh
. "$LIB" || { echo "glassine-deploy: cannot read $LIB" >&2; exit 1; }
# shellcheck source=../lib/glassine-root.sh
. "${LIB%/*}/glassine-root.sh" || { echo "glassine-deploy: cannot read ${LIB%/*}/glassine-root.sh" >&2; exit 1; }
# shellcheck source=../lib/glassine-accounts.sh
. "${LIB%/*}/glassine-accounts.sh" || { echo "glassine-deploy: cannot read ${LIB%/*}/glassine-accounts.sh" >&2; exit 1; }

PORCELAIN_VERSION=1
SWAPFILE="$USERDATA_PREFIX/swap/hibernate"
GUARD="$USERDATA_PREFIX/swap/hibernate.guard"
MOUNTED_HERE='' UD_MOUNTED_HERE='' TMP_VIEW='' NEW_DEP='' SWITCHING='' RECV_TMP='' RECV_BEFORE=''
REPLAY_MNT='' REPLAY_BINDS='' REPLAY_RESOLV='' REPLAY_TMP=''

die() { echo "glassine-deploy: $*" >&2; exit 1; }
fail() { _c=$1; shift; echo "glassine-deploy: $*" >&2; exit "$_c"; }
usage() { sed -n 's/^#   //p' "$0" >&2; exit 2; }

# is_mounted DIR: busybox mountpoint, or the test hook (a plain directory)
is_mounted() {
    [ -n "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ] && { [ -d "$1" ]; return; }
    mountpoint -q "$1" 2>/dev/null
}

# fstype DEV: the file system type blkid reports, or empty
fstype() {
    blkid "$1" 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p' | head -n 1
}

# replay_umount: the replay's chroot down, binds first. The mount point is only
# ever rmdir'ed: while a bind is on it, a recursive remove would reach the host.
replay_umount() {
    [ -n "$REPLAY_MNT" ] || return 0
    for _m in $REPLAY_BINDS; do umount "$REPLAY_MNT$_m" || echo "glassine-deploy: cannot unmount $REPLAY_MNT$_m" >&2; done
    REPLAY_BINDS=''
    [ -z "$REPLAY_RESOLV" ] || rm -f "$REPLAY_MNT/etc/resolv.conf"
    REPLAY_RESOLV=''
    umount "$REPLAY_MNT" && rmdir "$REPLAY_MNT" || echo "glassine-deploy: cannot unmount $REPLAY_MNT" >&2
    REPLAY_MNT=''
}

cleanup() {
    replay_umount
    [ -n "$REPLAY_TMP" ] && rm -rf "$REPLAY_TMP"
    REPLAY_TMP=''
    [ -n "$TMP_VIEW" ] && umount "$TMP_VIEW" 2>/dev/null && rmdir "$TMP_VIEW" 2>/dev/null
    TMP_VIEW=''
    [ -n "$SWITCHING" ] && rm -f "$SWITCHING"
    SWITCHING=''
    # a half-built deployment never stays behind
    [ -n "$NEW_DEP" ] && rm -rf "$NEW_DEP"
    NEW_DEP=''
    # a failed receive leaves nothing behind: what it added to RECV_TMP
    # (bases/ or modules/) since RECV_BEFORE goes
    if [ -n "$RECV_TMP" ]; then
        for _r in "$RECV_TMP"/*; do
            [ -d "$_r" ] || continue
            printf '%s\n' "$RECV_BEFORE" | grep -qxF -- "${_r##*/}" && continue
            btrfs -q subvolume delete "$_r" >/dev/null 2>&1 || rm -rf "$_r"
        done
    fi
    RECV_TMP=''
    # the state lock (fd 9, on $SYSTEM_MNT/state/.lock) keeps the system
    # partition busy; cleanup runs only before the lock is taken or at exit
    exec 9>&-
    if [ -n "$UD_MOUNTED_HERE" ]; then
        umount "$UD_MOUNTED_HERE" || echo "glassine-deploy: cannot unmount $UD_MOUNTED_HERE" >&2
    fi
    UD_MOUNTED_HERE=''
    if [ -n "$MOUNTED_HERE" ]; then
        umount "$MOUNTED_HERE" || echo "glassine-deploy: cannot unmount $MOUNTED_HERE" >&2
    fi
    MOUNTED_HERE=''
}
trap cleanup EXIT INT TERM

# system_open: make the system partition's top level readable at SYSTEM_MNT.
# Sets SYS_FS (btrfs/ext4/…/none) and SYS_DIR (empty if not readable). A
# btrfs that is not mounted is mounted read-only with rescue=nologreplay
# (never a log replay: a hibernated system may be resumed later). Anything
# else is never mounted here (an ext4 read-only mount still replays its
# journal).
system_open() {
    SYS_DIR=''
    if is_mounted "$SYSTEM_MNT"; then
        SYS_FS=${GLASSINE_DEPLOY_FAKE_FS:-btrfs}
        [ -n "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ] || SYS_FS=$(fstype "$SYSTEM_DEV")
        SYS_DIR=$SYSTEM_MNT
        return 0
    fi
    [ -n "$SYSTEM_DEV" ] && [ -e "$SYSTEM_DEV" ] || { SYS_FS=none; return 0; }
    SYS_FS=$(fstype "$SYSTEM_DEV")
    [ "$SYS_FS" = btrfs ] || return 0
    mkdir -p "$SYSTEM_MNT" || return 1
    mount -t btrfs -o ro,rescue=nologreplay "$SYSTEM_DEV" "$SYSTEM_MNT" || return 1
    MOUNTED_HERE=$SYSTEM_MNT
    SYS_DIR=$SYSTEM_MNT
}

# hibernated: yes / no / unknown, without mounting userdata
hibernated() {
    if is_mounted "$USERDATA_MNT"; then
        _f="$USERDATA_MNT/$SWAPFILE"
        [ -e "$_f" ] || { echo no; return; }
        _s=$(gs_sig_file "$_f")
    elif [ -n "$USERDATA_DEV" ] && [ -e "$USERDATA_DEV" ]; then
        # debugfs exits 0 for a missing file too: look for the inode line
        debugfs -R "stat /$SWAPFILE" "$USERDATA_DEV" 2>/dev/null | grep -q '^Inode:' || { echo no; return; }
        _b=$(gs_dev_block "$USERDATA_DEV" "$SWAPFILE") || { echo unknown; return; }
        _s=$(gs_sig_dev "$USERDATA_DEV" "$_b")
    else
        echo unknown; return
    fi
    [ "$_s" = "$GS_SIG_HIBERNATE" ] && echo yes || echo no
}

# Userdata is read through its mount when it is mounted, else with debugfs on
# the device (no mount, no journal replay; may miss the newest writes of an
# unclean shutdown, which is fine for reading the list).
ud_mounted() { is_mounted "$USERDATA_MNT"; }

# mounted_at DEV: where DEV is mounted already (any path, e.g. a recovery's
# /data), or empty; compares the resolved device nodes
mounted_at() {
    _rd=$(readlink -f "$1" 2>/dev/null) || return 0
    while read -r _src _mp _rest; do
        case "$_src" in /*) ;; *) continue ;; esac
        [ "$(readlink -f "$_src" 2>/dev/null)" = "$_rd" ] && { printf '%b\n' "$_mp"; return 0; }
    done < "${GLASSINE_DEPLOY_MOUNTS:-/proc/mounts}"
}

# userdata mounted somewhere else than USERDATA_MNT: use that mount. Never
# the raw device under a mounted file system (glassine-state.sh).
if [ -z "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ] && [ -n "$USERDATA_DEV" ] && ! is_mounted "$USERDATA_MNT"; then
    _m=$(mounted_at "$USERDATA_DEV")
    [ -n "$_m" ] && USERDATA_MNT=$_m
fi
ud_dev() { [ -n "$USERDATA_DEV" ] && [ -e "$USERDATA_DEV" ]; }

# ud_dirs REL: the subdirectories of <prefix>/REL
ud_dirs() {
    if ud_mounted; then
        for _d in "$USERDATA_MNT/$USERDATA_PREFIX/$1"/*; do
            [ -d "$_d" ] && echo "${_d##*/}"
        done
    elif ud_dev; then
        # ls -p: /inode/mode/uid/gid/name/size/
        debugfs -R "ls -p /$USERDATA_PREFIX/$1" "$USERDATA_DEV" 2>/dev/null |
            awk -F/ 'NF > 6 && $3 ~ /^0*4/ && $6 != "." && $6 != ".." { print $6 }'
    fi
}

# ud_cat REL: the contents of <prefix>/REL (empty if missing)
ud_cat() {
    if ud_mounted; then
        cat "$USERDATA_MNT/$USERDATA_PREFIX/$1" 2>/dev/null
    elif ud_dev; then
        debugfs -R "cat /$USERDATA_PREFIX/$1" "$USERDATA_DEV" 2>/dev/null
    fi
    return 0
}

# twrp_keep_rel: the keep marker of the prefix's top-level media directory,
# relative to userdata (empty when the prefix is not under media/)
twrp_keep_rel() {
    case $USERDATA_PREFIX in
        media/?*) _t=${USERDATA_PREFIX#media/}; echo "media/${_t%%/*}/.twrp-keep" ;;
    esac
}

# ud_size_kib REL: disk use of <prefix>/REL; empty while userdata is not mounted
ud_size_kib() {
    ud_mounted || return 0
    du -sk "$USERDATA_MNT/$USERDATA_PREFIX/$1" 2>/dev/null | cut -f 1
}

# invalidate: rule 5 on the swap file, the same way hibernated() reads it
invalidate() {
    if ud_mounted; then
        [ -e "$USERDATA_MNT/$SWAPFILE" ] || return 0
        gs_invalidate_file "$USERDATA_MNT/$SWAPFILE"
    else
        _b=$(gs_dev_block "$USERDATA_DEV" "$SWAPFILE") || return 1
        gs_invalidate_dev "$USERDATA_DEV" "$_b"
    fi
}

# confirm QUESTION: --yes, or a "y" on a terminal; anything else cancels
confirm() {
    [ "$YES" = 1 ] && return 0
    [ -t 0 ] || die "$1: rerun with --yes"
    printf '%s [y/N] ' "$1" >&2
    read -r _a || _a=''
    case "$_a" in y|Y|yes) return 0 ;; esac
    die cancelled
}

# format_check: refuse (exit 3) a state format newer than this tool; sets FMT
format_check() {
    FMT=none
    [ -n "$SYS_DIR" ] && FMT=$(gs_format_version "$SYS_DIR")
    [ "$FMT" = none ] || gs_format_ok "$FMT" ||
        fail 3 "state format $FMT is newer than this tool ($GS_FORMAT_SUPPORTED); update glassine-deploy"
}

# hibernation_gate: rule 8, before anything mounts the system partition
# read-write. Refuses (exit 4) unless --discard-hibernation, then invalidates.
hibernation_gate() {
    case $(hibernated) in
    no) return 0 ;;
    yes)
        [ "$DISCARD" = 1 ] || fail 4 "userdata holds a hibernated session; rerun with --discard-hibernation (the session is lost)"
        confirm "Discard the hibernated session?"
        invalidate || die "cannot invalidate the hibernate image"
        [ "$(hibernated)" = no ] || die "the hibernate image is still there"
        ;;
    *)
        [ "$DISCARD" = 1 ] || fail 4 "cannot tell whether userdata holds a hibernated session; rerun with --discard-hibernation"
        ;;
    esac
}

# state_open_rw: the system partition read-write, its state locked. Sets S.
state_open_rw() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    [ "$FMT" = none ] && die "the system partition is not migrated (no state/)"
    cleanup
    hibernation_gate
    if ! is_mounted "$SYSTEM_MNT"; then
        mkdir -p "$SYSTEM_MNT" || die "cannot create $SYSTEM_MNT"
        mount -t btrfs -o rw "$SYSTEM_DEV" "$SYSTEM_MNT" || die "cannot mount $SYSTEM_DEV read-write"
        MOUNTED_HERE=$SYSTEM_MNT
    fi
    S="$SYSTEM_MNT/state"
    : >>"$S/.lock" 2>/dev/null || die "$S is not writable"
    gs_lock "$S" || fail 6 "busy: another glassine-deploy (or a switch) holds $S/.lock"
    # a switch holds the lock while its marker exists; with the lock ours, a
    # marker is a killed switch's (its layer is redone by the next switch)
    if [ -e "$RUN_DIR/switching" ]; then
        echo "glassine-deploy: removing a stale $RUN_DIR/switching (an interrupted switch)" >&2
        rm -f "$RUN_DIR/switching"
    fi
}

# meta_kv META KEY: one key of a deployment's meta (key=value text)
meta_kv() { printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n 1; }

# out KEY VALUE…: collect the fields of one record
REC=''
out() { REC="$REC$1=$2	"; }

emit() {
    if [ "$PORC" = 1 ]; then
        printf '%s\n' "${REC%	}"
    else
        printf '%s\n' "${REC%	}" | tr '\t' '\n' | sed -n 's/^type=.*//;t;s/=/: /p'
    fi
    REC=''
}

cmd_status() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    rc=0
    fmt=none
    [ -n "$SYS_DIR" ] && fmt=$(gs_format_version "$SYS_DIR")
    out type status
    out format "$fmt"
    out supported "$GS_FORMAT_SUPPORTED"
    out system_fs "${SYS_FS:-unknown}"
    if [ "$fmt" = none ]; then
        out migrated no
    elif gs_format_ok "$fmt"; then
        out migrated yes
        S="$SYS_DIR/state"
        out current "$(gs_kv "$S/deploy" current)"
        out previous "$(gs_kv "$S/deploy" previous)"
        out candidate "$(gs_kv "$S/deploy" candidate)"
        out staged "$(gs_kv "$S/deploy" staged)"
        out failed "$(gs_kv "$S/deploy" failed)"
        out tries "$(gs_kv "$S/deploy" tries)"
        out kernel_current "$(gs_kv "$S/kernel" current)"
        out kernel_previous "$(gs_kv "$S/kernel" previous)"
    else
        out migrated yes
        rc=3
    fi
    out hibernated "$(hibernated)"
    out userdata_prefix "$USERDATA_PREFIX"
    _k=$(twrp_keep_rel); _kv=''
    if [ -n "$_k" ] && ud_mounted; then
        if [ -e "$USERDATA_MNT/$_k" ]; then _kv=yes; else _kv=no; fi
    fi
    out twrp_keep "$_kv"
    out swapfile "$SWAPFILE"
    out guard "$GUARD"
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    emit
    [ $rc = 3 ] && echo "glassine-deploy: state format $fmt is newer than this tool ($GS_FORMAT_SUPPORTED); update glassine-deploy" >&2
    return $rc
}

cmd_list() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    cur='' prev='' cand='' failed='' staged=''
    if [ "$FMT" != none ]; then
        cur=$(gs_kv "$SYS_DIR/state/deploy" current)
        prev=$(gs_kv "$SYS_DIR/state/deploy" previous)
        cand=$(gs_kv "$SYS_DIR/state/deploy" candidate)
        failed=$(gs_kv "$SYS_DIR/state/deploy" failed)
        staged=$(gs_kv "$SYS_DIR/state/deploy" staged)
    fi
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    [ "$PORC" = 1 ] || printf '%-24s %-10s %-20s %-16s %-20s %s\n' ID STATE BASE KERNEL CREATED KIB
    for id in $(ud_dirs deployments); do
        m=$(ud_cat "deployments/$id/meta")
        if [ "$id" = "$cur" ]; then st=current
        elif [ "$id" = "$cand" ]; then st=candidate
        elif [ "$id" = "$staged" ]; then st=staged
        elif [ "$(meta_kv "$m" failed)" = 1 ] || [ "$id" = "$failed" ]; then st=failed
        elif [ "$id" = "$prev" ]; then st=previous
        else st=kept
        fi
        if [ "$PORC" = 1 ]; then
            out type deployment; out id "$id"; out state "$st"
            b=$(meta_kv "$m" base) bp=''
            # base_present: is the deployment's base on this system partition
            if [ -n "$b" ] && [ -n "$SYS_DIR" ]; then bp=no; [ -d "$SYS_DIR/bases/$b" ] && bp=yes; fi
            out base "$b"; out base_present "$bp"; out kernel "$(meta_kv "$m" kernel)"
            out created "$(meta_kv "$m" created)"; out size_kib "$(ud_size_kib "deployments/$id")"
            emit
        else
            printf '%-24s %-10s %-20s %-16s %-20s %s\n' "$id" "$st" "$(meta_kv "$m" base)" \
                "$(meta_kv "$m" kernel)" "$(meta_kv "$m" created)" "$(ud_size_kib "deployments/$id")"
        fi
    done
}

# require_migrated: dies unless the system partition holds state/ (read-only look)
require_migrated() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    [ "$FMT" = none ] && die "the system partition is not migrated (no state/)"
}

# do_select ID: ID becomes the candidate (2 tries); the current one cancels it
do_select() {
    case "$1" in ''|.*|*[!A-Za-z0-9._-]*) fail 2 "not a deployment id: $1" ;; esac
    require_migrated
    cleanup
    ud_dirs deployments | grep -qx -- "$1" || die "no deployment $1 on userdata"
    state_open_rw
    cur=$(gs_kv "$S/deploy" current)
    _b=$(meta_kv "$(ud_cat "deployments/$1/meta")" base)
    [ -z "$_b" ] || [ -d "$SYSTEM_MNT/bases/$_b" ] || die "deployment $1 cannot boot: its base $_b is not on the system partition"
    if [ "$1" = "$cur" ]; then
        gs_update "$S/deploy" candidate= tries=0 || die "cannot write $S/deploy"
        echo "glassine-deploy: $1 is the current deployment; no candidate"
    else
        gs_update "$S/deploy" "candidate=$1" tries=2 || die "cannot write $S/deploy"
        echo "glassine-deploy: $1 boots next (2 tries, then ${cur:-the current one} again)"
    fi
}

cmd_select() { do_select "$ARG"; }

cmd_rollback() {
    require_migrated
    prev=$(gs_kv "$SYS_DIR/state/deploy" previous)
    cleanup
    [ -n "$prev" ] || die "there is no previous deployment"
    do_select "$prev"
}

cmd_hibernate_invalidate() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    cleanup
    case $(hibernated) in
    no) echo "glassine-deploy: no hibernate image"; return 0 ;;
    unknown) die "cannot read the swap file on userdata" ;;
    esac
    confirm "Discard the hibernated session?"
    invalidate || die "cannot invalidate the hibernate image"
    [ "$(hibernated)" = no ] || die "the hibernate image is still there"
    echo "glassine-deploy: hibernate image invalidated"
}

# ud_open_rw: userdata mounted read-write at USERDATA_MNT (after the
# hibernation gate: this mount ends any hibernated session, rule 4); sets UD
ud_open_rw() {
    if ! ud_mounted; then
        ud_dev || die "no userdata ($USERDATA_DEV)"
        # booted by the deployments initramfs: userdata is the live upper (the
        # overlay holds it even where nothing shows it mounted, as at shutdown
        # after OpenRC's unmounts): never a fsck of a file system in use
        if [ ! -e "$RUN_DIR/booted" ]; then
            e2fsck -p "$USERDATA_DEV" >/dev/null 2>&1
            [ $? -lt 4 ] || die "e2fsck found errors on $USERDATA_DEV it cannot fix; run it by hand"
        fi
        mkdir -p "$USERDATA_MNT" || die "cannot create $USERDATA_MNT"
        mount -t ext4 "$USERDATA_DEV" "$USERDATA_MNT" || die "cannot mount $USERDATA_DEV"
        UD_MOUNTED_HERE=$USERDATA_MNT
    fi
    UD=$USERDATA_MNT/$USERDATA_PREFIX
    # the recovery's "wipe internal storage" skips a top-level media directory
    # that holds this marker (a TWRP that honours it): put it there
    _k=$(twrp_keep_rel)
    if [ -n "$_k" ] && [ ! -e "$USERDATA_MNT/$_k" ]; then
        mkdir -p "$USERDATA_MNT/${_k%/*}" && : > "$USERDATA_MNT/$_k" ||
            echo "glassine-deploy: cannot create $_k" >&2
    fi
}

# new_id: a fresh deployment id (UTC time, a suffix if taken). Ids are names,
# never an order: state/deploy says which is current, previous, candidate,
# and a recovery whose clock is unset (1970) makes 1970 ids, which is fine.
new_id() {
    _i=$(date -u +%Y%m%d-%H%M%S); _n=$_i _k=1
    while [ -e "$UD/deployments/$_n" ]; do _k=$((_k + 1)); _n=$_i-$_k; done
    echo "$_n"
}

# copy_path VIEW DEST PATH: PATH (absolute) from VIEW into DEST, with its
# parent directories' owner and mode
copy_path() {
    _p=${3%/}; _p=${_p#/}
    [ -e "$1/$_p" ] || [ -L "$1/$_p" ] || return 0
    _par=${_p%/*}; [ "$_par" = "$_p" ] && _par=''
    _acc=''
    for _c in $(echo "$_par" | tr '/' ' '); do
        _acc=$_acc/$_c
        [ -d "$2$_acc" ] && continue
        mkdir "$2$_acc" || return 1
        chown "$(stat -c %u:%g "$1$_acc")" "$2$_acc" && chmod "$(stat -c %a "$1$_acc")" "$2$_acc" || return 1
    done
    cp -a "$1/$_p" "$2/$_par/" || return 1
}

# migrate_paths VIEW: the migrate list of a deployment (comments, blank lines
# and relative paths dropped)
migrate_paths() {
    cat "$1/usr/share/glassine/migrate.list" "$1"/etc/glassine/migrate.d/*.list 2>/dev/null |
        sed 's/#.*//; s/[[:space:]]*$//' | grep '^/' | grep -v '\.\.' | sort -u
}

cmd_reset() {
    state_open_rw
    cur=$(gs_kv "$S/deploy" current)
    [ -n "$cur" ] || die "no current deployment to reset"
    ud_open_rw
    base=$(gs_kv "$UD/deployments/$cur/meta" base)
    [ -n "$base" ] && [ -d "$SYSTEM_MNT/bases/$base" ] || die "deployment $cur: base ${base:-?} is missing"
    when="at the next shutdown"; [ "$NOW" = 1 ] && when=now
    if [ "$FULL" = 1 ]; then
        confirm "Full reset: a new deployment on base $base with nothing carried over (accounts, Wi-Fi, Bluetooth, settings, packages; home stays), prepared $when?"
    else
        confirm "Reset system: a new deployment on base $base that keeps only the migrate list (accounts, Wi-Fi, Bluetooth, settings; your packages and edits go), prepared $when?"
    fi
    kind=reset carry=migrate; [ "$FULL" = 1 ] && kind=reset-full carry=none
    stage_new
}

# valid_name NAME: a deployment, base or modules name ([A-Za-z0-9._-], no
# leading dot)
valid_name() { case "$1" in ''|.*|*[!A-Za-z0-9._-]*) return 1 ;; esac; }

cmd_stage() {
    valid_name "$ARG" || fail 2 "not a base name: $ARG"
    [ "$FULL" = 0 ] || fail 2 "stage carries the migrate list; --full is reset's"
    state_open_rw
    cur=$(gs_kv "$S/deploy" current)
    [ -n "$cur" ] || die "no current deployment to carry from"
    [ -d "$SYSTEM_MNT/bases/$ARG" ] || die "no base $ARG on the system partition (receive it first)"
    [ -r "$SYSTEM_MNT/bases/$ARG/etc/passwd" ] || die "base $ARG has no /etc/passwd"
    ud_open_rw
    base=$ARG
    when="at the next shutdown"; [ "$NOW" = 1 ] && when=now
    confirm "Update: a new deployment on base $base that keeps the migrate list and your accounts (Wi-Fi, Bluetooth, settings; your packages and edits go), prepared $when?"
    kind=update carry=migrate
    stage_new
}

# replay_apk ARGS: apk from the new base, in its chroot; the state lock stays out
replay_apk() {
    chroot "$REPLAY_MNT" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
        /sbin/apk --no-progress --cache-dir /var/cache/apk "$@" 9>&-
}

# do_replay: the user's package changes on the running deployment, against its
# base, applied to the new deployment's build layer on $base. Needs state_open_rw
# + UD, cur, NEW_DEP. Sets nothing; dies or fails 7, which removes NEW_DEP.
do_replay() {
    [ "$NOREPLAY" = 1 ] && { echo "glassine-deploy: no replay: your packages stay out of this deployment"; return 0; }
    vapk=${GLASSINE_DEPLOY_APK:-/sbin/apk}
    [ -x "$vapk" ] || die "the replay needs apk ($vapk); --no-replay stages without your packages"
    t=${TMPDIR:-/tmp}/glassine-replay.$$
    mkdir -p "$t" || die "cannot create $t"
    REPLAY_TMP=$t
    ob=$(gs_kv "$UD/deployments/$cur/meta" base)
    [ -n "$ob" ] && [ -d "$SYSTEM_MNT/bases/$ob" ] || die "deployment $cur: base ${ob:-?} is missing"
    obd=$SYSTEM_MNT/bases/$ob nbd=$SYSTEM_MNT/bases/$base
    if [ "$(cat "$RUN_DIR/booted" 2>/dev/null)" = "$cur" ]; then
        # no leading //: busybox mount reads //var/cache/apk as a network share
        view=${GLASSINE_DEPLOY_ROOT:-/}; view=${view%/}
    else
        TMP_VIEW=$RUN_DIR/view.$$
        gr_merged_ro "$SYSTEM_MNT" "$UD/deployments/$cur" "$TMP_VIEW" || die "cannot open deployment $cur read-only"
        view=$TMP_VIEW
    fi
    pkg_world "$obd/etc/apk/world" > "$t/ow"; pkg_world "$view/etc/apk/world" > "$t/vw"; pkg_world "$nbd/etc/apk/world" > "$t/nw"
    pkg_db "$obd/lib/apk/db/installed" > "$t/oi" 2>/dev/null; pkg_db "$view/lib/apk/db/installed" > "$t/vi" 2>/dev/null
    pkg_db "$nbd/lib/apk/db/installed" > "$t/ni" 2>/dev/null
    # added and removed against the old base, as far as the new one differs
    awk 'FILENAME == ARGV[1] { o[$0] = 1; next } FILENAME == ARGV[2] { n[$0] = 1; next } !($0 in o) && !($0 in n)' "$t/ow" "$t/nw" "$t/vw" > "$t/add0"
    : > "$t/add"
    while read -r e; do
        _n=$(echo "$e" | sed 's/[<>=~@].*//')
        case " $WITHOUT " in *" $_n "*) echo "glassine-deploy: leaving out $e" ;; *) echo "$e" >> "$t/add" ;; esac
    done < "$t/add0"
    awk 'FILENAME == ARGV[1] { v[$0] = 1; next } FILENAME == ARGV[2] { n[$0] = 1; next } !($0 in v) && ($0 in n)' "$t/vw" "$t/nw" "$t/ow" > "$t/del"
    # raised: above the old base and still above the new one (a base that caught up takes over)
    : > "$t/up"
    awk 'FILENAME == ARGV[1] { o[$1] = $2; next } FILENAME == ARGV[2] { n[$1] = $2; next } ($1 in o) && ($1 in n) && o[$1] != $2 { print $1, $2, o[$1], n[$1] }' "$t/oi" "$t/ni" "$t/vi" |
    while read -r n v bv nv; do
        [ "$("$vapk" version -t "$v" "$bv" 2>/dev/null)" = '>' ] || continue
        [ "$("$vapk" version -t "$v" "$nv" 2>/dev/null)" = '>' ] && echo "$n" >> "$t/up"
    done
    # repositories the user added (a line the old base does not have); never the old
    # branch's own, which a base on a new branch replaces
    : > "$t/repos"
    if [ -r "$view/etc/apk/repositories" ]; then
        while IFS= read -r l; do
            [ -n "$l" ] || continue
            grep -qxF -- "$l" "$obd/etc/apk/repositories" 2>/dev/null && continue
            grep -qxF -- "$l" "$nbd/etc/apk/repositories" 2>/dev/null && continue
            echo "$l" >> "$t/repos"
        done < "$view/etc/apk/repositories"
    fi
    cp "$t/ni" "$t/ri"
    if [ -s "$t/add" ] || [ -s "$t/del" ] || [ -s "$t/up" ]; then
        echo "glassine-deploy: replaying your packages on base $base: add $(tr '\n' ' ' < "$t/add"); remove $(tr '\n' ' ' < "$t/del"); upgrade $(tr '\n' ' ' < "$t/up")"
        [ -x "$nbd/sbin/apk" ] && [ -x "$nbd/usr/bin/env" ] || die "base $base has no apk to replay with; --no-replay stages without your packages"
        M=$RUN_DIR/replay.$$
        gr_mount_overlay "$M" "$nbd" "$NEW_DEP/build" "$NEW_DEP/work" || die "cannot assemble the new deployment at $M"
        REPLAY_MNT=$M
        cat "$t/repos" >> "$M/etc/apk/repositories" || die "cannot write the repositories"
        for k in "$view"/etc/apk/keys/*; do
            [ -e "$k" ] && [ ! -e "$M/etc/apk/keys/${k##*/}" ] && cp -p "$k" "$M/etc/apk/keys/"
        done
        # the API file systems and the package cache; an empty /run: nothing starts
        mkdir -p "$M/var/cache/apk" "$M/run" "$M/tmp" "$M/proc" "$M/sys" "$M/dev"
        mount --bind /dev "$M/dev" && REPLAY_BINDS="/dev $REPLAY_BINDS" || die "cannot bind /dev"
        mount -t proc proc "$M/proc" && REPLAY_BINDS="/proc $REPLAY_BINDS" || die "cannot mount /proc"
        mount -t tmpfs tmpfs "$M/run" && REPLAY_BINDS="/run $REPLAY_BINDS" || die "cannot mount /run"
        mount -t tmpfs tmpfs "$M/tmp" && REPLAY_BINDS="/tmp $REPLAY_BINDS" || die "cannot mount /tmp"
        if [ -d "$view/var/cache/apk" ]; then
            mount --bind "$view/var/cache/apk" "$M/var/cache/apk" && REPLAY_BINDS="/var/cache/apk $REPLAY_BINDS" || die "cannot bind the package cache"
        fi
        if [ -e /etc/resolv.conf ] && [ ! -L "$M/etc/resolv.conf" ]; then
            [ -e "$M/etc/resolv.conf" ] || { : > "$M/etc/resolv.conf" && REPLAY_RESOLV=1; }
            mount --bind /etc/resolv.conf "$M/etc/resolv.conf" && REPLAY_BINDS="/etc/resolv.conf $REPLAY_BINDS" || die "cannot bind resolv.conf"
        fi
        replay_apk update || echo "glassine-deploy: no fresh package lists, going on with the cached ones"
        # shellcheck disable=SC2046  # one package per word
        [ ! -s "$t/del" ] || replay_apk del $(cat "$t/del") ||
            fail 7 "removing your removed packages failed; nothing staged. --no-replay stages the bare base"
        # shellcheck disable=SC2046
        [ ! -s "$t/add" ] || replay_apk add $(cat "$t/add") ||
            fail 7 "your added packages do not install on base $base; nothing staged. --without NAME leaves one out, --no-replay stages the bare base"
        # shellcheck disable=SC2046
        [ ! -s "$t/up" ] || replay_apk upgrade $(cat "$t/up") ||
            fail 7 "your upgraded packages do not upgrade on base $base; nothing staged. --no-replay stages the bare base"
        pkg_db "$M/lib/apk/db/installed" > "$t/ri"
        replay_umount
    fi
    # no silent downgrade: every package the running deployment has, against the new one
    down=''
    while read -r n v nv; do
        [ "$("$vapk" version -t "$v" "$nv" 2>/dev/null)" = '>' ] || continue
        echo "glassine-deploy: goes down: $n $v -> $nv"
        down=1
    done <<EOF
$(awk 'FILENAME == ARGV[1] { r[$1] = $2; next } ($1 in r) && r[$1] != $2 { print $1, $2, r[$1] }' "$t/ri" "$t/vi")
EOF
    if [ -n "$down" ] && [ "$ACCEPT_DOWN" != 1 ]; then
        fail 7 "these packages would go down in version; nothing staged. --accept-downgrades takes them, or stay on this base until a newer one"
    fi
    if [ -n "$TMP_VIEW" ]; then umount "$TMP_VIEW" && rmdir "$TMP_VIEW"; TMP_VIEW=''; fi
    rm -rf "$t"; REPLAY_TMP=''
}

# stage_new: a new deployment on $base (kind, carry set) becomes the staged one;
# --now switches at once. Needs state_open_rw + UD, cur.
stage_new() {
    id=$(new_id)
    NEW_DEP=$UD/deployments/$id
    mkdir -p "$NEW_DEP/build" "$NEW_DEP/switch" "$NEW_DEP/work" || die "cannot create $NEW_DEP"
    printf 'base=%s\nkind=%s\ncarry=%s\nfrom=%s\ncreated=%s\n' "$base" "$kind" "$carry" "$cur" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" |
        gs_write "$NEW_DEP/meta" || die "cannot write $NEW_DEP/meta"
    [ "$kind" = update ] && do_replay
    sync
    old=$(gs_kv "$S/deploy" staged)
    gs_update "$S/deploy" "staged=$id" || die "cannot write $S/deploy"
    NEW_DEP=''
    [ -n "$old" ] && [ "$old" != "$id" ] && rm -rf "$UD/deployments/$old"
    if [ "$NOW" = 1 ]; then
        do_switch
    else
        echo "glassine-deploy: $id ($kind of $cur, base $base) is staged; the next shutdown carries the settings over and selects it"
    fi
}

# do_switch: the staged deployment gets a fresh switch layer with what its
# meta carry= says, then becomes the candidate. Needs state_open_rw + UD.
do_switch() {
    id=$(gs_kv "$S/deploy" staged)
    [ -n "$id" ] || { echo "glassine-deploy: nothing staged"; return 0; }
    nd=$UD/deployments/$id
    [ -r "$nd/meta" ] || die "staged deployment $id is missing on userdata"
    cur=$(gs_kv "$S/deploy" current)
    mkdir -p "$RUN_DIR" && : > "$RUN_DIR/switching" || die "cannot create $RUN_DIR/switching"
    SWITCHING=$RUN_DIR/switching
    # always from scratch: an interrupted switch left an unknown part behind
    rm -rf "$nd/switch" "$nd/work" && mkdir -p "$nd/switch" "$nd/work" || die "cannot clear $nd/switch"
    case "$(gs_kv "$nd/meta" carry)" in
    none) ;;
    migrate)
        [ -n "$cur" ] || die "no current deployment to carry from"
        # the running deployment (the shutdown hook): a plain bind of its own
        # root (the merged overlay without what is mounted on top; a second
        # overlay on a live upper is undefined in overlayfs, and OpenRC has
        # unmounted RUN_DIR/root by then); otherwise (recovery) a read-only view
        TMP_VIEW=$RUN_DIR/view.$$
        mkdir -p "$TMP_VIEW" || die "cannot create $TMP_VIEW"
        if [ "$(cat "$RUN_DIR/booted" 2>/dev/null)" = "$cur" ]; then
            mount --bind "${GLASSINE_DEPLOY_ROOT:-/}" "$TMP_VIEW" && mount -o remount,bind,ro "$TMP_VIEW" ||
                die "cannot bind the running root"
        else
            gr_merged_ro "$SYSTEM_MNT" "$UD/deployments/$cur" "$TMP_VIEW" || die "cannot open deployment $cur read-only"
        fi
        view=$TMP_VIEW
        need=1024
        for p in $(migrate_paths "$view"); do
            [ -e "$view$p" ] && need=$((need + $(du -sk "$view$p" | cut -f 1)))
        done
        avail=$(df -Pk "$USERDATA_MNT" | awk 'NR == 2 { print $4 }')
        [ "${avail:-0}" -gt "$need" ] || fail 5 "not enough space on userdata: ${need} KiB needed, ${avail:-?} KiB free; $id stays staged"
        for p in $(migrate_paths "$view"); do
            copy_path "$view" "$nd/switch" "$p" || die "copying $p failed; $id stays staged"
        done
        # the accounts: the new deployment's lower /etc (its build layer over
        # its base) merged with the old one's; carried files follow moved IDs
        nb=$(gs_kv "$nd/meta" base)
        ne=$SYSTEM_MNT/bases/$nb/etc; [ -r "$nd/build/etc/passwd" ] && ne=$nd/build/etc
        [ -n "$nb" ] && [ -r "$ne/passwd" ] || die "deployment $id: base ${nb:-?} has no /etc/passwd; $id stays staged"
        [ -d "$nd/switch/etc" ] || { mkdir "$nd/switch/etc" && chown "$(stat -c %u:%g "$view/etc")" "$nd/switch/etc" &&
            chmod "$(stat -c %a "$view/etc")" "$nd/switch/etc"; } || die "cannot create $nd/switch/etc"
        echo "glassine-deploy: accounts (base $nb + $cur's users)"
        ga_merge "$view/etc" "$ne" "$nd/switch/etc" "$nd/idmap" || die "the account merge failed; $id stays staged"
        ga_remap "$nd/idmap" "$nd/switch" || die "the owner remap failed; $id stays staged"
        rm -f "$nd/idmap"
        umount "$TMP_VIEW" && rmdir "$TMP_VIEW"; TMP_VIEW=''
        ;;
    *) die "deployment $id: unknown carry=$(gs_kv "$nd/meta" carry)" ;;
    esac
    sync
    gs_update "$S/deploy" staged= "candidate=$id" tries=2 || die "cannot write $S/deploy"
    rm -f "$SWITCHING"; SWITCHING=''
    echo "glassine-deploy: $id boots next (2 tries, then ${cur:-the current one} again)"
}

# switch: the shutdown hook's step (after services stop; the hook decides
# whether this shutdown may switch: started by the user, on the charger or
# with enough battery; docs/deployments.md)
cmd_switch() {
    state_open_rw
    [ -n "$(gs_kv "$S/deploy" staged)" ] || { echo "glassine-deploy: nothing staged"; return 0; }
    ud_open_rw
    do_switch
}

# subvol_received DIR: DIR is a read-only subvolume with a received UUID
subvol_received() {
    [ "$(btrfs property get -ts "$1" ro 2>/dev/null)" = ro=true ] || return 1
    btrfs subvolume show "$1" 2>/dev/null | grep -q 'Received UUID:[[:space:]]*[0-9a-f]'
}

cmd_receive() {
    command -v btrfs >/dev/null || die "receive needs btrfs (btrfs-progs)"
    sub=bases; [ "$MODULES" = 1 ] && sub=modules
    if [ "$ARG" != - ]; then
        [ -r "$ARG" ] || die "cannot read $ARG"
        if [ -n "$SHA" ]; then
            have=$(sha256sum "$ARG" | cut -d ' ' -f 1)
            [ "$have" = "$SHA" ] || die "$ARG: sha256 $have, expected $SHA"
        fi
        case "$ARG" in *.zst) command -v zstd >/dev/null || die "a .zst stream needs zstd" ;; esac
    else
        [ -z "$SHA" ] || fail 2 "--sha256 needs a file, not -"
    fi
    state_open_rw
    # straight into bases/ (modules/): a read-only subvolume cannot be renamed
    # (and clearing ro would drop its received UUID); a stream for a name that
    # exists fails in btrfs receive itself
    d=$SYSTEM_MNT/$sub
    mkdir -p "$d" || die "cannot create $d"
    RECV_BEFORE=$(for n in "$d"/*; do [ -e "$n" ] && echo "${n##*/}"; done)
    RECV_TMP=$d
    case "$ARG" in
    -) btrfs -q receive "$d" ;;
    *.zst) zstd -dcq "$ARG" | btrfs -q receive "$d" ;;
    *) btrfs -q receive -f "$ARG" "$d" ;;
    esac || die "btrfs receive failed (a name that exists already, a cut stream or a missing parent); nothing kept"
    new=''
    for n in "$d"/*; do
        [ -e "$n" ] || continue
        printf '%s\n' "$RECV_BEFORE" | grep -qxF -- "${n##*/}" || new="$new ${n##*/}"
    done
    # shellcheck disable=SC2086  # a name with a space fails valid_name below
    set -- $new
    [ $# = 1 ] || die "the stream held $# subvolumes, expected one; nothing kept"
    name=$1
    valid_name "$name" || die "received subvolume name '$name' is not valid; nothing kept"
    subvol_received "$d/$name" || die "$name is not read-only with a received UUID; nothing kept"
    sync
    RECV_TMP=''
    echo "glassine-deploy: received $sub/$name"
}

cmd_bases() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    [ "$FMT" = none ] && die "the system partition is not migrated (no state/)"
    # base -> deployments using it, from the metas on userdata
    users=''
    for id in $(ud_dirs deployments); do
        b=$(meta_kv "$(ud_cat "deployments/$id/meta")" base)
        [ -n "$b" ] && users="$users$b $id
"
    done
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    [ "$PORC" = 1 ] || printf '%-8s %-40s %s\n' KIND NAME USED_BY
    for k in bases modules; do
        for d in "$SYS_DIR/$k"/*; do
            [ -d "$d" ] || continue
            n=${d##*/}; u=''
            [ $k = bases ] && u=$(printf '%s' "$users" | awk -v b="$n" '$1 == b { printf "%s%s", s, $2; s = "," }')
            if [ "$PORC" = 1 ]; then
                out type base; out kind "${k%s}"; out name "$n"; out used_by "$u"; emit
            else
                printf '%-8s %-40s %s\n' "${k%s}" "$n" "$u"
            fi
        done
    done
}

# pkg_db FILE: "name version" per package of an apk installed database
cmd_bases_remove() {
    [ "$FIRST" = remove ] || usage
    valid_name "$ARG" || fail 2 "not a base name: $ARG"
    state_open_rw
    d=$SYSTEM_MNT/bases/$ARG
    [ -d "$d" ] || die "no base $ARG on the system partition"
    # who needs it, from the metas on userdata; unreadable metas must not read
    # as "nobody": the current deployment has to be there, with its base
    cur=$(gs_kv "$S/deploy" current)
    curb=$(meta_kv "$(ud_cat "deployments/$cur/meta" 2>/dev/null)" base)
    [ -n "$curb" ] || die "cannot read the deployments on userdata; nothing removed"
    needed=" $cur $(gs_kv "$S/deploy" candidate) $(gs_kv "$S/deploy" staged) $(cat "$RUN_DIR/booted" 2>/dev/null) "
    lose=''
    for id in $(ud_dirs deployments); do
        [ "$(meta_kv "$(ud_cat "deployments/$id/meta")" base)" = "$ARG" ] || continue
        case "$needed" in *" $id "*) die "base $ARG is in use by deployment $id; nothing removed" ;; esac
        lose="$lose $id"
    done
    if [ -n "$lose" ]; then
        prev=$(gs_kv "$S/deploy" previous)
        note=''
        case " $lose " in *" $prev "*) note=" Rollback to $prev is lost." ;; esac
        confirm "Remove base $ARG? Deployments that can no longer boot:$lose.$note"
    fi
    btrfs -q subvolume delete --commit-after "$d" >/dev/null || die "cannot delete $d"
    # the space comes back once the cleaner has dropped the subvolume
    btrfs -q subvolume sync "$SYSTEM_MNT" >/dev/null 2>&1 || :
    echo "glassine-deploy: base $ARG removed"
}

pkg_db() { awk -F: '$1 == "P" { p = $2 } $1 == "V" && p != "" { print p " " $2; p = "" }' "$1" 2>/dev/null | sort; }
# pkg_world FILE: the world entries, one per line, sorted
pkg_world() { tr ' ' '\n' < "$1" 2>/dev/null | sed '/^$/d' | sort -u; }

cmd_packages() {
    require_migrated
    id=$ARG; [ -n "$id" ] || id=$(gs_kv "$SYS_DIR/state/deploy" current)
    valid_name "$id" || fail 2 "not a deployment id: $id"
    base=$(meta_kv "$(ud_cat "deployments/$id/meta")" base)
    [ -n "$base" ] || die "no deployment $id on userdata (or its meta names no base)"
    bd=$SYS_DIR/bases/$base
    [ -d "$bd" ] || die "deployment $id: base $base is missing"
    # the deployment's merged root: the running one itself, else a read-only view
    if [ "$(cat "$RUN_DIR/booted" 2>/dev/null)" = "$id" ]; then
        view=${GLASSINE_DEPLOY_ROOT:-/}
    else
        ud_mounted || die "userdata is not mounted; packages of a deployment that is not running need it mounted"
        TMP_VIEW=$RUN_DIR/view.$$
        mkdir -p "$TMP_VIEW" && gr_merged_ro "$SYS_DIR" "$USERDATA_MNT/$USERDATA_PREFIX/deployments/$id" "$TMP_VIEW" ||
            die "cannot open deployment $id read-only"
        view=$TMP_VIEW
    fi
    t=${TMPDIR:-/tmp}/glassine-pkg.$$
    mkdir -p "$t" || die "cannot create $t"
    pkg_world "$bd/etc/apk/world" > "$t/bw"; pkg_world "$view/etc/apk/world" > "$t/vw"
    pkg_db "$bd/lib/apk/db/installed" > "$t/bi"; pkg_db "$view/lib/apk/db/installed" > "$t/vi"
    apk=${GLASSINE_DEPLOY_APK:-/sbin/apk}; [ -x "$apk" ] || apk=''
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    awk 'f == 1 { b[$0] = 1; next } !($0 in b)' f=1 "$t/bw" f=2 "$t/vw" | while read -r e; do
        if [ "$PORC" = 1 ]; then out type package; out change added; out entry "$e"; emit; else echo "added    $e"; fi
    done
    awk 'f == 1 { v[$0] = 1; next } !($0 in v)' f=1 "$t/vw" f=2 "$t/bw" | while read -r e; do
        if [ "$PORC" = 1 ]; then out type package; out change removed; out entry "$e"; emit; else echo "removed  $e"; fi
    done
    awk 'f == 1 { b[$1] = $2; next } ($1 in b) && b[$1] != $2 { print $1, $2, b[$1] }' f=1 "$t/bi" f=2 "$t/vi" |
    while read -r n v bv; do
        c=changed
        if [ -n "$apk" ]; then
            case $("$apk" version -t "$v" "$bv" 2>/dev/null) in '>') c=raised ;; '<') c=lowered ;; esac
        fi
        if [ "$PORC" = 1 ]; then
            out type package; out change "$c"; out name "$n"; out version "$v"; out base_version "$bv"; emit
        else
            printf '%-8s %s %s (base %s)\n' "$c" "$n" "$v" "$bv"
        fi
    done
    rm -rf "$t"
}

cmd_accept() {
    case "$ARG" in ''|.*|*[!A-Za-z0-9._-]*) fail 2 "not a deployment id: $ARG" ;; esac
    state_open_rw
    cur=$(gs_kv "$S/deploy" current)
    [ "$ARG" = "$cur" ] && return 0
    [ "$ARG" = "$(gs_kv "$S/deploy" candidate)" ] || die "$ARG is not the candidate"
    gs_update "$S/deploy" "previous=$cur" "current=$ARG" candidate= tries=0 || die "cannot write $S/deploy"
    echo "glassine-deploy: $ARG accepted (previous: ${cur:-none})"
}

[ $# -ge 1 ] || usage
CMD=$1; shift
PORC=0 YES=0 DISCARD=0 FULL=0 NOW=0 MODULES=0 SHA='' ARG='' NARG=0 FIRST=''
NOREPLAY=0 ACCEPT_DOWN=0 WITHOUT=''
while [ $# -gt 0 ]; do
    a=$1; shift
    case "$a" in
    --porcelain) PORC=1 ;;
    --modules) MODULES=1 ;;
    --sha256) [ $# -ge 1 ] || usage; SHA=$1; shift ;;
    --no-replay) NOREPLAY=1 ;;
    --accept-downgrades) ACCEPT_DOWN=1 ;;
    --without) [ $# -ge 1 ] || usage; WITHOUT="$WITHOUT $1"; shift ;;
    -) ARG=-; NARG=$((NARG + 1)) ;;
    --yes) YES=1 ;;
    --discard-hibernation) DISCARD=1 ;;
    --full) FULL=1 ;;
    --now) NOW=1 ;;
    -*) usage ;;
    *) [ "$NARG" = 0 ] && FIRST=$a; ARG=$a; NARG=$((NARG + 1)) ;;
    esac
done
case "$CMD:$NARG" in
status:0) cmd_status ;;
list:0) cmd_list ;;
select:1) cmd_select ;;
rollback:0) cmd_rollback ;;
hibernate-invalidate:0) cmd_hibernate_invalidate ;;
reset:0) cmd_reset ;;
stage:1) cmd_stage ;;
receive:1) cmd_receive ;;
bases:0) cmd_bases ;;
bases:2) cmd_bases_remove ;;
packages:0|packages:1) cmd_packages ;;
switch:0) cmd_switch ;;
accept:1) cmd_accept ;;
*) usage ;;
esac
