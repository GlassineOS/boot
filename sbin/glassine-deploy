#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# glassine-deploy: root deployments (bases on the btrfs system partition, one
# overlay upper per deployment on userdata). The same code runs on the system
# and in recovery; the recovery's menu only calls it. Interface and formats:
# docs/deployments.md.
#
#   glassine-deploy status [--porcelain]
#   glassine-deploy list [--porcelain]
#   glassine-deploy select ID [--yes] [--discard-hibernation] [--restart]
#   glassine-deploy rollback [--yes] [--discard-hibernation] [--restart]
#   glassine-deploy hibernate-invalidate [--yes]
#   glassine-deploy reset [--full] [--now] [--yes] [--discard-hibernation] [--restart]
#   glassine-deploy stage BASE [--no-replay] [--without NAME]… [--accept-downgrades] [--now] [--yes] [--discard-hibernation] [--restart]
#   glassine-deploy restart [--check [--porcelain] | --soft | --cold] [--once ID]
#   glassine-deploy receive FILE|- [--modules] [--sha256 HEX] [--discard-hibernation]
#   glassine-deploy receive FILE --boot [--sha256 HEX] [--discard-hibernation]
#   glassine-deploy bases [--porcelain]
#   glassine-deploy bases remove BASE [--yes] [--discard-hibernation]
#   glassine-deploy remove ID [--yes] [--discard-hibernation]
#   glassine-deploy packages [ID] [--porcelain]
#   glassine-deploy switch [--discard-hibernation]
#   glassine-deploy accept ID
#   glassine-deploy publish
#   glassine-deploy init POOL_MOUNT [--install-marker]
#
# restart restarts soft (PID 1 re-enters the kept initramfs assembly: no
# firmware, no loader, no kernel start) where the rules allow, else cold; --check
# says which and why (exit 0 soft, 9 cold), --soft refuses a cold one (exit 9),
# --once ID starts ID for one session; --restart on select/rollback/reset/stage
# restarts after the command.
# select makes ID the candidate for the next boot (2 tries, then the current
# one again); selecting the current deployment cancels a candidate. rollback
# = select the previous one. hibernate-invalidate turns a hibernate image on
# userdata back into a plain swap file (that session is lost). reset stages
# a new deployment on the current one's base; the next switch fills it and
# selects it. stage BASE does the same on another base (a base update), with
# the user's package changes replayed into the new deployment's build layer:
# apk from the new base in a chroot, scripts on, an empty /run so that OpenRC
# starts nothing. A package version going down, or a package that no longer
# resolves, stops the stage with exit 7 and nothing staged: --accept-downgrades
# takes the lower versions, --without NAME leaves NAME's change out (added, or a changed entry's removal),
# --no-replay stages the bare base;
# receive puts a btrfs send stream (full or incremental, .zst by its name) under
# bases/ (or modules/), read-only; receive --boot puts a device tree or an
# initramfs with its manifest into boot/ (identity checked, an existing name a
# no-op); bases lists them with their users. bases
# remove deletes a base no deployment needs to boot now: it refuses the base of
# the booted, current, candidate or staged deployment, and asks first when other
# deployments (the previous one, usually) would lose theirs: those stay on
# userdata but can no longer be selected. Then it removes the boot/ files no
# kernel record names (docs/kernel-artifacts.md).
# remove ID deletes a deployment's layers from userdata: it refuses the current,
# candidate, staged and booted deployment and one that is mounted, and asks
# first for the previous one (its rollback is lost). The clean-up does the same
# by itself after a switch, after an accept and before a new deployment is
# staged: every deployment that is not current, previous, candidate, staged,
# the last failed one or the booted one goes. A removal is moved out of
# deployments/ first and then deleted, so a cut one never shows as a
# deployment and the next clean-up finishes it. stage checks the free space on
# userdata for the replay first (exit 5, nothing staged).
# packages lists how a deployment's packages differ from its base's (current
# by default): added and removed world entries, packages installed in another
# version (raised/lowered, by apk version -t when apk is there, else changed);
# derived each time from the world and the installed database, no bookkeeping.
# switch runs at shutdown (the hook's job, after services stop) or
# at once with reset --now (the recovery): it starts the staged deployment's
# switch layer afresh, carries the migrate list of the current deployment
# (/usr/share/glassine/migrate.list + the packages' migrate.d/*.list + /etc/glassine/migrate.d/*.list) into it,
# or nothing after reset --full, merges the user accounts into the new base's
# (lib/glassine-accounts.sh), and only then makes it the candidate; an
# interrupted switch selects nothing and is redone in full the next time. So
# changes made between the reset and the shutdown are carried. Home and
# Flatpak's system data are on userdata, outside the deployments, and never
# touched. accept ID is the
# boot-success service's: the booted candidate ID becomes current.
# publish writes the deployment list into the loader record (010 FR-039 to
# FR-041, docs/boot-partition.md "Keys": deploys, deploy1 ...) on a board that
# keeps one (glassine-loader-mark has-record): the previous deployment, the
# candidate, the last failed one and the kept ones that can start (their base on
# the system partition), each "<id> <state> <base version> <created date>", equal ones kept apart
# by the created time (loader_rows). accept,
# switch, select, rollback, remove and stage publish it too, after their state
# write; the boot-success step runs publish on every healthy start (a list a
# failed boot changed). Only a list that differs is written; a failed write
# never fails the command. Userdata that can't be read, or that doesn't hold the
# current deployment, leaves the record's list as it was.
# init lays out an empty btrfs pool, made and mounted by the caller (the image
# builder): bases/, modules/, state/ with an empty deployment and kernel state,
# and with --install-marker state/install, which makes the first start
# (glassine-first-start) format userdata and select the first deployment. stage
# with no current deployment (that first deployment) needs --no-replay and
# carries nothing.
#
# --porcelain: the first line is "glassine-deploy 1" (the output format
# version), then one record per line: tab-separated key=value fields, the
# first one type=<record>. Keys may be added within a version.
#
# Exit codes: 0 done, 1 error, 2 usage, 3 the state format on the system
# partition is newer than this tool (every command refuses; status still
# prints both versions), 4 hibernated and refused, 5 not enough space,
# 6 busy, 7 the replay needs a decision, 8 a kernel candidate is set
# (glassine-bootimg cancel; select, stage and reset refuse while one is, and
# reset --now and rollback cancel it first: the escape routes never wait for a
# kernel trial).
#
# Configuration: /etc/glassine/deploy.conf (conf/deploy.conf.example), or
# the file named by GLASSINE_DEPLOY_CONF.
set -u
CONF=${GLASSINE_DEPLOY_CONF:-/etc/glassine/deploy.conf}
LIB=${GLASSINE_DEPLOY_LIB:-/usr/lib/glassine-boot/glassine-state.sh}
SYSTEM_DEV='' SYSTEM_MNT=/run/glassine/system
USERDATA_DEV='' USERDATA_MNT=/run/glassine/userdata USERDATA_PREFIX=media/glassine
RUN_DIR=/run/glassine SOFT_RESTART=yes RESTART_LIMIT_S=20 SWITCH_MIN_CAPACITY=30
SOFT_START=/usr/lib/glassine-boot/soft-start
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"
SWITCH_HOOK=${GLASSINE_SWITCH_HOOK:-/usr/sbin/glassine-switch-hook}
# shellcheck source=../lib/glassine-state.sh
. "$LIB" || { echo "glassine-deploy: cannot read $LIB" >&2; exit 1; }
# shellcheck source=../lib/glassine-root.sh
. "${LIB%/*}/glassine-root.sh" || { echo "glassine-deploy: cannot read ${LIB%/*}/glassine-root.sh" >&2; exit 1; }
# shellcheck source=../lib/glassine-accounts.sh
. "${LIB%/*}/glassine-accounts.sh" || { echo "glassine-deploy: cannot read ${LIB%/*}/glassine-accounts.sh" >&2; exit 1; }

PORCELAIN_VERSION=1
SWAPFILE="$USERDATA_PREFIX/swap/hibernate"
GUARD="$USERDATA_PREFIX/swap/hibernate.guard"
MOUNTED_HERE='' UD_MOUNTED_HERE='' TMP_VIEW='' NEW_DEP='' SWITCHING='' RECV_TMP='' RECV_BEFORE=''
REPLAY_MNT='' REPLAY_BINDS='' REPLAY_RESOLV='' REPLAY_TMP='' NEW_ETC=''

die() { echo "glassine-deploy: $*" >&2; exit 1; }
fail() { _c=$1; shift; echo "glassine-deploy: $*" >&2; exit "$_c"; }
usage() { sed -n 's/^#   //p' "$0" >&2; exit 2; }

# is_mounted DIR: busybox mountpoint, or the test hook (a plain directory)
is_mounted() {
    [ -n "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ] && { [ -d "$1" ]; return; }
    mountpoint -q "$1" 2>/dev/null
}

# fstype DEV: the file system type blkid reports, or empty
fstype() {
    blkid "$1" 2>/dev/null | sed -n 's/.* TYPE="\([^"]*\)".*/\1/p' | head -n 1
}

# replay_umount: the replay's chroot down, binds first. The mount point is only
# ever rmdir'ed: while a bind is on it, a recursive remove would reach the host.
replay_umount() {
    [ -n "$REPLAY_MNT" ] || return 0
    for _m in $REPLAY_BINDS; do umount "$REPLAY_MNT$_m" || echo "glassine-deploy: cannot unmount $REPLAY_MNT$_m" >&2; done
    REPLAY_BINDS=''
    [ -z "$REPLAY_RESOLV" ] || rm -f "$REPLAY_MNT/etc/resolv.conf"
    REPLAY_RESOLV=''
    umount "$REPLAY_MNT" && rmdir "$REPLAY_MNT" || echo "glassine-deploy: cannot unmount $REPLAY_MNT" >&2
    REPLAY_MNT=''
}

cleanup() {
    replay_umount
    [ -n "$REPLAY_TMP" ] && rm -rf "$REPLAY_TMP"
    REPLAY_TMP=''
    [ -n "$NEW_ETC" ] && rm -rf "$NEW_ETC"
    NEW_ETC=''
    [ -n "$TMP_VIEW" ] && umount "$TMP_VIEW" 2>/dev/null && rmdir "$TMP_VIEW" 2>/dev/null
    TMP_VIEW=''
    [ -n "$SWITCHING" ] && rm -f "$SWITCHING"
    SWITCHING=''
    # a half-built deployment never stays behind
    [ -n "$NEW_DEP" ] && rm -rf "$NEW_DEP"
    NEW_DEP=''
    # a failed receive leaves nothing behind: what it added to RECV_TMP
    # (bases/ or modules/) since RECV_BEFORE goes
    if [ -n "$RECV_TMP" ]; then
        for _r in "$RECV_TMP"/*; do
            [ -d "$_r" ] || continue
            printf '%s\n' "$RECV_BEFORE" | grep -qxF -- "${_r##*/}" && continue
            btrfs -q subvolume delete "$_r" >/dev/null 2>&1 || rm -rf "$_r"
        done
    fi
    RECV_TMP=''
    # the state lock (fd 9, on $SYSTEM_MNT/state/.lock) keeps the system
    # partition busy; cleanup runs only before the lock is taken or at exit
    exec 9>&-
    if [ -n "$UD_MOUNTED_HERE" ]; then
        umount "$UD_MOUNTED_HERE" || echo "glassine-deploy: cannot unmount $UD_MOUNTED_HERE" >&2
    fi
    UD_MOUNTED_HERE=''
    if [ -n "$MOUNTED_HERE" ]; then
        umount "$MOUNTED_HERE" || echo "glassine-deploy: cannot unmount $MOUNTED_HERE" >&2
    fi
    MOUNTED_HERE=''
}
# an interrupt leaves the script (the EXIT trap then cleans up); a trap that only
# cleaned up would let it carry on with a staged deployment that was just removed
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# system_open: make the system partition's top level readable at SYSTEM_MNT.
# Sets SYS_FS (btrfs/ext4/…/none) and SYS_DIR (empty if not readable). A
# btrfs that is not mounted is mounted read-only with rescue=nologreplay
# (never a log replay: a hibernated system may be resumed later). Anything
# else is never mounted here (an ext4 read-only mount still replays its
# journal).
system_open() {
    SYS_DIR=''
    if is_mounted "$SYSTEM_MNT"; then
        SYS_FS=${GLASSINE_DEPLOY_FAKE_FS:-btrfs}
        [ -n "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ] || SYS_FS=$(fstype "$SYSTEM_DEV")
        SYS_DIR=$SYSTEM_MNT
        return 0
    fi
    [ -n "$SYSTEM_DEV" ] && [ -e "$SYSTEM_DEV" ] || { SYS_FS=none; return 0; }
    SYS_FS=$(fstype "$SYSTEM_DEV")
    [ "$SYS_FS" = btrfs ] || return 0
    mkdir -p "$SYSTEM_MNT" || return 1
    mount -t btrfs -o ro,rescue=nologreplay "$SYSTEM_DEV" "$SYSTEM_MNT" || return 1
    MOUNTED_HERE=$SYSTEM_MNT
    SYS_DIR=$SYSTEM_MNT
}

# hibernated: yes / no / unknown, without mounting userdata
hibernated() {
    if is_mounted "$USERDATA_MNT"; then
        _f="$USERDATA_MNT/$SWAPFILE"
        [ -e "$_f" ] || { echo no; return; }
        _s=$(gs_sig_file "$_f")
    elif [ -n "$USERDATA_DEV" ] && [ -e "$USERDATA_DEV" ]; then
        # debugfs exits 0 for a missing file too: look for the inode line
        debugfs -R "stat /$SWAPFILE" "$USERDATA_DEV" 2>/dev/null | grep -q '^Inode:' || { echo no; return; }
        _b=$(gs_dev_block "$USERDATA_DEV" "$SWAPFILE") || { echo unknown; return; }
        _s=$(gs_sig_dev "$USERDATA_DEV" "$_b")
    else
        echo unknown; return
    fi
    [ "$_s" = "$GS_SIG_HIBERNATE" ] && echo yes || echo no
}

# Userdata is read through its mount when it is mounted, else with debugfs on
# the device (no mount, no journal replay; may miss the newest writes of an
# unclean shutdown, which is fine for reading the list).
ud_mounted() { is_mounted "$USERDATA_MNT"; }

# mounted_at DEV: where DEV is mounted already (any path, e.g. a recovery's
# /data), or empty; compares the resolved device nodes
mounted_at() {
    _rd=$(readlink -f "$1" 2>/dev/null) || return 0
    # only a mount of the file system's top directory (mountinfo's root "/"),
    # never a bind of a directory inside it (the person's /home is one)
    while read -r _id _par _mm _root _mp _rest; do
        [ "$_root" = / ] || continue
        _src=${_rest#* - }; _src=${_src#* }; _src=${_src%% *}
        case "$_src" in /*) ;; *) continue ;; esac
        [ "$(readlink -f "$_src" 2>/dev/null)" = "$_rd" ] && { printf '%b\n' "$_mp"; return 0; }
    done < "${GLASSINE_DEPLOY_MOUNTINFO:-/proc/self/mountinfo}"
}

# userdata mounted somewhere else than USERDATA_MNT: use that mount. Never
# the raw device under a mounted file system (glassine-state.sh).
if [ -z "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ] && [ -n "$USERDATA_DEV" ] && ! is_mounted "$USERDATA_MNT"; then
    _m=$(mounted_at "$USERDATA_DEV")
    [ -n "$_m" ] && USERDATA_MNT=$_m
fi
ud_dev() { [ -n "$USERDATA_DEV" ] && [ -e "$USERDATA_DEV" ]; }

# ud_dirs REL: the subdirectories of <prefix>/REL
ud_dirs() {
    if ud_mounted; then
        for _d in "$USERDATA_MNT/$USERDATA_PREFIX/$1"/*; do
            [ -d "$_d" ] && echo "${_d##*/}"
        done
    elif ud_dev; then
        # ls -p: /inode/mode/uid/gid/name/size/
        debugfs -R "ls -p /$USERDATA_PREFIX/$1" "$USERDATA_DEV" 2>/dev/null |
            awk -F/ 'NF > 6 && $3 ~ /^0*4/ && $6 != "." && $6 != ".." { print $6 }'
    fi
}

# ud_cat REL: the contents of <prefix>/REL (empty if missing)
ud_cat() {
    if ud_mounted; then
        cat "$USERDATA_MNT/$USERDATA_PREFIX/$1" 2>/dev/null
    elif ud_dev; then
        debugfs -R "cat /$USERDATA_PREFIX/$1" "$USERDATA_DEV" 2>/dev/null
    fi
    return 0
}

# twrp_keep_rel: the keep marker of the prefix's top-level media directory,
# relative to userdata (empty when the prefix is not under media/)
twrp_keep_rel() {
    case $USERDATA_PREFIX in
        media/?*) _t=${USERDATA_PREFIX#media/}; echo "media/${_t%%/*}/.twrp-keep" ;;
    esac
}

# ud_size_kib REL: disk use of <prefix>/REL; empty while userdata is not mounted
ud_size_kib() {
    ud_mounted || return 0
    du -sk "$USERDATA_MNT/$USERDATA_PREFIX/$1" 2>/dev/null | cut -f 1
}

# invalidate: rule 5 on the swap file, the same way hibernated() reads it
invalidate() {
    if ud_mounted; then
        [ -e "$USERDATA_MNT/$SWAPFILE" ] || return 0
        gs_invalidate_file "$USERDATA_MNT/$SWAPFILE"
    else
        _b=$(gs_dev_block "$USERDATA_DEV" "$SWAPFILE") || return 1
        gs_invalidate_dev "$USERDATA_DEV" "$_b"
    fi
}

# confirm QUESTION: --yes, or a "y" on a terminal; anything else cancels
confirm() {
    [ "$YES" = 1 ] && return 0
    [ -t 0 ] || die "$1: rerun with --yes"
    printf '%s [y/N] ' "$1" >&2
    read -r _a || _a=''
    case "$_a" in y|Y|yes) return 0 ;; esac
    die cancelled
}

# format_check: refuse (exit 3) a state format newer than this tool; sets FMT
format_check() {
    FMT=none
    [ -n "$SYS_DIR" ] && FMT=$(gs_format_version "$SYS_DIR")
    [ "$FMT" = none ] || gs_format_ok "$FMT" ||
        fail 3 "state format $FMT is newer than this tool ($GS_FORMAT_SUPPORTED); update glassine-deploy"
}

# hibernation_gate: rule 8, before anything mounts the system partition
# read-write. Refuses (exit 4) unless --discard-hibernation, then invalidates.
hibernation_gate() {
    case $(hibernated) in
    no) return 0 ;;
    yes)
        [ "$DISCARD" = 1 ] || fail 4 "userdata holds a hibernated session; rerun with --discard-hibernation (the session is lost)"
        confirm "Discard the hibernated session?"
        invalidate || die "cannot invalidate the hibernate image"
        [ "$(hibernated)" = no ] || die "the hibernate image is still there"
        ;;
    *)
        [ "$DISCARD" = 1 ] || fail 4 "cannot tell whether userdata holds a hibernated session; rerun with --discard-hibernation"
        ;;
    esac
}

# state_open_rw: the system partition read-write, its state locked. Sets S.
state_open_rw() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    [ "$FMT" = none ] && die "the system partition is not migrated (no state/)"
    cleanup
    hibernation_gate
    if ! is_mounted "$SYSTEM_MNT"; then
        mkdir -p "$SYSTEM_MNT" || die "cannot create $SYSTEM_MNT"
        mount -t btrfs -o rw "$SYSTEM_DEV" "$SYSTEM_MNT" || die "cannot mount $SYSTEM_DEV read-write"
        MOUNTED_HERE=$SYSTEM_MNT
    fi
    S="$SYSTEM_MNT/state"
    : >>"$S/.lock" 2>/dev/null || die "$S is not writable"
    gs_lock "$S" || fail 6 "busy: another glassine-deploy (or a switch) holds $S/.lock"
    # a switch holds the lock while its marker exists; with the lock ours, a
    # marker is a killed switch's (its layer is redone by the next switch)
    if [ -e "$RUN_DIR/switching" ]; then
        echo "glassine-deploy: removing a stale $RUN_DIR/switching (an interrupted switch)" >&2
        rm -f "$RUN_DIR/switching"
    fi
}

# kernel_gate [cancel]: one trial at a time (docs/kernel-artifacts.md). While a
# kernel candidate is set, refuse (exit 8); with cancel, drop it first (as
# glassine-bootimg cancel does) and say so. Needs state_open_rw.
kernel_gate() {
    _kc=$(gs_kernel_candidate "$S/kernel")
    [ -n "$_kc" ] || return 0
    if [ "${1:-}" = cancel ]; then
        gs_kernel_cancel "$S/kernel" || die "cannot write $S/kernel"
        echo "glassine-deploy: the kernel candidate $_kc is cancelled first (glassine-bootimg cancel)" >&2
        return 0
    fi
    fail 8 "a kernel candidate ($_kc) is set: run glassine-bootimg cancel first, or let its trial finish"
}

# dep_mounted ID: a mount of this namespace names deployment ID's directory (a
# mount point in it, or an overlay with a layer of it). Matched by the path's end
# (deployments/ID), since an overlay keeps the paths it was mounted with (the
# initramfs's, before its mounts moved).
dep_mounted() {
    while IFS= read -r _l; do
        case "$_l" in
        *"/deployments/$1/"*|*"/deployments/$1 "*|*"/deployments/$1,"*|*"/deployments/$1:"*|*"/deployments/$1") return 0 ;;
        esac
    done < "${GLASSINE_DEPLOY_MOUNTINFO:-/proc/self/mountinfo}"
    return 1
}

# trash_purge: deletes what earlier removals left in deployments.removing/
# (a cut rm -rf). Needs UD. Never fails.
trash_purge() {
    for _x in "$UD/deployments.removing"/*; do
        [ -e "$_x" ] || continue
        rm -rf "$_x" || echo "glassine-deploy: cannot delete $_x yet; the next clean-up tries again" >&2
    done
    return 0
}

# dep_remove ID: deployment ID off userdata. Refuses (1) a mounted one. First
# a rename out of deployments/ (one step: from then on it is no deployment),
# then the delete; a cut delete is finished by trash_purge. Needs UD and the
# state lock; the caller makes sure the state names ID nowhere.
dep_remove() {
    if dep_mounted "$1"; then
        echo "glassine-deploy: deployment $1 is mounted; not removed" >&2
        return 1
    fi
    _t=$UD/deployments.removing
    mkdir -p "$_t" && { [ ! -e "$_t/$1" ] || rm -rf "${_t:?}/$1"; } && mv "$UD/deployments/$1" "$_t/$1" ||
        { echo "glassine-deploy: cannot move deployment $1 aside; not removed" >&2; return 1; }
    rm -rf "${_t:?}/$1" ||
        { echo "glassine-deploy: deployment $1 is gone from the list, but not all of it is deleted; the next clean-up finishes it" >&2; return 1; }
}

# gc_deployments: the clean-up. Every deployment on userdata that is not current,
# previous, candidate, staged, the last failed one (state failed=) or the booted
# one is removed (dep_remove: never a mounted one). Needs state_open_rw + UD.
# Never fails: it runs after the state write of a switch or an accept, which
# must not read as failed because of it. Does nothing while the current
# deployment is not on userdata (an unreadable state or another userdata must
# not read as "nothing is needed").
gc_deployments() {
    _gc_cur=$(gs_kv "$S/deploy" current)
    if [ -z "$_gc_cur" ] || [ ! -r "$UD/deployments/$_gc_cur/meta" ]; then
        echo "glassine-deploy: clean-up skipped: the current deployment ${_gc_cur:-(none)} is not on userdata" >&2
        return 0
    fi
    _gc_keep=" $_gc_cur $(gs_kv "$S/deploy" previous) $(gs_kv "$S/deploy" candidate) $(gs_kv "$S/deploy" staged) $(gs_kv "$S/deploy" failed) $(cat "$RUN_DIR/booted" 2>/dev/null) "
    trash_purge
    _gc_done=''
    for _gc_d in "$UD/deployments"/*; do
        [ -d "$_gc_d" ] || continue
        _gc_id=${_gc_d##*/}
        valid_name "$_gc_id" || continue
        case "$_gc_keep" in *" $_gc_id "*) continue ;; esac
        dep_remove "$_gc_id" && _gc_done="$_gc_done $_gc_id"
    done
    [ -z "$_gc_done" ] || echo "glassine-deploy: clean-up: removed$_gc_done"
    return 0
}

# base_version SYSDIR BASE: the base's version: the image version of its base
# manifest (version= of usr/share/glassine/base.manifest), else VERSION_ID of its
# os-release (usr/lib/os-release, else etc/os-release when that is a file of the
# base, not a link out of it); each read as text, never run, and taken only when
# it is [A-Za-z0-9._+~-] and at most 32 characters. None: empty.
base_version() {
    _bv_d=$1/bases/$2 _bv_f=''
    [ -n "$2" ] || return 0
    if [ -f "$_bv_d/usr/share/glassine/base.manifest" ] && [ ! -L "$_bv_d/usr/share/glassine/base.manifest" ]; then
        _bv_v=$(sed -n 's/^version=//p' "$_bv_d/usr/share/glassine/base.manifest" 2>/dev/null | head -n 1)
        if plain_version "$_bv_v"; then printf '%s' "$_bv_v"; return 0; fi
    fi
    if [ -f "$_bv_d/usr/lib/os-release" ] && [ ! -L "$_bv_d/usr/lib/os-release" ]; then _bv_f=$_bv_d/usr/lib/os-release
    elif [ -f "$_bv_d/etc/os-release" ] && [ ! -L "$_bv_d/etc/os-release" ]; then _bv_f=$_bv_d/etc/os-release
    fi
    [ -n "$_bv_f" ] || return 0
    _bv_v=$(sed -n 's/^VERSION_ID=//p' "$_bv_f" 2>/dev/null | head -n 1)
    _bv_v=${_bv_v#[\"\']} _bv_v=${_bv_v%[\"\']}
    plain_version "$_bv_v" || return 0
    printf '%s' "$_bv_v"
}
plain_version() {
    case $1 in ''|*[!A-Za-z0-9._+~-]*) return 1 ;; esac
    [ ${#1} -le 32 ]
}

# loader_rows SYSDIR: the loader's deployment list (see publish), one
# "<id> <state> <label>" line each, previous, candidate, failed, then the kept
# ones by id; the label "<version> <date>": the base's version (base_version)
# and the deployment's created date, either left out when unknown, never the
# base id (the id stays the line's first field). Rows whose labels would read
# the same also get their created time, "HH:MM", or "HH:MM:SS" where the minute
# matches too (010 FR-040). At most 32 + 1 + 10 + 1 + 8 characters, within the
# record's 64.
loader_rows() {
    _lr_cur=$(gs_kv "$1/state/deploy" current) _lr_prev=$(gs_kv "$1/state/deploy" previous)
    _lr_cand=$(gs_kv "$1/state/deploy" candidate) _lr_failed=$(gs_kv "$1/state/deploy" failed)
    _lr_staged=$(gs_kv "$1/state/deploy" staged)
    _lr_p='' _lr_c='' _lr_f='' _lr_k=''
    for _lr_id in $(ud_dirs deployments | sort); do
        valid_name "$_lr_id" || continue
        [ "$_lr_id" = "$_lr_cur" ] || [ "$_lr_id" = "$_lr_staged" ] && continue
        _lr_m=$(ud_cat "deployments/$_lr_id/meta")
        _lr_b=$(meta_kv "$_lr_m" base)
        [ -z "$_lr_b" ] || [ -d "$1/bases/$_lr_b" ] || continue
        _lr_v=$(base_version "$1" "$_lr_b")
        _lr_t=$(meta_kv "$_lr_m" created)
        _lr_d=${_lr_t%%T*}
        case $_lr_d in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) _lr_d='' ;; esac
        case $_lr_t in
            ????-??-??T[0-2][0-9]:[0-5][0-9]:[0-6][0-9]*) _lr_t=${_lr_t#*T} _lr_t=${_lr_t%"${_lr_t#????????}"} ;;
            *) _lr_t='' ;;
        esac
        [ -n "$_lr_d" ] || _lr_t=''
        _lr_l="$_lr_v${_lr_v:+${_lr_d:+ }}$_lr_d"
        if [ "$_lr_id" = "$_lr_cand" ]; then _lr_s=candidate
        elif [ "$(meta_kv "$_lr_m" failed)" = 1 ] || [ "$_lr_id" = "$_lr_failed" ]; then _lr_s=failed
        elif [ "$_lr_id" = "$_lr_prev" ]; then _lr_s=previous
        else _lr_s=kept
        fi
        _lr_r=$(printf '%s\t%s\t%s\t%s' "$_lr_id" "$_lr_s" "$_lr_l" "$_lr_t")
        case $_lr_s in
            candidate) _lr_c="$_lr_c$_lr_r
" ;;
            failed) _lr_f="$_lr_f$_lr_r
" ;;
            previous) _lr_p="$_lr_p$_lr_r
" ;;
            *) _lr_k="$_lr_k$_lr_r
" ;;
        esac
    done
    # equal labels apart: the time to the minute, then to the second
    printf '%s' "$_lr_p$_lr_c$_lr_f$_lr_k" | awk -F '\t' '
        { id[NR] = $1; st[NR] = $2; l[NR] = $3; t[NR] = $4; if ($3 != "") n[$3]++ }
        END {
            for (i = 1; i <= NR; i++) {
                m[i] = l[i]
                if (l[i] != "" && n[l[i]] > 1 && t[i] != "") { m[i] = l[i] " " substr(t[i], 1, 5); c[m[i]]++ }
            }
            for (i = 1; i <= NR; i++) {
                if (m[i] != l[i] && c[m[i]] > 1) m[i] = l[i] " " t[i]
                printf "%s %s%s\n", id[i], st[i], (m[i] != "" ? " " m[i] : "")
            }
        }'
}

# loader_publish SYSDIR [locked]: the list into the loader record (publish);
# "locked": the caller holds the state lock. Never fails.
loader_publish() {
    _lp_m=${GLASSINE_LOADER_MARK:-/usr/sbin/glassine-loader-mark}
    [ -x "$_lp_m" ] || return 0
    "$_lp_m" has-record >/dev/null 2>&1 || return 0
    if ! ud_mounted && ! ud_dev; then
        echo "glassine-deploy: userdata can't be read: the loader's deployment list left as it was" >&2
        return 0
    fi
    _lp_cur=$(gs_kv "$1/state/deploy" current)
    if [ -n "$_lp_cur" ] && ! ud_dirs deployments | grep -qx -- "$_lp_cur"; then
        echo "glassine-deploy: the current deployment $_lp_cur is not on userdata: the loader's deployment list left as it was" >&2
        return 0
    fi
    _lp_l=''; [ "${2:-}" = locked ] && _lp_l=1
    loader_rows "$1" | GLASSINE_LOADER_MARK_LOCKED=$_lp_l "$_lp_m" deploys ||
        echo "glassine-deploy: the loader's deployment list not written (glassine-loader-mark exit $?)" >&2
    return 0
}

cmd_publish() {
    require_migrated
    _pd=$SYS_DIR
    # the state lock while the list is read and written, when it can be taken here
    if : >>"$_pd/state/.lock" 2>/dev/null; then
        _pn=0
        exec 9>>"$_pd/state/.lock"
        until flock -n 9; do
            [ $_pn -lt 10 ] || fail 6 "busy: $_pd/state/.lock is held"
            sleep 1; _pn=$((_pn + 1))
        done
        loader_publish "$_pd" locked
    else
        loader_publish "$_pd"
    fi
}

# meta_kv META KEY: one key of a deployment's meta (key=value text)
meta_kv() { printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -n 1; }

# out KEY VALUE…: collect the fields of one record
REC=''
out() { REC="$REC$1=$2	"; }

emit() {
    if [ "$PORC" = 1 ]; then
        printf '%s\n' "${REC%	}"
    else
        printf '%s\n' "${REC%	}" | tr '\t' '\n' | sed -n 's/^type=.*//;t;s/=/: /p'
    fi
    REC=''
}

# storage_status: the person's storage as this boot left it (the initramfs's
# RUN_DIR/storage; empty outside a deployments boot): home=, flatpak=
# (bound, failed, or empty on a bare boot or without the file), <name>_error=,
# <name>_hidden=yes when the deployment's own directory under the bind holds
# files (RUN_DIR/root is the merged root without the binds), vartmp=
storage_status() {
    _sf=$RUN_DIR/storage
    for _e in home:home flatpak:var/lib/flatpak; do
        _n=${_e%%:*} _h=''
        _v=$(gs_kv "$_sf" "$_n" 2>/dev/null)
        if [ -d "$RUN_DIR/root/${_e#*:}" ]; then
            if [ -n "$(ls -A "$RUN_DIR/root/${_e#*:}" 2>/dev/null)" ]; then _h=yes; else _h=no; fi
        fi
        out "$_n" "$_v"
        [ "$_v" != failed ] || out "${_n}_error" "$(gs_kv "$_sf" "${_n}_error")"
        out "${_n}_hidden" "$_h"
    done
    out vartmp "$(gs_kv "$_sf" vartmp 2>/dev/null)"
}

cmd_status() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    rc=0
    fmt=none
    [ -n "$SYS_DIR" ] && fmt=$(gs_format_version "$SYS_DIR")
    out type status
    out format "$fmt"
    out supported "$GS_FORMAT_SUPPORTED"
    out system_fs "${SYS_FS:-unknown}"
    if [ "$fmt" = none ]; then
        out migrated no
    elif gs_format_ok "$fmt"; then
        out migrated yes
        S="$SYS_DIR/state"
        out current "$(gs_kv "$S/deploy" current)"
        out previous "$(gs_kv "$S/deploy" previous)"
        out candidate "$(gs_kv "$S/deploy" candidate)"
        out staged "$(gs_kv "$S/deploy" staged)"
        out failed "$(gs_kv "$S/deploy" failed)"
        out tries "$(gs_kv "$S/deploy" tries)"
        out kernel_current "$(gs_kv "$S/kernel" current)"
        out kernel_previous "$(gs_kv "$S/kernel" previous)"
    else
        out migrated yes
        rc=3
    fi
    out hibernated "$(hibernated)"
    out userdata_prefix "$USERDATA_PREFIX"
    _k=$(twrp_keep_rel); _kv=''
    if [ -n "$_k" ] && ud_mounted; then
        if [ -e "$USERDATA_MNT/$_k" ]; then _kv=yes; else _kv=no; fi
    fi
    out twrp_keep "$_kv"
    storage_status
    # a restart now (013 FR-006, FR-008): soft or cold and why, the switch, how
    # this start came
    if [ "$fmt" != none ] && gs_format_ok "$fmt"; then
        ONCE_ID=''
        restart_decide quick
        if [ -z "$RW" ]; then out restart soft; out restart_reason ''; else out restart cold; out restart_reason "$RW"; fi
    fi
    out last_start "$(gs_kv "$RUN_DIR/restart" kind)"
    out swapfile "$SWAPFILE"
    out guard "$GUARD"
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    emit
    [ $rc = 3 ] && echo "glassine-deploy: state format $fmt is newer than this tool ($GS_FORMAT_SUPPORTED); update glassine-deploy" >&2
    return $rc
}

cmd_list() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    cur='' prev='' cand='' failed='' staged=''
    if [ "$FMT" != none ]; then
        cur=$(gs_kv "$SYS_DIR/state/deploy" current)
        prev=$(gs_kv "$SYS_DIR/state/deploy" previous)
        cand=$(gs_kv "$SYS_DIR/state/deploy" candidate)
        failed=$(gs_kv "$SYS_DIR/state/deploy" failed)
        staged=$(gs_kv "$SYS_DIR/state/deploy" staged)
    fi
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    [ "$PORC" = 1 ] || printf '%-24s %-10s %-20s %-16s %-20s %s\n' ID STATE BASE KERNEL CREATED KIB
    for id in $(ud_dirs deployments); do
        m=$(ud_cat "deployments/$id/meta")
        if [ "$id" = "$cur" ]; then st=current
        elif [ "$id" = "$cand" ]; then st=candidate
        elif [ "$id" = "$staged" ]; then st=staged
        elif [ "$(meta_kv "$m" failed)" = 1 ] || [ "$id" = "$failed" ]; then st=failed
        elif [ "$id" = "$prev" ]; then st=previous
        else st=kept
        fi
        if [ "$PORC" = 1 ]; then
            out type deployment; out id "$id"; out state "$st"
            b=$(meta_kv "$m" base) bp=''
            # base_present: is the deployment's base on this system partition
            if [ -n "$b" ] && [ -n "$SYS_DIR" ]; then bp=no; [ -d "$SYS_DIR/bases/$b" ] && bp=yes; fi
            out base "$b"; out base_present "$bp"
            # version: the base's version (base_version), empty when unknown
            bv=''; [ -n "$b" ] && [ "$bp" = yes ] && bv=$(base_version "$SYS_DIR" "$b")
            out version "$bv"; out kernel "$(meta_kv "$m" kernel)"
            out created "$(meta_kv "$m" created)"; out size_kib "$(ud_size_kib "deployments/$id")"
            emit
        else
            printf '%-24s %-10s %-20s %-16s %-20s %s\n' "$id" "$st" "$(meta_kv "$m" base)" \
                "$(meta_kv "$m" kernel)" "$(meta_kv "$m" created)" "$(ud_size_kib "deployments/$id")"
        fi
    done
}

# require_migrated: dies unless the system partition holds state/ (read-only look)
require_migrated() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    [ "$FMT" = none ] && die "the system partition is not migrated (no state/)"
}

# do_select ID: ID becomes the candidate (2 tries); the current one cancels it
do_select() {
    case "$1" in ''|.*|*[!A-Za-z0-9._-]*) fail 2 "not a deployment id: $1" ;; esac
    require_migrated
    cleanup
    ud_dirs deployments | grep -qx -- "$1" || die "no deployment $1 on userdata"
    state_open_rw
    cur=$(gs_kv "$S/deploy" current)
    _b=$(meta_kv "$(ud_cat "deployments/$1/meta")" base)
    [ -z "$_b" ] || [ -d "$SYSTEM_MNT/bases/$_b" ] || die "deployment $1 cannot boot: its base $_b is not on the system partition"
    kernel_gate ${KGATE:+"$KGATE"}
    if [ "$1" = "$cur" ]; then
        gs_update "$S/deploy" candidate= tries=0 || die "cannot write $S/deploy"
        echo "glassine-deploy: $1 is the current deployment; no candidate"
    else
        gs_update "$S/deploy" "candidate=$1" tries=2 || die "cannot write $S/deploy"
        echo "glassine-deploy: $1 boots next (2 tries, then ${cur:-the current one} again)"
    fi
    loader_publish "$SYSTEM_MNT" locked
}

cmd_select() { do_select "$ARG"; }

cmd_rollback() {
    require_migrated
    prev=$(gs_kv "$SYS_DIR/state/deploy" previous)
    cleanup
    [ -n "$prev" ] || die "there is no previous deployment"
    KGATE=cancel
    do_select "$prev"
}

cmd_hibernate_invalidate() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    cleanup
    case $(hibernated) in
    no) echo "glassine-deploy: no hibernate image"; return 0 ;;
    unknown) die "cannot read the swap file on userdata" ;;
    esac
    confirm "Discard the hibernated session?"
    invalidate || die "cannot invalidate the hibernate image"
    [ "$(hibernated)" = no ] || die "the hibernate image is still there"
    echo "glassine-deploy: hibernate image invalidated"
}

# ud_open_rw: userdata mounted read-write at USERDATA_MNT (after the
# hibernation gate: this mount ends any hibernated session, rule 4); sets UD
ud_open_rw() {
    if ! ud_mounted; then
        ud_dev || die "no userdata ($USERDATA_DEV)"
        # booted by the deployments initramfs: userdata is the live upper (the
        # overlay holds it even where nothing shows it mounted, as at shutdown
        # after OpenRC's unmounts): never a fsck of a file system in use
        if [ ! -e "$RUN_DIR/booted" ]; then
            e2fsck -p "$USERDATA_DEV" >/dev/null 2>&1
            [ $? -lt 4 ] || die "e2fsck found errors on $USERDATA_DEV it cannot fix; run it by hand"
        fi
        mkdir -p "$USERDATA_MNT" || die "cannot create $USERDATA_MNT"
        mount -t ext4 "$USERDATA_DEV" "$USERDATA_MNT" || die "cannot mount $USERDATA_DEV"
        UD_MOUNTED_HERE=$USERDATA_MNT
    fi
    UD=$USERDATA_MNT/$USERDATA_PREFIX
    # the recovery's "wipe internal storage" skips a top-level media directory
    # that holds this marker (a TWRP that honours it): put it there
    _k=$(twrp_keep_rel)
    if [ -n "$_k" ] && [ ! -e "$USERDATA_MNT/$_k" ]; then
        mkdir -p "$USERDATA_MNT/${_k%/*}" && : > "$USERDATA_MNT/$_k" ||
            echo "glassine-deploy: cannot create $_k" >&2
    fi
}

# new_id: a fresh deployment id (UTC time, a suffix if taken). Ids are names,
# never an order: state/deploy says which is current, previous, candidate,
# and a recovery whose clock is unset (1970) makes 1970 ids, which is fine.
new_id() {
    _i=$(date -u +%Y%m%d-%H%M%S); _n=$_i _k=1
    while [ -e "$UD/deployments/$_n" ]; do _k=$((_k + 1)); _n=$_i-$_k; done
    echo "$_n"
}

# copy_path VIEW DEST PATH: PATH (absolute) from VIEW into DEST, with its
# parent directories' owner and mode
copy_path() {
    _p=${3%/}; _p=${_p#/}
    [ -e "$1/$_p" ] || [ -L "$1/$_p" ] || return 0
    _par=${_p%/*}; [ "$_par" = "$_p" ] && _par=''
    _acc=''
    for _c in $(echo "$_par" | tr '/' ' '); do
        _acc=$_acc/$_c
        [ -d "$2$_acc" ] && continue
        mkdir "$2$_acc" || return 1
        chown "$(stat -c %u:%g "$1$_acc")" "$2$_acc" && chmod "$(stat -c %a "$1$_acc")" "$2$_acc" || return 1
    done
    cp -a "$1/$_p" "$2/$_par/" || return 1
}

# migrate_paths VIEW [BASE]: the migrate list of a deployment: the base's list, the
# packages' lists (usr/share/glassine/migrate.d, of VIEW and of the new BASE, so a
# package that comes with the update names its state too) and the user's own
# (comments, blank lines and relative paths dropped)
migrate_paths() {
    cat "$1/usr/share/glassine/migrate.list" "$1"/usr/share/glassine/migrate.d/*.list \
        ${2:+"$2"/usr/share/glassine/migrate.d/*.list} "$1"/etc/glassine/migrate.d/*.list 2>/dev/null |
        sed 's/#.*//; s/[[:space:]]*$//' | grep '^/' | grep -v '\.\.' | sort -u
}

# switch_space VIEW NEWBASEDIR: is there room on userdata for the switch's copy of
# the migrate list from the root at VIEW? Sets need and avail (KiB). The switch's
# own check, and restart --check's beforehand (013 FR-012).
switch_space() {
    need=1024
    for p in $(migrate_paths "$1" "$2"); do
        [ -e "$1$p" ] && need=$((need + $(du -sk "$1$p" | cut -f 1)))
    done
    avail=$(df -Pk "$USERDATA_MNT" | awk 'NR == 2 { print $4 }')
    [ "${avail:-0}" -gt "$need" ]
}

cmd_reset() {
    state_open_rw
    [ "$NOW" = 1 ] || kernel_gate
    cur=$(gs_kv "$S/deploy" current)
    [ -n "$cur" ] || die "no current deployment to reset"
    ud_open_rw
    base=$(gs_kv "$UD/deployments/$cur/meta" base)
    [ -n "$base" ] && [ -d "$SYSTEM_MNT/bases/$base" ] || die "deployment $cur: base ${base:-?} is missing"
    when="at the next shutdown"; [ "$NOW" = 1 ] && when=now
    if [ "$FULL" = 1 ]; then
        confirm "Full reset: a new deployment on base $base with nothing carried over (accounts, Wi-Fi, Bluetooth, settings, packages); your home and Flatpak apps stay, prepared $when?"
    else
        confirm "Reset system: a new deployment on base $base that keeps only the migrate list (accounts, Wi-Fi, Bluetooth, settings; your packages and edits go); your home and Flatpak apps stay, prepared $when?"
    fi
    kind=reset carry=migrate; [ "$FULL" = 1 ] && kind=reset-full carry=none
    [ "$NOW" = 0 ] || kernel_gate cancel
    stage_new
}

# valid_name NAME: a deployment, base or modules name ([A-Za-z0-9._-], no
# leading dot)
valid_name() { case "$1" in ''|.*|*[!A-Za-z0-9._-]*) return 1 ;; esac; }

cmd_stage() {
    valid_name "$ARG" || fail 2 "not a base name: $ARG"
    [ "$FULL" = 0 ] || fail 2 "stage carries the migrate list; --full is reset's"
    state_open_rw
    kernel_gate
    cur=$(gs_kv "$S/deploy" current)
    # no current deployment (the first start, or a recovery after userdata was
    # formatted): the first deployment, the bare base with nothing carried; there
    # are no packages to replay
    [ -n "$cur" ] || [ "$NOREPLAY" = 1 ] ||
        die "no current deployment to replay packages from; --no-replay stages the bare base as the first deployment"
    [ -d "$SYSTEM_MNT/bases/$ARG" ] || die "no base $ARG on the system partition (receive it first)"
    [ -r "$SYSTEM_MNT/bases/$ARG/etc/passwd" ] || die "base $ARG has no /etc/passwd"
    ud_open_rw
    base=$ARG
    when="at the next shutdown"; [ "$NOW" = 1 ] && when=now
    if [ -n "$cur" ]; then
        confirm "Update: a new deployment on base $base that keeps the migrate list and your accounts (Wi-Fi, Bluetooth, settings; your packages and edits go), prepared $when?"
        kind=update carry=migrate
    else
        confirm "First deployment: base $base as shipped, nothing carried over, prepared $when?"
        kind=install carry=none
    fi
    stage_new
}

# replay_apk ARGS: apk from the new base, in its chroot; the state lock stays out
replay_apk() {
    chroot "$REPLAY_MNT" /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/root \
        /sbin/apk --no-progress --cache-dir /var/cache/apk "$@" 9>&-
}

# do_replay: the user's package changes on the running deployment, against its
# base, applied to the new deployment's build layer on $base. Needs state_open_rw
# + UD, cur, NEW_DEP. Sets nothing; dies or fails 7, which removes NEW_DEP.
do_replay() {
    [ "$NOREPLAY" = 1 ] && { echo "glassine-deploy: no replay: your packages stay out of this deployment"; return 0; }
    vapk=${GLASSINE_DEPLOY_APK:-/sbin/apk}
    [ -x "$vapk" ] || die "the replay needs apk ($vapk); --no-replay stages without your packages"
    t=${TMPDIR:-/tmp}/glassine-replay.$$
    mkdir -p "$t" || die "cannot create $t"
    REPLAY_TMP=$t
    ob=$(gs_kv "$UD/deployments/$cur/meta" base)
    [ -n "$ob" ] && [ -d "$SYSTEM_MNT/bases/$ob" ] || die "deployment $cur: base ${ob:-?} is missing"
    obd=$SYSTEM_MNT/bases/$ob nbd=$SYSTEM_MNT/bases/$base
    if [ "$(cat "$RUN_DIR/booted" 2>/dev/null)" = "$cur" ]; then
        # no leading //: busybox mount reads //var/cache/apk as a network share
        view=${GLASSINE_DEPLOY_ROOT:-/}; view=${view%/}
    else
        TMP_VIEW=$RUN_DIR/view.$$
        gr_merged_ro "$SYSTEM_MNT" "$UD/deployments/$cur" "$TMP_VIEW" || die "cannot open deployment $cur read-only"
        view=$TMP_VIEW
    fi
    pkg_world "$obd/etc/apk/world" > "$t/ow"; pkg_world "$view/etc/apk/world" > "$t/vw"; pkg_world "$nbd/etc/apk/world" > "$t/nw"
    pkg_db "$obd/lib/apk/db/installed" > "$t/oi" 2>/dev/null; pkg_db "$view/lib/apk/db/installed" > "$t/vi" 2>/dev/null
    pkg_db "$nbd/lib/apk/db/installed" > "$t/ni" 2>/dev/null
    # added and removed against the old base, as far as the new one differs
    awk 'FILENAME == ARGV[1] { o[$0] = 1; next } FILENAME == ARGV[2] { n[$0] = 1; next } !($0 in o) && !($0 in n)' "$t/ow" "$t/nw" "$t/vw" > "$t/add0"
    : > "$t/add"
    while read -r e; do
        _n=$(echo "$e" | sed 's/[<>=~@].*//')
        case " $WITHOUT " in *" $_n "*) echo "glassine-deploy: leaving out $e" ;; *) echo "$e" >> "$t/add" ;; esac
    done < "$t/add0"
    # removed: in the old base and the new one, not in the running world. --without NAME
    # leaves out NAME's removal too: an entry the user changed (a pin, a local file)
    # shows as the plain entry removed plus the changed one added, and the base's
    # plain entry must stay
    awk 'FILENAME == ARGV[1] { v[$0] = 1; next } FILENAME == ARGV[2] { n[$0] = 1; next } !($0 in v) && ($0 in n)' "$t/vw" "$t/nw" "$t/ow" > "$t/del0"
    : > "$t/del"
    while read -r e; do
        _n=$(echo "$e" | sed 's/[<>=~@].*//')
        case " $WITHOUT " in *" $_n "*) echo "glassine-deploy: keeping the base's $e" ;; *) echo "$e" >> "$t/del" ;; esac
    done < "$t/del0"
    # raised: above the old base and still above the new one (a base that caught up takes over)
    : > "$t/up"
    awk 'FILENAME == ARGV[1] { o[$1] = $2; next } FILENAME == ARGV[2] { n[$1] = $2; next } ($1 in o) && ($1 in n) && o[$1] != $2 { print $1, $2, o[$1], n[$1] }' "$t/oi" "$t/ni" "$t/vi" |
    while read -r n v bv nv; do
        [ "$("$vapk" version -t "$v" "$bv" 2>/dev/null)" = '>' ] || continue
        [ "$("$vapk" version -t "$v" "$nv" 2>/dev/null)" = '>' ] && echo "$n" >> "$t/up"
    done
    # repositories the user added (a line the old base does not have); never the old
    # branch's own, which a base on a new branch replaces
    : > "$t/repos"
    if [ -r "$view/etc/apk/repositories" ]; then
        while IFS= read -r l; do
            [ -n "$l" ] || continue
            grep -qxF -- "$l" "$obd/etc/apk/repositories" 2>/dev/null && continue
            grep -qxF -- "$l" "$nbd/etc/apk/repositories" 2>/dev/null && continue
            echo "$l" >> "$t/repos"
        done < "$view/etc/apk/repositories"
    fi
    cp "$t/ni" "$t/ri"
    if [ -s "$t/add" ] || [ -s "$t/del" ] || [ -s "$t/up" ]; then
        echo "glassine-deploy: replaying your packages on base $base: add $(tr '\n' ' ' < "$t/add"); remove $(tr '\n' ' ' < "$t/del"); upgrade $(tr '\n' ' ' < "$t/up")"
        [ -x "$nbd/sbin/apk" ] && [ -x "$nbd/usr/bin/env" ] || die "base $base has no apk to replay with; --no-replay stages without your packages"
        M=$RUN_DIR/replay.$$
        gr_mount_overlay "$M" "$nbd" "$NEW_DEP/build" "$NEW_DEP/work" || die "cannot assemble the new deployment at $M"
        REPLAY_MNT=$M
        cat "$t/repos" >> "$M/etc/apk/repositories" || die "cannot write the repositories"
        for k in "$view"/etc/apk/keys/*; do
            [ -e "$k" ] && [ ! -e "$M/etc/apk/keys/${k##*/}" ] && cp -p "$k" "$M/etc/apk/keys/"
        done
        # the API file systems and the package cache; an empty /run: nothing starts
        mkdir -p "$M/var/cache/apk" "$M/run" "$M/tmp" "$M/proc" "$M/sys" "$M/dev"
        mount --bind /dev "$M/dev" && REPLAY_BINDS="/dev $REPLAY_BINDS" || die "cannot bind /dev"
        mount -t proc proc "$M/proc" && REPLAY_BINDS="/proc $REPLAY_BINDS" || die "cannot mount /proc"
        mount -t tmpfs tmpfs "$M/run" && REPLAY_BINDS="/run $REPLAY_BINDS" || die "cannot mount /run"
        mount -t tmpfs tmpfs "$M/tmp" && REPLAY_BINDS="/tmp $REPLAY_BINDS" || die "cannot mount /tmp"
        if [ -n "$TMP_VIEW" ]; then
            # not the booted deployment: its view is read-only, and so is a bind of a
            # directory in it (apk could not write the lists or the downloads): the
            # cache is a directory of the new deployment, on userdata, gone after the replay
            mkdir -p "$NEW_DEP/apk-cache" && mount --bind "$NEW_DEP/apk-cache" "$M/var/cache/apk" &&
                REPLAY_BINDS="/var/cache/apk $REPLAY_BINDS" || die "cannot set up a writable package cache in $NEW_DEP"
        elif [ -d "$view/var/cache/apk" ]; then
            mount --bind "$view/var/cache/apk" "$M/var/cache/apk" && REPLAY_BINDS="/var/cache/apk $REPLAY_BINDS" || die "cannot bind the package cache"
        fi
        if [ -e /etc/resolv.conf ] && [ ! -L "$M/etc/resolv.conf" ]; then
            [ -e "$M/etc/resolv.conf" ] || { : > "$M/etc/resolv.conf" && REPLAY_RESOLV=1; }
            mount --bind /etc/resolv.conf "$M/etc/resolv.conf" && REPLAY_BINDS="/etc/resolv.conf $REPLAY_BINDS" || die "cannot bind resolv.conf"
        fi
        replay_apk update || echo "glassine-deploy: no fresh package lists, going on with the cached ones"
        # shellcheck disable=SC2046  # one package per word
        [ ! -s "$t/del" ] || replay_apk del $(cat "$t/del") ||
            fail 7 "removing your removed packages failed; nothing staged. --no-replay stages the bare base"
        # shellcheck disable=SC2046
        [ ! -s "$t/add" ] || replay_apk add $(cat "$t/add") ||
            fail 7 "your added packages do not install on base $base; nothing staged. --without NAME leaves one out, --no-replay stages the bare base"
        # shellcheck disable=SC2046
        [ ! -s "$t/up" ] || replay_apk upgrade $(cat "$t/up") ||
            fail 7 "your upgraded packages do not upgrade on base $base; nothing staged. --no-replay stages the bare base"
        pkg_db "$M/lib/apk/db/installed" > "$t/ri"
        replay_umount
        rm -rf "$NEW_DEP/apk-cache"
    fi
    # no silent downgrade: every package the running deployment has, against the new one
    down=''
    while read -r n v nv; do
        [ "$("$vapk" version -t "$v" "$nv" 2>/dev/null)" = '>' ] || continue
        echo "glassine-deploy: goes down: $n $v -> $nv"
        down=1
    done <<EOF
$(awk 'FILENAME == ARGV[1] { r[$1] = $2; next } ($1 in r) && r[$1] != $2 { print $1, $2, r[$1] }' "$t/ri" "$t/vi")
EOF
    if [ -n "$down" ] && [ "$ACCEPT_DOWN" != 1 ]; then
        fail 7 "these packages would go down in version; nothing staged. --accept-downgrades takes them, or stay on this base until a newer one"
    fi
    if [ -n "$TMP_VIEW" ]; then umount "$TMP_VIEW" && rmdir "$TMP_VIEW"; TMP_VIEW=''; fi
    rm -rf "$t"; REPLAY_TMP=''
}

# replay_space_check: refuses (exit 5, nothing staged) when userdata has less
# free space than the replay is likely to need: what the user's packages take in
# the current deployment (its build layer and the package directories of its
# switch layer), a quarter more for the downloads, and 16 MiB. An estimate, not
# a promise: a replay that still runs out of space removes what it made.
replay_space_check() {
    _rc_d=$UD/deployments/$cur
    _rc_k=$(du -sk "$_rc_d/build" "$_rc_d/switch/usr" "$_rc_d/switch/lib" "$_rc_d/switch/bin" "$_rc_d/switch/sbin" "$_rc_d/switch/opt" 2>/dev/null |
        awk '{ s += $1 } END { print s + 0 }')
    _rc_need=$((_rc_k + _rc_k / 4 + 16384))
    _rc_avail=$(df -Pk "$UD" | awk 'NR == 2 { print $4 }')
    [ "${_rc_avail:-0}" -ge "$_rc_need" ] ||
        fail 5 "not enough space on userdata for the replay: about ${_rc_need} KiB needed, ${_rc_avail:-?} KiB free; nothing staged (glassine-deploy list shows what takes space; remove ID frees a deployment)"
}

# stage_new: a new deployment on $base (kind, carry set) becomes the staged one;
# --now switches at once. Needs state_open_rw + UD, cur.
stage_new() {
    gc_deployments
    [ "$kind" = update ] && [ "$NOREPLAY" = 0 ] && replay_space_check
    id=$(new_id)
    NEW_DEP=$UD/deployments/$id
    mkdir -p "$NEW_DEP/build" "$NEW_DEP/switch" "$NEW_DEP/work" || die "cannot create $NEW_DEP"
    printf 'base=%s\nkind=%s\ncarry=%s\nfrom=%s\ncreated=%s\n' "$base" "$kind" "$carry" "$cur" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" |
        gs_write "$NEW_DEP/meta" || die "cannot write $NEW_DEP/meta"
    [ "$kind" = update ] && do_replay
    sync
    old=$(gs_kv "$S/deploy" staged)
    gs_update "$S/deploy" "staged=$id" || die "cannot write $S/deploy"
    NEW_DEP=''
    [ -n "$old" ] && [ "$old" != "$id" ] && { dep_remove "$old" || :; }
    if [ "$NOW" = 1 ]; then
        do_switch
    else
        loader_publish "$SYSTEM_MNT" locked
        if [ "$carry" = none ]; then
            echo "glassine-deploy: $id ($kind${cur:+ of $cur}, base $base) is staged; the next shutdown selects it, with no settings carried over"
        else
            echo "glassine-deploy: $id ($kind of $cur, base $base) is staged; the next shutdown carries the settings over and selects it"
        fi
    fi
}

# do_switch: the staged deployment gets a fresh switch layer with what its
# meta carry= says, then becomes the candidate. Needs state_open_rw + UD.
do_switch() {
    id=$(gs_kv "$S/deploy" staged)
    [ -n "$id" ] || { echo "glassine-deploy: nothing staged"; return 0; }
    nd=$UD/deployments/$id
    [ -r "$nd/meta" ] || die "staged deployment $id is missing on userdata"
    # one trial at a time: it switches at a later shutdown
    _kc=$(gs_kernel_candidate "$S/kernel")
    [ -z "$_kc" ] || { echo "glassine-deploy: a kernel candidate ($_kc) is set: $id stays staged"; return 0; }
    cur=$(gs_kv "$S/deploy" current)
    mkdir -p "$RUN_DIR" && : > "$RUN_DIR/switching" || die "cannot create $RUN_DIR/switching"
    SWITCHING=$RUN_DIR/switching
    # always from scratch: an interrupted switch left an unknown part behind
    rm -rf "$nd/switch" "$nd/work" && mkdir -p "$nd/switch" "$nd/work" || die "cannot clear $nd/switch"
    case "$(gs_kv "$nd/meta" carry)" in
    none) ;;
    migrate)
        [ -n "$cur" ] || die "no current deployment to carry from"
        # the running deployment (the shutdown hook): a plain bind of its own
        # root (the merged overlay without what is mounted on top; a second
        # overlay on a live upper is undefined in overlayfs, and OpenRC has
        # unmounted RUN_DIR/root by then); otherwise (recovery) a read-only view
        TMP_VIEW=$RUN_DIR/view.$$
        mkdir -p "$TMP_VIEW" || die "cannot create $TMP_VIEW"
        if [ "$(cat "$RUN_DIR/booted" 2>/dev/null)" = "$cur" ]; then
            mount --bind "${GLASSINE_DEPLOY_ROOT:-/}" "$TMP_VIEW" && mount -o remount,bind,ro "$TMP_VIEW" ||
                die "cannot bind the running root"
        else
            gr_merged_ro "$SYSTEM_MNT" "$UD/deployments/$cur" "$TMP_VIEW" || die "cannot open deployment $cur read-only"
        fi
        view=$TMP_VIEW
        nb=$(gs_kv "$nd/meta" base)
        nbv=''; [ -n "$nb" ] && nbv=$SYSTEM_MNT/bases/$nb
        switch_space "$view" "$nbv" || fail 5 "not enough space on userdata: ${need} KiB needed, ${avail:-?} KiB free; $id stays staged"
        for p in $(migrate_paths "$view" "$nbv"); do
            copy_path "$view" "$nd/switch" "$p" || die "copying $p failed; $id stays staged"
        done
        # the accounts: the new deployment's lower /etc (its build layer over
        # its base) merged with the old one's; carried files follow moved IDs
        # (each file by itself: the build layer holds only what the replay changed)
        ne=$RUN_DIR/newetc.$$
        [ -n "$nb" ] && [ -r "$SYSTEM_MNT/bases/$nb/etc/passwd" ] || die "deployment $id: base ${nb:-?} has no /etc/passwd; $id stays staged"
        NEW_ETC=$ne
        ga_lower "$ne" "$nd/build/etc" "$SYSTEM_MNT/bases/$nb/etc" || die "cannot read the new deployment's accounts; $id stays staged"
        [ -r "$ne/passwd" ] || die "deployment $id has no /etc/passwd; $id stays staged"
        [ -d "$nd/switch/etc" ] || { mkdir "$nd/switch/etc" && chown "$(stat -c %u:%g "$view/etc")" "$nd/switch/etc" &&
            chmod "$(stat -c %a "$view/etc")" "$nd/switch/etc"; } || die "cannot create $nd/switch/etc"
        echo "glassine-deploy: accounts (base $nb + $cur's users)"
        ga_merge "$view/etc" "$ne" "$nd/switch/etc" "$nd/idmap" || die "the account merge failed; $id stays staged"
        moved=$(ga_kept_moves "$nd/idmap")
        [ -z "$moved" ] || die "kept accounts would change ID ($moved) because the new base has accounts at those IDs; /home is outside the deployments and would keep the old owners, and a fallback to $cur would find it changed. Nothing is switched; $id stays staged (stage another base, or free the IDs)"
        ga_remap "$nd/idmap" "$nd/switch" || die "the owner remap failed; $id stays staged"
        rm -f "$nd/idmap"
        umount "$TMP_VIEW" && rmdir "$TMP_VIEW"; TMP_VIEW=''
        ;;
    *) die "deployment $id: unknown carry=$(gs_kv "$nd/meta" carry)" ;;
    esac
    sync
    gs_update "$S/deploy" staged= "candidate=$id" tries=2 || die "cannot write $S/deploy"
    rm -f "$SWITCHING"; SWITCHING=''
    if [ -n "$cur" ]; then
        echo "glassine-deploy: $id boots next (2 tries, then $cur again)"
    else
        echo "glassine-deploy: $id boots next (2 tries, then a bare boot again)"
    fi
    gc_deployments
    loader_publish "$SYSTEM_MNT" locked
}

# switch: the shutdown hook's step (after services stop; the hook decides
# whether this shutdown may switch: started by the user, on the charger or
# with enough battery; docs/deployments.md)
cmd_switch() {
    state_open_rw
    [ -n "$(gs_kv "$S/deploy" staged)" ] || { echo "glassine-deploy: nothing staged"; return 0; }
    ud_open_rw
    do_switch
}

# --- restart (specs/013, docs/deployments.md "Restart") ------------------------
# restart_decide: what a restart now would be (013 FR-001, FR-006, FR-012), with
# nothing written. Sets RW (empty: soft, else the reason word), TARGET (the
# deployment the incoming session would start), SW (yes|no: would the switch run),
# SW_WHY (nothing-staged, kernel-candidate, battery, space, once: a start by
# request switches nothing). ONCE_ID: restart --once ID. quick (status): without
# the space check, which copies nothing but walks the migrate list. Exit 3 on a
# newer state format.
restart_decide() {
    RW='' TARGET='' SW=no SW_WHY=nothing-staged
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    _rs_st=''
    [ "$FMT" = none ] || [ -z "$SYS_DIR" ] || _rs_st=$(gs_kv "$SYS_DIR/state/deploy" staged)
    if [ -n "$_rs_st" ]; then
        if [ -n "$ONCE_ID" ]; then SW_WHY=once
        elif [ -n "$(gs_kernel_candidate "$SYS_DIR/state/kernel")" ]; then SW_WHY=kernel-candidate
        elif ! gs_power_ok "${GLASSINE_POWER_SUPPLY:-/sys/class/power_supply}" "${SWITCH_MIN_CAPACITY:-30}"; then SW_WHY=battery
        elif [ "${1:-}" != quick ] && ! restart_space "$_rs_st"; then SW_WHY=space
        else SW=yes SW_WHY=''
        fi
    fi
    if [ "${SOFT_RESTART:-yes}" = no ]; then RW=off; return 0; fi
    if [ "$FMT" = none ] || [ ! -e "$RUN_DIR/booted" ] || ! ud_mounted; then RW=plain; return 0; fi
    _rs_s=$SYS_DIR/state
    if [ -n "$ONCE_ID" ]; then TARGET=$ONCE_ID
    elif [ $SW = yes ]; then TARGET=$_rs_st
    else TARGET=$(gr_would_pick "$_rs_s")
    fi
    _rs_t=$TARGET
    [ -n "$ONCE_ID" ] || _rs_t="$TARGET $(gs_kv "$_rs_s/deploy" current) $(gs_kv "$_rs_s/deploy" previous)"
    RW=$(gs_restart_word "$RUN_DIR" "$SYS_DIR" "$USERDATA_MNT/$USERDATA_PREFIX" "${GLASSINE_DEPLOY_CMDLINE:-/proc/cmdline}" \
        "${GLASSINE_UNAME:-$(uname -r)}" "$_rs_t" "$RUN_DIR/kept")
    [ -z "$RW" ] || return 0
    _rs_m=${GLASSINE_LOADER_MARK:-/usr/sbin/glassine-loader-mark}
    if [ -x "$_rs_m" ]; then
        RW=$("$_rs_m" restart-check 2>/dev/null | head -n 1)
        case $RW in *[!a-z-]*) RW=loader-unreadable ;; esac
        [ -z "$RW" ] || return 0
    fi
    restart_init_ok || RW=init
}

# restart_space STAGED: the switch's space check on the running root, as the switch
# will do it (a plain bind of the live root); 1 = not enough
restart_space() {
    ud_mounted || return 0
    _rs_nb=$(gs_kv "$USERDATA_MNT/$USERDATA_PREFIX/deployments/$1/meta" base)
    [ "$(gs_kv "$USERDATA_MNT/$USERDATA_PREFIX/deployments/$1/meta" carry)" = migrate ] || return 0
    _rs_v=${GLASSINE_DEPLOY_ROOT:-/}
    if [ -z "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ]; then
        TMP_VIEW=$RUN_DIR/view.$$
        mkdir -p "$TMP_VIEW" && mount --bind "$_rs_v" "$TMP_VIEW" && mount -o remount,bind,ro "$TMP_VIEW" ||
            { rmdir "$TMP_VIEW" 2>/dev/null; TMP_VIEW=''; return 0; }
        _rs_v=$TMP_VIEW
    fi
    switch_space "$_rs_v" "${_rs_nb:+$SYSTEM_MNT/bases/$_rs_nb}"; _rs_r=$?
    if [ -n "$TMP_VIEW" ]; then umount "$TMP_VIEW" && rmdir "$TMP_VIEW"; TMP_VIEW=''; fi
    return $_rs_r
}

# restart_init_ok: PID 1 can hand over to the kept assembly: busybox init whose
# inittab names the soft start as its restart action (docs/deployments.md, "What
# the system needs")
restart_init_ok() {
    [ -z "${GLASSINE_DEPLOY_INIT_OK:-}" ] || { [ "$GLASSINE_DEPLOY_INIT_OK" = 1 ]; return; }
    case $(readlink /proc/1/exe 2>/dev/null) in */busybox) ;; *) return 1 ;; esac
    [ -x "$SOFT_START" ] || return 1
    grep -qx "::restart:$SOFT_START" "${GLASSINE_INITTAB:-/etc/inittab}" 2>/dev/null
}

# restart_report: restart --check's fields
restart_report() {
    if [ -z "$RW" ]; then out restart soft; out restart_reason ''; else out restart cold; out restart_reason "$RW"; fi
    out restart_target "$TARGET"
    out switch "$SW"
    out switch_reason "$SW_WHY"
}

# restart_cold: the orderly restart through the firmware, user-started (the switch
# rule applies at its shutdown, 013 FR-009)
restart_cold() {
    echo "glassine-deploy: restarting${1:+ ($1)}"
    "$SWITCH_HOOK" --user-shutdown || echo "glassine-deploy: the user-shutdown mark not written" >&2
    cleanup
    exec ${GLASSINE_DEPLOY_REBOOT:-reboot}
}

cmd_restart() {
    case "$RS_MODE" in
    check)
        restart_decide
        out type restart
        restart_report
        [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
        emit
        [ -z "$RW" ] && return 0
        return 9
        ;;
    cold)
        [ -z "$ONCE_ID" ] || fail 2 "--once starts a deployment by a soft restart; it doesn't go with --cold"
        system_open || die "cannot mount $SYSTEM_DEV read-only"
        format_check
        restart_cold
        ;;
    esac
    if [ -n "$ONCE_ID" ]; then
        valid_name "$ONCE_ID" || fail 2 "not a deployment id: $ONCE_ID"
        require_migrated
        ud_mounted && [ -r "$USERDATA_MNT/$USERDATA_PREFIX/deployments/$ONCE_ID/meta" ] || die "no deployment $ONCE_ID on userdata"
        [ "$ONCE_ID" != "$(gs_kv "$SYS_DIR/state/deploy" staged)" ] || die "$ONCE_ID is staged: it starts by a switch (restart), not by request"
        _ro_b=$(gs_kv "$USERDATA_MNT/$USERDATA_PREFIX/deployments/$ONCE_ID/meta" base)
        [ -n "$_ro_b" ] && [ -d "$SYS_DIR/bases/$_ro_b" ] || die "deployment $ONCE_ID cannot start: its base ${_ro_b:-?} is not on the system partition"
        case $(gs_covers "$SYS_DIR" "$SYS_DIR/bases/$_ro_b" "${GLASSINE_UNAME:-$(uname -r)}") in
        '') ;;
        *) fail 8 "deployment $ONCE_ID is not covered by the running kernel $(uname -r) (its base needs what the kernel doesn't provide, or its modules are missing)" ;;
        esac
    fi
    restart_decide
    if [ -n "$RW" ]; then
        [ "$RS_MODE" != soft ] && [ -z "$ONCE_ID" ] || fail 9 "the restart would not be soft ($RW): nothing stopped"
        restart_cold "$RW"
    fi
    # phase 1 ends here (013 FR-021): the switch's space, the hibernate step's lock
    [ "$SW_WHY" != space ] || fail 5 "not enough space on userdata for the switch of $(gs_kv "$SYS_DIR/state/deploy" staged): ${need:-?} KiB needed, ${avail:-?} KiB free; nothing stopped"
    state_open_rw
    [ ! -e "$RUN_DIR/restarting" ] || fail 6 "busy: a restart is running already"
    _rs_c=$(gs_kv "$RUN_DIR/restart" count)
    case $_rs_c in ''|*[!0-9]*) _rs_c=0 ;; esac
    _rs_sd=$(awk -v m="$SYSTEM_MNT" '$2 == m { print $1; exit }' /proc/mounts)
    _rs_ud=$(awk -v m="$USERDATA_MNT" '$2 == m { print $1; exit }' /proc/mounts)
    [ -n "$_rs_sd" ] && [ -n "$_rs_ud" ] || [ -n "${GLASSINE_DEPLOY_FAKE_MOUNTS:-}" ] ||
        die "the system partition or userdata is not mounted where deploy.conf says: nothing stopped"
    printf 'from=%s\nonce=%s\ncount=%s\nsysdev=%s\nuddev=%s\nprefix=%s\nlimit=%s\n' \
        "$(cat "$RUN_DIR/booted")" "$ONCE_ID" "$((_rs_c + 1))" "$_rs_sd" "$_rs_ud" "$USERDATA_PREFIX" \
        "${RESTART_LIMIT_S:-20}" > "$RUN_DIR/restarting.new" && mv -f "$RUN_DIR/restarting.new" "$RUN_DIR/restarting" ||
        die "cannot write $RUN_DIR/restarting: nothing stopped"
    cleanup
    # phase 2 (013 FR-021): from here the restart ends in the incoming session or a
    # cold restart; this command doesn't return
    if ! "$SWITCH_HOOK" --user-shutdown; then
        rm -f "$RUN_DIR/restarting"; die "the user-shutdown mark not written: nothing stopped"
    fi
    echo "glassine-deploy: soft restart into ${ONCE_ID:-$TARGET}"
    rm -f "$RUN_DIR/switch-result"
    if [ -n "${GLASSINE_DEPLOY_SIGNAL_INIT:-}" ]; then "$GLASSINE_DEPLOY_SIGNAL_INIT"
    else kill -HUP 1 && sleep 1 && kill -QUIT 1
    fi
    # the session's stop ends this process; one that is still here after
    # RESTART_INIT_S seconds means PID 1 didn't act on the signal: restart cold
    # (in the background: a TERM to this shell ends the wait at once, its trap exits)
    sleep "${RESTART_INIT_S:-60}" & wait $!
    rm -f "$RUN_DIR/restarting"
    echo "glassine-deploy: PID 1 did not start the soft restart: restarting cold" >&2
    echo init > "$USERDATA_MNT/$USERDATA_PREFIX/restart.cold" 2>/dev/null
    exec ${GLASSINE_DEPLOY_REBOOT:-reboot}
}

# subvol_received DIR: DIR is a read-only subvolume with a received UUID
subvol_received() {
    [ "$(btrfs property get -ts "$1" ro 2>/dev/null)" = ro=true ] || return 1
    btrfs subvolume show "$1" 2>/dev/null | grep -q 'Received UUID:[[:space:]]*[0-9a-f]'
}

cmd_receive() {
    [ "$BOOT" = 1 ] && { cmd_receive_boot; return; }
    command -v btrfs >/dev/null || die "receive needs btrfs (btrfs-progs)"
    sub=bases; [ "$MODULES" = 1 ] && sub=modules
    if [ "$ARG" != - ]; then
        [ -r "$ARG" ] || die "cannot read $ARG"
        if [ -n "$SHA" ]; then
            have=$(sha256sum "$ARG" | cut -d ' ' -f 1)
            [ "$have" = "$SHA" ] || die "$ARG: sha256 $have, expected $SHA"
        fi
        case "$ARG" in *.zst) command -v zstd >/dev/null || die "a .zst stream needs zstd" ;; esac
    else
        [ -z "$SHA" ] || fail 2 "--sha256 needs a file, not -"
    fi
    state_open_rw
    # straight into bases/ (modules/): a read-only subvolume cannot be renamed
    # (and clearing ro would drop its received UUID); a stream for a name that
    # exists fails in btrfs receive itself
    d=$SYSTEM_MNT/$sub
    mkdir -p "$d" || die "cannot create $d"
    RECV_BEFORE=$(for n in "$d"/*; do [ -e "$n" ] && echo "${n##*/}"; done)
    RECV_TMP=$d
    case "$ARG" in
    -) btrfs -q receive "$d" ;;
    *.zst) zstd -dcq "$ARG" | btrfs -q receive "$d" ;;
    *) btrfs -q receive -f "$ARG" "$d" ;;
    esac || die "btrfs receive failed (a name that exists already, a cut stream or a missing parent); nothing kept"
    new=''
    for n in "$d"/*; do
        [ -e "$n" ] || continue
        printf '%s\n' "$RECV_BEFORE" | grep -qxF -- "${n##*/}" || new="$new ${n##*/}"
    done
    # shellcheck disable=SC2086  # a name with a space fails valid_name below
    set -- $new
    [ $# = 1 ] || die "the stream held $# subvolumes, expected one; nothing kept"
    name=$1
    valid_name "$name" || die "received subvolume name '$name' is not valid; nothing kept"
    subvol_received "$d/$name" || die "$name is not read-only with a received UUID; nothing kept"
    sync
    RECV_TMP=''
    echo "glassine-deploy: received $sub/$name"
}

# --- boot/ files (docs/kernel-artifacts.md, "On the system partition") ---------
# boot_kind NAME.EXT: initramfs or dtb by the file's name, empty for neither
boot_kind() {
    case "${1##*/}" in *.cpio.gz) echo initramfs ;; *.dtb) echo dtb ;; esac
}

# boot_sha FILE: its sha256, read from the disk (O_DIRECT where the file system
# allows it: a read-back after a cached write must not see the page cache only)
boot_sha() {
    if dd if="$1" of=/dev/null bs=4096 count=1 iflag=direct 2>/dev/null; then
        _bz=$(wc -c < "$1")
        dd if="$1" bs=4096 iflag=direct 2>/dev/null | head -c "$_bz" | sha256sum | cut -d ' ' -f 1
    else
        sha256sum "$1" | cut -d ' ' -f 1
    fi
}

# boot_put SRC DEST SHA: SRC to DEST through DEST.new: written with fsync, read
# back against SHA, renamed, synced. A failure leaves DEST as it was and no .new.
boot_put() {
    rm -f "$2.new"
    if dd if="$1" of="$2.new" bs=1M conv=fsync 2>/dev/null; then
        if [ "${GLASSINE_DEPLOY_TEST:-}" = 1 ] && [ -n "${GLASSINE_DEPLOY_AFTER_BOOTNEW:-}" ]; then
            ( set -- "$2.new"; eval "$GLASSINE_DEPLOY_AFTER_BOOTNEW" )
        fi
        sync
        if [ "$(boot_sha "$2.new")" = "$3" ] && mv -f "$2.new" "$2" && sync; then
            return 0
        fi
        echo "glassine-deploy: ${2##*/}: the read-back does not match what was written" >&2
    else
        echo "glassine-deploy: ${2##*/}: the write failed" >&2
    fi
    rm -f "$2.new"
    return 1
}

# boot_check FILE KIND MANIFEST: FILE is the boot/ file its name says it is
# (identity = content): prints its sha256, or dies naming the mismatch
boot_check() {
    _bn=${1##*/}
    case $2 in initramfs) _bn=${_bn%.cpio.gz} ;; dtb) _bn=${_bn%.dtb} ;; esac
    _bl=${_bn%@*} _bi=${_bn##*@}
    case "$_bn" in ?*@?*) case "$_bn" in *@*@*) die "$1: not a boot/ name (one @)" ;; esac ;;
    *) die "$1: not a boot/ name (DEVICE@ID or COMMIT12@ID)" ;; esac
    case "$_bi" in *[!0-9a-f]*) die "$1: the id '$_bi' is not 16 hex digits" ;; esac
    [ ${#_bi} = 16 ] || die "$1: the id '$_bi' is not 16 hex digits"
    if [ $2 = initramfs ]; then
        case "$_bl" in *[!0-9a-f]*) die "$1: the commit '$_bl' is not 12 hex digits" ;; esac
        [ ${#_bl} = 12 ] || die "$1: the commit '$_bl' is not 12 hex digits"
    else
        case "$_bl" in .*|*[!A-Za-z0-9._+-]*) die "$1: bad device name '$_bl'" ;; esac
    fi
    [ -r "$3" ] || die "$1: no manifest ${3##*/} beside it"
    _bf=$(gs_kv "$3" format)
    case "$_bf" in 1) ;; ''|*[!0-9]*) die "${3##*/}: no format=1" ;; *) fail 3 "${3##*/} has format $_bf, newer than this tool (1)" ;; esac
    _bs=$(sha256sum "$1" | cut -d ' ' -f 1)
    [ -z "$SHA" ] || [ "$_bs" = "$SHA" ] || die "$1: sha256 $_bs, expected $SHA"
    [ "$(gs_kv "$3" sha256)" = "$_bs" ] || die "$1: sha256 $_bs, its manifest says $(gs_kv "$3" sha256); nothing changed"
    [ "$_bi" = "$(printf '%.16s' "$_bs")" ] || die "$1: the name's id $_bi is not the content's $(printf '%.16s' "$_bs"); nothing changed"
    if [ $2 = initramfs ]; then
        _bc=$(gs_kv "$3" commit)
        case "$_bc" in "$_bl"*) ;; *) die "$1: the name's commit $_bl is not the manifest's commit '$_bc'; nothing changed" ;; esac
    else
        [ "$(gs_kv "$3" device)" = "$_bl" ] || die "$1: the name's device $_bl is not the manifest's device '$(gs_kv "$3" device)'; nothing changed"
    fi
    echo "$_bs"
}

# boot_sweep: the .new files a cut receive left in boot/ (never complete,
# never read). Needs state_open_rw.
boot_sweep() {
    for _bw in "$SYSTEM_MNT"/boot/dtb/*.new "$SYSTEM_MNT"/boot/initramfs/*.new; do
        [ -e "$_bw" ] || continue
        rm -f "$_bw" && echo "glassine-deploy: removed ${_bw#"$SYSTEM_MNT"/}, a cut receive's"
    done
}

# receive --boot FILE: a device tree (.dtb) or initramfs (.cpio.gz) with its
# manifest beside it (NAME.manifest) into boot/dtb/ or boot/initramfs/. The file
# first, its manifest last, each .new, fsynced, read back, renamed: a cut receive
# leaves the old state or the file without its manifest, which a receive again
# completes. A name that is there with the same bytes is a no-op; with other
# bytes it is refused (a boot/ file never changes).
cmd_receive_boot() {
    [ "$ARG" != - ] || fail 2 "--boot takes a file, not -"
    [ "$MODULES" = 0 ] || fail 2 "--boot and --modules: one or the other"
    kind=$(boot_kind "$ARG")
    [ -n "$kind" ] || fail 2 "$ARG: --boot takes a <device>@<id>.dtb or a <commit12>@<id>.cpio.gz"
    [ -r "$ARG" ] || die "cannot read $ARG"
    case $kind in initramfs) name=${ARG##*/}; name=${name%.cpio.gz}; src=${ARG%.cpio.gz}.manifest ;;
    dtb) name=${ARG##*/}; name=${name%.dtb}; src=${ARG%.dtb}.manifest ;; esac
    sha=$(boot_check "$ARG" $kind "$src") || exit $?
    state_open_rw
    d=$SYSTEM_MNT/boot/$kind
    mkdir -p "$d" || die "cannot create $d"
    boot_sweep
    f=$d/${ARG##*/} m=$d/$name.manifest
    if [ -e "$f" ]; then
        [ "$(boot_sha "$f")" = "$sha" ] || die "boot/$kind/${f##*/} is there with other bytes; nothing changed (a boot/ file never changes)"
    fi
    if [ -e "$m" ]; then
        cmp -s "$m" "$src" || die "boot/$kind/$name.manifest is there and differs from ${src##*/}; nothing changed"
        if [ -e "$f" ]; then
            echo "glassine-deploy: boot/$kind/$name is there already"
            return 0
        fi
    fi
    [ -e "$f" ] || boot_put "$ARG" "$f" "$sha" || die "receiving boot/$kind/${f##*/} failed; nothing kept"
    [ -e "$m" ] || boot_put "$src" "$m" "$(sha256sum "$src" | cut -d ' ' -f 1)" ||
        die "receiving boot/$kind/$name.manifest failed (boot/$kind/${f##*/} stays; receive it again)"
    echo "glassine-deploy: received boot/$kind/$name"
}

# boot_prune: boot/ files no kernel record names (docs/kernel-artifacts.md):
# not named by any image record in state/bootimg/ (dtb=, initramfs=) nor by
# state/kernel's deferred_dtb or deferred_initramfs, and received before the
# last install (the file's time is older than the newest record's staged=), so
# a file received for an install that hasn't run stays. A record that can't be
# read removes nothing. Needs state_open_rw. Prints what it removed.
boot_prune() {
    [ -d "$SYSTEM_MNT/boot" ] || return 0
    _bk=" $(gs_kv "$S/kernel" deferred_dtb) $(gs_kv "$S/kernel" deferred_initramfs) " _blast=''
    for _br in "$S"/bootimg/*.manifest; do
        [ -e "$_br" ] || continue
        [ -r "$_br" ] || { echo "glassine-deploy: cannot read ${_br#"$SYSTEM_MNT"/}; no boot/ file removed" >&2; return 0; }
        _bst=$(gs_kv "$_br" staged)
        case "$_bst" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;
        *) echo "glassine-deploy: ${_br#"$SYSTEM_MNT"/} has no staged time; no boot/ file removed" >&2; return 0 ;; esac
        # YYYYMMDDHHMMSS as a number: the order of the times
        _bsn=$(printf '%s' "$_bst" | tr -d 'TZ:-')
        [ "$_bsn" -gt "${_blast:-0}" ] && _blast=$_bsn
        _bk="$_bk$(gs_kv "$_br" dtb) $(gs_kv "$_br" initramfs) "
    done
    [ -n "$_blast" ] || return 0
    for _bf in "$SYSTEM_MNT"/boot/dtb/*.dtb "$SYSTEM_MNT"/boot/initramfs/*.cpio.gz; do
        [ -e "$_bf" ] || continue
        _bn=${_bf##*/}; _bn=${_bn%.dtb}; _bn=${_bn%.cpio.gz}
        case "$_bk" in *" $_bn "*) continue ;; esac
        # a record from before the id names the initramfs by its bare commit
        case "$_bf" in */initramfs/*) case "$_bk" in *" ${_bn%@*} "*) continue ;; esac ;; esac
        [ "$(date -u -r "$_bf" +%Y%m%d%H%M%S)" -lt "$_blast" ] || continue
        # the manifest first: a cut removal leaves a file no record names, which
        # the next prune removes (never a manifest without its file)
        rm -f "${_bf%/*}/$_bn.manifest" && rm -f "$_bf" || { echo "glassine-deploy: cannot remove $_bf" >&2; continue; }
        echo "glassine-deploy: removed ${_bf#"$SYSTEM_MNT"/}, which no kernel record names"
    done
    sync
}

cmd_bases() {
    system_open || die "cannot mount $SYSTEM_DEV read-only"
    format_check
    [ "$FMT" = none ] && die "the system partition is not migrated (no state/)"
    # base -> deployments using it, from the metas on userdata
    users=''
    for id in $(ud_dirs deployments); do
        b=$(meta_kv "$(ud_cat "deployments/$id/meta")" base)
        [ -n "$b" ] && users="$users$b $id
"
    done
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    [ "$PORC" = 1 ] || printf '%-8s %-40s %s\n' KIND NAME USED_BY
    for k in bases modules; do
        for d in "$SYS_DIR/$k"/*; do
            [ -d "$d" ] || continue
            n=${d##*/}; u=''
            [ $k = bases ] && u=$(printf '%s' "$users" | awk -v b="$n" '$1 == b { printf "%s%s", s, $2; s = "," }')
            if [ "$PORC" = 1 ]; then
                out type base; out kind "${k%s}"; out name "$n"; out used_by "$u"; emit
            else
                printf '%-8s %-40s %s\n' "${k%s}" "$n" "$u"
            fi
        done
    done
}

# pkg_db FILE: "name version" per package of an apk installed database
cmd_bases_remove() {
    [ "$FIRST" = remove ] || usage
    valid_name "$ARG" || fail 2 "not a base name: $ARG"
    state_open_rw
    d=$SYSTEM_MNT/bases/$ARG
    [ -d "$d" ] || die "no base $ARG on the system partition"
    # who needs it, from the metas on userdata; unreadable metas must not read
    # as "nobody": the current deployment has to be there, with its base
    cur=$(gs_kv "$S/deploy" current)
    curb=$(meta_kv "$(ud_cat "deployments/$cur/meta" 2>/dev/null)" base)
    [ -n "$curb" ] || die "cannot read the deployments on userdata; nothing removed"
    needed=" $cur $(gs_kv "$S/deploy" candidate) $(gs_kv "$S/deploy" staged) $(cat "$RUN_DIR/booted" 2>/dev/null) "
    lose=''
    for id in $(ud_dirs deployments); do
        [ "$(meta_kv "$(ud_cat "deployments/$id/meta")" base)" = "$ARG" ] || continue
        case "$needed" in *" $id "*) die "base $ARG is in use by deployment $id; nothing removed" ;; esac
        lose="$lose $id"
    done
    if [ -n "$lose" ]; then
        prev=$(gs_kv "$S/deploy" previous)
        note=''
        case " $lose " in *" $prev "*) note=" Rollback to $prev is lost." ;; esac
        confirm "Remove base $ARG? Deployments that can no longer boot:$lose.$note"
    fi
    btrfs -q subvolume delete --commit-after "$d" >/dev/null || die "cannot delete $d"
    # the space comes back once the cleaner has dropped the subvolume
    btrfs -q subvolume sync "$SYSTEM_MNT" >/dev/null 2>&1 || :
    echo "glassine-deploy: base $ARG removed"
    boot_prune
}

pkg_db() { awk -F: '$1 == "P" { p = $2 } $1 == "V" && p != "" { print p " " $2; p = "" }' "$1" 2>/dev/null | sort; }
# pkg_world FILE: the world entries, one per line, sorted
pkg_world() { tr ' ' '\n' < "$1" 2>/dev/null | sed '/^$/d' | sort -u; }

cmd_packages() {
    require_migrated
    id=$ARG; [ -n "$id" ] || id=$(gs_kv "$SYS_DIR/state/deploy" current)
    valid_name "$id" || fail 2 "not a deployment id: $id"
    base=$(meta_kv "$(ud_cat "deployments/$id/meta")" base)
    [ -n "$base" ] || die "no deployment $id on userdata (or its meta names no base)"
    bd=$SYS_DIR/bases/$base
    [ -d "$bd" ] || die "deployment $id: base $base is missing"
    # the deployment's merged root: the running one itself, else a read-only view
    if [ "$(cat "$RUN_DIR/booted" 2>/dev/null)" = "$id" ]; then
        view=${GLASSINE_DEPLOY_ROOT:-/}
    else
        ud_mounted || die "userdata is not mounted; packages of a deployment that is not running need it mounted"
        TMP_VIEW=$RUN_DIR/view.$$
        mkdir -p "$TMP_VIEW" && gr_merged_ro "$SYS_DIR" "$USERDATA_MNT/$USERDATA_PREFIX/deployments/$id" "$TMP_VIEW" ||
            die "cannot open deployment $id read-only"
        view=$TMP_VIEW
    fi
    t=${TMPDIR:-/tmp}/glassine-pkg.$$
    mkdir -p "$t" || die "cannot create $t"
    pkg_world "$bd/etc/apk/world" > "$t/bw"; pkg_world "$view/etc/apk/world" > "$t/vw"
    pkg_db "$bd/lib/apk/db/installed" > "$t/bi"; pkg_db "$view/lib/apk/db/installed" > "$t/vi"
    apk=${GLASSINE_DEPLOY_APK:-/sbin/apk}; [ -x "$apk" ] || apk=''
    [ "$PORC" = 1 ] && echo "glassine-deploy $PORCELAIN_VERSION"
    awk 'f == 1 { b[$0] = 1; next } !($0 in b)' f=1 "$t/bw" f=2 "$t/vw" | while read -r e; do
        if [ "$PORC" = 1 ]; then out type package; out change added; out entry "$e"; emit; else echo "added    $e"; fi
    done
    awk 'f == 1 { v[$0] = 1; next } !($0 in v)' f=1 "$t/vw" f=2 "$t/bw" | while read -r e; do
        if [ "$PORC" = 1 ]; then out type package; out change removed; out entry "$e"; emit; else echo "removed  $e"; fi
    done
    awk 'f == 1 { b[$1] = $2; next } ($1 in b) && b[$1] != $2 { print $1, $2, b[$1] }' f=1 "$t/bi" f=2 "$t/vi" |
    while read -r n v bv; do
        c=changed
        if [ -n "$apk" ]; then
            case $("$apk" version -t "$v" "$bv" 2>/dev/null) in '>') c=raised ;; '<') c=lowered ;; esac
        fi
        if [ "$PORC" = 1 ]; then
            out type package; out change "$c"; out name "$n"; out version "$v"; out base_version "$bv"; emit
        else
            printf '%-8s %s %s (base %s)\n' "$c" "$n" "$v" "$bv"
        fi
    done
    rm -rf "$t"
}

cmd_accept() {
    case "$ARG" in ''|.*|*[!A-Za-z0-9._-]*) fail 2 "not a deployment id: $ARG" ;; esac
    state_open_rw
    cur=$(gs_kv "$S/deploy" current)
    [ "$ARG" = "$cur" ] && return 0
    [ "$ARG" = "$(gs_kv "$S/deploy" candidate)" ] || die "$ARG is not the candidate"
    gs_update "$S/deploy" "previous=$cur" "current=$ARG" candidate= tries=0 || die "cannot write $S/deploy"
    echo "glassine-deploy: $ARG accepted (previous: ${cur:-none})"
    # the clean-up only where userdata is mounted already (the running system):
    # an accept never mounts it for that
    if ud_mounted; then
        UD=$USERDATA_MNT/$USERDATA_PREFIX
        gc_deployments
    fi
    loader_publish "$SYSTEM_MNT" locked
}

cmd_remove() {
    valid_name "$ARG" || fail 2 "not a deployment id: $ARG"
    state_open_rw
    ud_open_rw
    [ -d "$UD/deployments/$ARG" ] || die "no deployment $ARG on userdata"
    for _k in current candidate staged; do
        [ "$ARG" = "$(gs_kv "$S/deploy" $_k)" ] && die "$ARG is the $_k deployment; nothing removed"
    done
    [ "$ARG" = "$(cat "$RUN_DIR/booted" 2>/dev/null)" ] && die "$ARG is the running deployment; nothing removed"
    dep_mounted "$ARG" && die "$ARG is mounted; nothing removed"
    keys=''
    if [ "$ARG" = "$(gs_kv "$S/deploy" previous)" ]; then
        confirm "Remove the previous deployment $ARG? Rollback to $ARG is lost."
        keys=previous=
    fi
    [ "$ARG" = "$(gs_kv "$S/deploy" failed)" ] && keys="$keys failed="
    # the state first: a cut removal then leaves a deployment nothing names,
    # which the next clean-up removes
    # shellcheck disable=SC2086  # one key per word
    [ -z "$keys" ] || gs_update "$S/deploy" $keys || die "cannot write $S/deploy"
    trash_purge
    dep_remove "$ARG" || exit 1
    echo "glassine-deploy: deployment $ARG removed"
    loader_publish "$SYSTEM_MNT" locked
}

# pool_mount DIR: DIR is the top level of a mounted btrfs (a mount point of this
# namespace, file system btrfs, mounted from the file system's root, not a
# subvolume); the last mount on DIR counts
pool_mount() {
    _pm=''
    while read -r _id _par _mm _root _mp _rest; do
        [ "$(printf '%b' "$_mp")" = "$1" ] || continue
        _t=${_rest#* - }; _pm="$_root ${_t%% *}"
    done < "${GLASSINE_DEPLOY_MOUNTINFO:-/proc/self/mountinfo}"
    [ -n "$_pm" ] || die "$1 is not a mount point; init lays out a mounted btrfs (mkfs and the mount are the caller's)"
    [ "${_pm#* }" = btrfs ] || die "$1 is ${_pm#* }, not btrfs"
    [ "${_pm%% *}" = / ] || die "$1 is the subvolume ${_pm%% *}, not the top level of its btrfs"
}

# init POOL_MOUNT: an empty, mounted btrfs becomes a system partition: bases/,
# modules/, state/ (deploy and kernel with nothing set, .lock), with
# --install-marker state/install (format=1, created=): the first start formats
# userdata and selects the first deployment. state/format goes last, so a cut
# init reads as "not migrated". No btrfs-progs needed; runs without deploy.conf.
cmd_init() {
    d=$ARG
    [ -d "$d" ] || die "$d is not a directory"
    d=$(cd "$d" && pwd -P) || die "cannot open $ARG"
    pool_mount "$d"
    [ -z "$(ls -A "$d" 2>/dev/null)" ] || die "$d is not empty; init lays out an empty pool only"
    mkdir "$d/bases" "$d/modules" "$d/state" && : > "$d/state/.lock" || die "cannot write $d"
    gs_lock "$d/state" || fail 6 "busy: $d/state/.lock is held"
    printf 'current=\nprevious=\ncandidate=\ntries=0\nstaged=\nfailed=\n' | gs_write "$d/state/deploy" &&
        printf 'current=\nprevious=\n' | gs_write "$d/state/kernel" || die "cannot write $d/state"
    if [ "$MARKER" = 1 ]; then
        printf 'format=1\ncreated=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" | gs_write "$d/state/install" ||
            die "cannot write $d/state/install"
    fi
    echo "version=$GS_FORMAT_SUPPORTED" | gs_write "$d/state/format" || die "cannot write $d/state/format"
    _note=''; [ "$MARKER" = 1 ] && _note=', install marker'
    echo "glassine-deploy: $d laid out (state format $GS_FORMAT_SUPPORTED$_note)"
}

[ $# -ge 1 ] || usage
CMD=$1; shift
PORC=0 YES=0 DISCARD=0 FULL=0 NOW=0 MODULES=0 BOOT=0 SHA='' ARG='' NARG=0 FIRST='' KGATE=''
NOREPLAY=0 ACCEPT_DOWN=0 WITHOUT='' MARKER=0 RS_MODE='' ONCE_ID='' RESTART=0
while [ $# -gt 0 ]; do
    a=$1; shift
    case "$a" in
    --porcelain) PORC=1 ;;
    --modules) MODULES=1 ;;
    --boot) BOOT=1 ;;
    --sha256) [ $# -ge 1 ] || usage; SHA=$1; shift ;;
    --no-replay) NOREPLAY=1 ;;
    --accept-downgrades) ACCEPT_DOWN=1 ;;
    --without) [ $# -ge 1 ] || usage; WITHOUT="$WITHOUT $1"; shift ;;
    -) ARG=-; NARG=$((NARG + 1)) ;;
    --yes) YES=1 ;;
    --discard-hibernation) DISCARD=1 ;;
    --full) FULL=1 ;;
    --now) NOW=1 ;;
    --install-marker) MARKER=1 ;;
    --check|--soft|--cold) [ -z "$RS_MODE" ] || usage; RS_MODE=${a#--} ;;
    --once) [ $# -ge 1 ] || usage; ONCE_ID=$1; shift ;;
    --restart) RESTART=1 ;;
    -*) usage ;;
    *) [ "$NARG" = 0 ] && FIRST=$a; ARG=$a; NARG=$((NARG + 1)) ;;
    esac
done
# --check/--soft/--cold/--once are restart's; --restart goes with the commands that
# change what starts next (013 FR-009)
case "$CMD" in
restart) [ "$RESTART" = 0 ] || usage ;;
select|rollback|reset|stage) [ -z "$RS_MODE" ] && [ -z "$ONCE_ID" ] || usage ;;
*) [ -z "$RS_MODE" ] && [ -z "$ONCE_ID" ] && [ "$RESTART" = 0 ] || usage ;;
esac
# then_restart: the command, then restart (its exit code when it failed)
then_restart() { [ "$RESTART" = 1 ] || return 0; cleanup; RS_MODE='' cmd_restart; }
case "$CMD:$NARG" in
restart:0) cmd_restart ;;
status:0) cmd_status ;;
list:0) cmd_list ;;
select:1) cmd_select && then_restart ;;
rollback:0) cmd_rollback && then_restart ;;
hibernate-invalidate:0) cmd_hibernate_invalidate ;;
reset:0) cmd_reset && then_restart ;;
stage:1) cmd_stage && then_restart ;;
receive:1) cmd_receive ;;
bases:0) cmd_bases ;;
bases:2) cmd_bases_remove ;;
remove:1) cmd_remove ;;
packages:0|packages:1) cmd_packages ;;
switch:0) cmd_switch ;;
accept:1) cmd_accept ;;
publish:0) cmd_publish ;;
init:1) cmd_init ;;
*) usage ;;
esac
