#!/bin/sh
# glassine-reboot-clean [recovery|bootloader|<reason>] — an orderly reboot WITH a
# reason. busybox `reboot` has init run OpenRC's shutdown (services stopped, the
# file systems read-only) but can't pass a reason; glassine-reboot passes one but
# skips the shutdown, which leaves the root fs dirty. The test boot looks at the
# root fs without replaying its journal, so a dirty root would show it a stale
# file system.
# Here: the reason goes to $GLASSINE_REBOOT_REASON_FILE, then a plain reboot, so
# init runs the whole shutdown; its last service, glassine-reboot-reason (after
# mount-ro and glassine-mount-ro), reboots with the reason. Nothing of this
# script has to outlive the shutdown (its last steps kill what is left and
# unmount from under it). No reason: a plain reboot.
# Exit 1: glassine-reboot-reason isn't in the shutdown runlevel (the reboot would
# lose the reason).
REASON_FILE=${GLASSINE_REBOOT_REASON_FILE:-/run/glassine-reboot.reason}
RUNLEVELS=${GLASSINE_RUNLEVELS:-/etc/runlevels}
INIT_REBOOT=${GLASSINE_INIT_REBOOT:-reboot}
[ -n "$1" ] || exec $INIT_REBOOT
case "$1" in *[!a-z0-9-]*) echo "glassine-reboot-clean: bad reason '$1'" >&2; exit 2 ;; esac
{ [ -e "$RUNLEVELS/shutdown/glassine-reboot-reason" ] || [ -L "$RUNLEVELS/shutdown/glassine-reboot-reason" ]; } ||
	{ echo "glassine-reboot-clean: glassine-reboot-reason is not in the shutdown runlevel" >&2; exit 1; }
printf '%s\n' "$1" > "$REASON_FILE.new" && mv -f "$REASON_FILE.new" "$REASON_FILE" ||
	{ echo "glassine-reboot-clean: cannot write $REASON_FILE" >&2; exit 1; }
exec $INIT_REBOOT
