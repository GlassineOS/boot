#!/bin/sh
# glassine-reboot-clean [menu|recovery|bootloader|<reason>] — an orderly reboot WITH a
# reason. busybox `reboot` has init run OpenRC's shutdown (services stopped, the
# file systems read-only) but can't pass a reason; glassine-reboot passes one but
# skips the shutdown, which leaves the root fs dirty. The test boot looks at the
# root fs without replaying its journal, so a dirty root would show it a stale
# file system.
# Here: the reason goes to $GLASSINE_REBOOT_REASON_FILE, then a plain reboot, so
# init runs the whole shutdown; its last service, glassine-reboot-reason (after
# mount-ro and glassine-mount-ro), reboots with the reason. Nothing of this
# script has to outlive the shutdown (its last steps kill what is left and
# unmount from under it). No reason: a plain reboot.
#
# Two reasons are requests in the loader record (GlassineOS/boot
# docs/boot-partition.md "Keys", written by glassine-loader-mark before the
# reboot; the reboot after it is a plain one, the loader acts on the request):
#   menu      the loader's start menu at the next start (docs/handback.md "The
#             start menu"). Only where the loader takes it (glassine-loader-mark
#             can-request menu); else exit 3 and no reboot. A request that isn't
#             written: exit 1, no reboot. A reboot that can't be started after
#             the write takes the request back
#   recovery  where the loader takes it (012 FR-021): request=recovery in the
#             record. Where it doesn't (no loader record), or the write fails:
#             the bootloader's own recovery request, the reason as above
# GLASSINE_REBOOT_FORCE=1 (reboot -f): no shutdown; a reason goes straight to
# glassine-reboot, and GLASSINE_INIT_REBOOT is the forced reboot.
# The shutdown record (docs/deployments.md, "Runtime directory"): next=<reason> in
# /run/glassine/shutdown, written atomically right before the reboot (over a record
# that is there), and removed again when the reboot doesn't start; nothing when the
# reboot is refused. No reason: next=restart, only when no record is there yet. A
# record that can't be written never stops the reboot.
# Exit 1: glassine-reboot-reason isn't in the shutdown runlevel (the reboot would
# lose the reason), or a menu request not written; 2 a bad reason; 3 this board's
# loader takes no menu request.
REASON_FILE=${GLASSINE_REBOOT_REASON_FILE:-/run/glassine-reboot.reason}
RUNLEVELS=${GLASSINE_RUNLEVELS:-/etc/runlevels}
INIT_REBOOT=${GLASSINE_INIT_REBOOT:-reboot}
NOW=${GLASSINE_REBOOT:-/usr/sbin/glassine-reboot}
MARK=${GLASSINE_LOADER_MARK:-/usr/sbin/glassine-loader-mark}
REC=${GLASSINE_SHUTDOWN_RECORD:-/run/glassine/shutdown}
say() { echo "glassine-reboot-clean: $*" >&2; }
# record TARGET: the shutdown record next=TARGET; unrecord: the one written here removed
WROTE=''
record() {
	{ mkdir -p "${REC%/*}" && printf 'next=%s\n' "$1" > "$REC.new" && mv -f "$REC.new" "$REC" && WROTE=1; } 2>/dev/null || rm -f "$REC.new" 2>/dev/null
	return 0
}
unrecord() { [ -z "$WROTE" ] || rm -f "$REC" 2>/dev/null; WROTE=''; return 0; }
if [ -z "$1" ]; then
	[ -e "$REC" ] || record restart
	$INIT_REBOOT && exit 0
	_r=$?; unrecord; say "the reboot did not start (exit $_r)"; exit 1
fi
case "$1" in *[!a-z0-9-]*) say "bad reason '$1'"; exit 2 ;; esac

# the request is in the record: a plain reboot; one that doesn't start takes it back
request_reboot() {
	record "$1"
	$INIT_REBOOT && exit 0
	_r=$?
	unrecord
	"$MARK" request clear 2>/dev/null || say "the $1 request could not be taken back: the loader acts on it at the next start"
	say "the reboot did not start (exit $_r)"
	exit 1
}

case "$1" in
menu)
	[ -x "$MARK" ] || { say "glassine-loader-mark is not installed: no start menu request, no reboot"; exit 3; }
	"$MARK" request menu; _r=$?
	[ $_r = 0 ] || { say "the start menu request was not written: no reboot"; [ $_r = 3 ] && exit 3; exit 1; }
	request_reboot menu
	;;
recovery)
	if [ -x "$MARK" ] && "$MARK" can-request recovery 2>/dev/null; then
		"$MARK" request recovery && request_reboot recovery
		say "request=recovery was not written to the loader record: the bootloader's own recovery request instead"
	fi
	;;
esac

if [ "${GLASSINE_REBOOT_FORCE:-}" = 1 ]; then
	sync
	record "$1"
	"$NOW" "$1" && exit 0
	_r=$?; unrecord; say "glassine-reboot $1 did not reboot (exit $_r)"; exit 1
fi
{ [ -e "$RUNLEVELS/shutdown/glassine-reboot-reason" ] || [ -L "$RUNLEVELS/shutdown/glassine-reboot-reason" ]; } ||
	{ say "glassine-reboot-reason is not in the shutdown runlevel"; exit 1; }
printf '%s\n' "$1" > "$REASON_FILE.new" && mv -f "$REASON_FILE.new" "$REASON_FILE" ||
	{ say "cannot write $REASON_FILE"; exit 1; }
record "$1"
$INIT_REBOOT && exit 0
_r=$?; unrecord; say "the reboot did not start (exit $_r)"; exit 1
